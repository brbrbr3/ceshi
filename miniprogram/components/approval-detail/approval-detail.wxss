/* approval-detail 详情弹窗组件样式 */

/* 弹窗遮罩 */
.approval-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: var(--sp-24);
  box-sizing: border-box;
  z-index: 20;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.approval-modal-mask.is-visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* 弹窗卡片 - flex布局，标题栏固定 */
.approval-modal-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  border-radius: var(--sp-32);
  background: var(--bg-card);
  box-sizing: border-box;
  height: 85vh;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

/* 打开动画：遮罩可见时卡片从底部滑入 */
.approval-modal-mask.is-visible .approval-modal-card {
  transform: translateY(0);
}

/* 标题栏 - 固定不滚动 */
.approval-modal-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--sp-15);
}

/* 可滚动内容区 */
.approval-modal-scroll {
  flex: 1;
  overflow: hidden;
  padding: 0;
  padding-top: var(--sp-24);
}

.approval-modal-title {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-modal-sub {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-modal-close {
  width: var(--sp-56);
  height: var(--sp-56);
  border-radius: var(--sp-28);
  background: var(--bg-input);
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-32);
}

/* 详情内容 */
.approval-modal-body {
  margin-top: var(--sp-24);
}

.approval-modal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--sp-20) ;
}

.approval-modal-row + .approval-modal-row {
  margin-top: var(--sp-18);
}

.approval-modal-label {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-modal-value {
  font-size: var(--fs-24);
  color: var(--text-primary);
  font-weight: 500;
}

/* 表格类型字段样式 */
.approval-modal-table-section {
  margin-top: var(--sp-24);
  margin-right: var(--sp-8);
}

.approval-modal-table-title {
  font-size: var(--fs-24);
  color: var(--text-muted);
  margin-bottom: var(--sp-12);
  display: block;
}

.approval-modal-table {
  width: 100%;
  border-radius: var(--sp-12);
  overflow: hidden;
  border: var(--sp-1) solid var(--border-soft);
}

.approval-modal-table-header {
  display: flex;
  background: var(--bg-soft-2);
}

.approval-modal-table-header .approval-modal-table-cell {
  font-size: var(--fs-24);
  font-weight: 600;
  color: var(--text-secondary);
  padding: var(--sp-14) var(--sp-8);
  text-align: center;
  overflow-wrap: break-word;
}

.approval-modal-table-row {
  display: flex;
  border-top: var(--sp-1) solid var(--bg-soft-2);
}

.approval-modal-table-row + .approval-modal-table-row {
  border-top: var(--sp-1) solid var(--bg-soft-2);
}

.approval-modal-table-row .approval-modal-table-cell {
  font-size: var(--fs-24);
  color: var(--text-secondary);
  padding: var(--sp-12) var(--sp-8);
  text-align: center;
  overflow-wrap: break-word;
}

.approval-modal-table-empty {
  font-size: var(--fs-24);
  color: var(--text-muted);
  text-align: center;
  padding: var(--sp-24) 0;
}

/* 图片类型字段 */
.approval-modal-image {
  width: var(--sp-80);
  height: var(--sp-80);
  border-radius: 50%;
  background: var(--bg-soft-2);
}

/* 图片点击反馈 */
.approval-modal-image:active {
  opacity: 0.7;
}

.approval-detail-status-value{
  margin-top: calc(var(--sp-35) * -1);
}

.approval-modal-remark {
  margin-top: var(--sp-24);
  padding: var(--sp-20);
  border-radius: var(--sp-24);
  background: var(--bg-input);
  color: var(--text-secondary);
  font-size: var(--fs-24);
  line-height: 1.7;
}

/* 进度条样式 */
.approval-modal-progress {
  margin-top: var(--sp-24);
  padding: var(--sp-24);
  background: var(--bg-soft-2);
  border-radius: var(--sp-12);
}

.approval-modal-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--sp-16);
}

.approval-modal-progress-info {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  flex: 1;
}

.approval-modal-progress-step {
  font-size: var(--fs-24);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-modal-progress-text {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-modal-progress-bar {
  width: 100%;
  height: var(--sp-8);
  background: var(--border-soft);
  border-radius: var(--sp-4);
  overflow: hidden;
}

.approval-modal-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563EB 0%, #1D4ED8 100%);
  border-radius: var(--sp-4);
  transition: width 0.3s ease;
}

/* 审批历史 */
.approval-modal-logs {
  margin-top: var(--sp-24);
  padding: var(--sp-24);
  background: var(--bg-input);
  border-radius: var(--sp-12);
}

.approval-modal-logs-title {
  font-size: var(--fs-28);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-16);
}

.approval-modal-logs-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

.approval-modal-logs-item {
  padding: var(--sp-16);
  background: var(--bg-card);
  border-radius: var(--sp-8);
  border-left: var(--sp-3) solid #2563EB;
}

.approval-modal-logs-item.is-error {
  border-left-color: #DC2626;
}

.approval-modal-logs-item.is-approved {
  border-left-color: #16A34A;
}

.approval-modal-logs-action {
  font-size: var(--fs-26);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-8);
}

.approval-modal-logs-step {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
  margin-bottom: var(--sp-6);
}

.approval-modal-logs-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--sp-8);
}

.approval-modal-logs-operator {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
  font-weight: 500;
}

.approval-modal-logs-time {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-modal-logs-desc {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
  line-height: 1.6;
  padding-top: var(--sp-8);
  border-top: var(--sp-1) solid var(--bg-soft-2);
  margin-top: var(--sp-8);
}

/* 空状态提示 */
.approval-modal-logs-empty {
  font-size: var(--fs-24);
  color: var(--text-muted);
  text-align: center;
  padding: var(--sp-32) 0;
  line-height: 1.6;
}

/* 操作按钮 */
.approval-modal-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-18);
  margin-top: var(--sp-24);
  padding-top: var(--sp-24);
  border-top: var(--sp-1) solid rgba(37, 99, 235, 0.1);
}

.approval-reject-btn,
.approval-approve-btn {
  flex: 1;
  height: var(--sp-78);
  border-radius: var(--sp-24);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-24);
  font-weight: 600;
  transition: all 0.3s ease;
  position: relative;
}

.approval-reject-btn {
  background: var(--bg-input);
  color: var(--text-secondary);
}

.approval-reject-btn.is-disabled,
.approval-approve-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 加载动画 */
.approval-reject-btn.is-disabled::after,
.approval-approve-btn.is-disabled::after {
  content: '';
  position: absolute;
  right: var(--sp-20);
  width: var(--sp-24);
  height: var(--sp-24);
  border: var(--sp-3) solid currentColor;
  border-top-color: transparent;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  opacity: 0.8;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 中止申请按钮 */
.approval-modal-terminate {
  margin-top: var(--sp-24);
  padding: var(--sp-24);
  background: #FEE2E2;
  border-radius: var(--sp-12);
  border: var(--sp-1) solid #FCA5A5;
}

.approval-modal-terminate-text {
  font-size: var(--fs-24);
  color: #991B1B;
  margin-bottom: var(--sp-16);
  line-height: 1.6;
}

.approval-terminate-btn {
  width: 100%;
  background: #DC2626;
  color: #FFFFFF;
  border: none;
  border-radius: var(--sp-16);
  height: var(--sp-88);
  font-size: var(--fs-28);
  font-weight: 600;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
}

.approval-terminate-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.approval-terminate-btn.is-disabled::after {
  content: '';
  position: absolute;
  right: var(--sp-20);
  width: var(--sp-28);
  height: var(--sp-28);
  border: var(--sp-3) solid #FFFFFF;
  border-top-color: transparent;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  opacity: 0.8;
}

/* 复制申请按钮 */
.approval-modal-copy {
  margin-top: var(--sp-24);
  padding: var(--sp-24);
  background: var(--hint-warn-bg);
  border-radius: var(--sp-12);
  border: var(--sp-1) solid var(--hint-warn-border);
}

.approval-modal-copy-text {
  font-size: var(--fs-24);
  color: var(--hint-warn-text);
  margin-bottom: var(--sp-16);
  line-height: 1.6;
}

.approval-copy-btn {
  width: 100%;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  border: none;
  border-radius: var(--sp-16);
  height: var(--sp-88);
  font-size: var(--fs-28);
  font-weight: 600;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.approval-copy-btn::after {
  border: none;
}
