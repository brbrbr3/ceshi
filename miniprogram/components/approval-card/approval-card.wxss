/* approval-card 组件样式 */
/* 大部分样式继承自页面，此处仅定义组件特有样式 */

.approval-list-card {
  padding: var(--sp-24);
}

.approval-list-card + .approval-list-card {
  margin-top: var(--sp-20);
}

.approval-list-top,
.approval-person,
.approval-person-row,
.approval-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.approval-person {
  gap: var(--sp-18);
}

.approval-person-main {
  flex: 1;
}

.approval-person-row {
  justify-content: flex-start;
  gap: var(--sp-10);
}

.approval-person-name {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-person-sub {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-type-title {
  margin-top: var(--sp-22);
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-detail {
  margin-top: var(--sp-12);
  font-size: var(--fs-24);
  color: var(--text-secondary);
}

.approval-meta {
  margin-top: var(--sp-8);
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-time {
  margin-top: var(--sp-10);
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-urgent {
  padding: var(--sp-6) var(--sp-14);
  border-radius: var(--sp-999);
  background: #FFEBEE;
  color: #F44336;
  font-size: var(--fs-18);
}

/* 操作按钮 */
.approval-actions {
  gap: var(--sp-18);
  margin-top: var(--sp-24);
  padding-top: var(--sp-24);
  border-top: var(--sp-1) solid rgba(37, 99, 235, 0.1);
}

.approval-reject-btn,
.approval-approve-btn {
  flex: 1;
  height: var(--sp-78);
  border-radius: var(--sp-24);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-24);
  font-weight: 600;
  transition: all 0.3s ease;
  position: relative;
}

.approval-reject-btn {
  background: var(--bg-input);
  color: var(--text-secondary);
}

.approval-reject-btn.is-disabled,
.approval-approve-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 加载动画 */
.approval-reject-btn.is-disabled::after,
.approval-approve-btn.is-disabled::after {
  content: '';
  position: absolute;
  right: var(--sp-20);
  width: var(--sp-24);
  height: var(--sp-24);
  border: var(--sp-3) solid currentColor;
  border-top-color: transparent;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  opacity: 0.8;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 进度条样式 */
.approval-progress {
  margin-top: var(--sp-16);
  padding: var(--sp-24);
  background: var(--bg-soft-2);
  border-radius: var(--sp-12);
}

.approval-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--sp-16);
}

.approval-progress-info {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  flex: 1;
}

.approval-progress-step {
  font-size: var(--fs-24);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-progress-text {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-progress-bar {
  width: 100%;
  height: var(--sp-8);
  background: var(--border-soft);
  border-radius: var(--sp-4);
  overflow: hidden;
}

.approval-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563EB 0%, #1D4ED8 100%);
  border-radius: var(--sp-4);
  transition: width 0.3s ease;
}

/* 头像 */
.approval-card-avatar {
  width: var(--sp-76);
  height: var(--sp-76);
  border-radius: var(--sp-38);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: var(--fs-28);
  font-weight: 600;
}
