/* multiuse-modal 多用途弹窗组件样式 */

/* ===== 遮罩 ===== */
.mm-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: mmMaskIn 0.25s ease;
}

.mm-mask.is-closing {
  animation: mmMaskOut 0.25s ease forwards;
}

/* ===== 弹窗卡片 ===== */
.mm-modal {
  width: 650rpx;
  max-height: 80vh;
  box-sizing: border-box;
  padding: 44rpx 40rpx 36rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  animation: mmModalIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  margin-bottom: 180rpx;
}

.mm-modal.is-closing {
  animation: mmModalOut 0.25s ease forwards;
}

/* ===== 头部：标题 + 环形倒计时 ===== */
.mm-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.mm-title {
  text-align: center;
  font-size: 45rpx;
  font-weight: 600;
  color: #1E293B;
  line-height: 1.4;
  word-break: break-all;
}

/* 环形倒计时 */
.mm-ring {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s linear;
}

.mm-ring-inner {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

/* ===== 正文（scroll-view 可滚动） ===== */
.mm-content {
  font-size: 36rpx;
  color: #475569;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
  max-height: 42vh;
  margin-bottom: 24rpx;
}

/* ===== 输入框 ===== */
.mm-inputs {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mm-input-row {
  position: relative;
  display: flex;
  align-items: center;
}

.mm-input {
  flex: 1;
  height: 88rpx;
  padding: 0 80rpx 0 28rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #F1F5F9;
  font-size: 36rpx;
  color: #1E293B;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.mm-input:focus {
  border-color: #2563EB;
  background: #FFFFFF;
  box-shadow: 0 0 0 6rpx rgba(37, 99, 235, 0.12);
}

.mm-eye {
  position: absolute;
  right: 0;
  width: 72rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  opacity: 0.75;
}

.mm-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 22rpx 28rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #F1F5F9;
  font-size: 36rpx;
  color: #1E293B;
  line-height: 1.6;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.mm-textarea:focus {
  border-color: #2563EB;
  background: #FFFFFF;
  box-shadow: 0 0 0 6rpx rgba(37, 99, 235, 0.12);
}

.mm-placeholder {
  color: #94A3B8;
}

/* ===== 按钮 ===== */
.mm-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.mm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  transition: all 0.25s ease;
}

.mm-btn:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.mm-btn-cancel {
  background: #F1F5F9;
  color: #475569;
}

.mm-btn-confirm {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.28);
}

.mm-btn-confirm.is-disabled {
  background: #E2E8F0;
  color: #94A3B8;
  box-shadow: none;
}

/* 危险态 */
.mm-modal.is-danger .mm-btn-confirm {
  background: linear-gradient(135deg, #F87171 0%, #DC2626 100%);
  box-shadow: 0 8rpx 24rpx rgba(220, 38, 38, 0.3);
}

.mm-modal.is-danger .mm-btn-confirm.is-disabled {
  background: #FEE2E2;
  color: #FCA5A5;
  box-shadow: none;
}

.mm-modal.is-danger .mm-input:focus,
.mm-modal.is-danger .mm-textarea:focus {
  border-color: #DC2626;
  box-shadow: 0 0 0 6rpx rgba(220, 38, 38, 0.12);
}

/* ===== 动画关键帧 ===== */
@keyframes mmMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes mmMaskOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes mmModalIn {
  from {
    opacity: 0;
    transform: translateY(60rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes mmModalOut {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  to {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
}
