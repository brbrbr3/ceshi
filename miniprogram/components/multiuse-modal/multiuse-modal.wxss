/* multiuse-modal 多用途弹窗组件样式 */

/* ===== 遮罩 ===== */
.mm-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(var(--sp-10));
  -webkit-backdrop-filter: blur(var(--sp-10));
  display: flex;
  align-items: center;
  justify-content: center;
  animation: mmMaskIn 0.25s ease;
}

.mm-mask.is-closing {
  animation: mmMaskOut 0.25s ease forwards;
}

/* ===== 弹窗卡片 ===== */
.mm-modal {
  width: var(--sp-650);
  max-height: 80vh;
  box-sizing: border-box;
  padding: var(--sp-44) var(--sp-40) var(--sp-36);
  border-radius: var(--sp-36);
  background: var(--bg-card);
  box-shadow: 0 var(--sp-24) var(--sp-80) rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  animation: mmModalIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  margin-bottom: var(--sp-180);
}

.mm-modal.is-closing {
  animation: mmModalOut 0.25s ease forwards;
}

/* ===== 头部：标题 + 环形倒计时 ===== */
.mm-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-20);
  margin-bottom: var(--sp-40);
}

.mm-title {
  text-align: center;
  font-size: var(--sp-45);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  word-break: break-all;
}

/* 环形倒计时 */
.mm-ring {
  flex-shrink: 0;
  width: var(--sp-76);
  height: var(--sp-76);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s linear;
}

.mm-ring-inner {
  width: var(--sp-60);
  height: var(--sp-60);
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sp-32);
  font-weight: 700;
  color: var(--text-primary);
}

/* ===== 正文（scroll-view 可滚动） ===== */
.mm-content {
  font-size: var(--sp-36);
  color: var(--text-secondary);
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
  max-height: 42vh;
  margin-bottom: var(--sp-24);
}

/* ===== 输入框 ===== */
.mm-inputs {
  margin-bottom: var(--sp-24);
  display: flex;
  flex-direction: column;
  gap: var(--sp-20);
}

.mm-input-row {
  position: relative;
  display: flex;
  align-items: center;
}

.mm-input {
  flex: 1;
  height: var(--sp-88);
  padding: 0 var(--sp-80) 0 var(--sp-28);
  box-sizing: border-box;
  border-radius: var(--sp-20);
  background: var(--bg-soft-2);
  font-size: var(--sp-36);
  color: var(--text-primary);
  border: var(--sp-2) solid transparent;
  transition: all 0.25s ease;
}

.mm-input:focus {
  border-color: #2563EB;
  background: var(--bg-card);
  box-shadow: 0 0 0 var(--sp-6) rgba(37, 99, 235, 0.12);
}

.mm-eye {
  position: absolute;
  right: 0;
  width: var(--sp-72);
  height: var(--sp-88);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sp-40);
  opacity: 0.75;
}

.mm-textarea {
  width: 100%;
  min-height: var(--sp-160);
  padding: var(--sp-22) var(--sp-28);
  box-sizing: border-box;
  border-radius: var(--sp-20);
  background: var(--bg-soft-2);
  font-size: var(--sp-36);
  color: var(--text-primary);
  line-height: 1.6;
  border: var(--sp-2) solid transparent;
  transition: all 0.25s ease;
}

.mm-textarea:focus {
  border-color: #2563EB;
  background: var(--bg-card);
  box-shadow: 0 0 0 var(--sp-6) rgba(37, 99, 235, 0.12);
}

.mm-placeholder {
  color: var(--text-muted);
}

/* ===== 按钮 ===== */
.mm-actions {
  display: flex;
  gap: var(--sp-20);
  margin-top: var(--sp-30);
}

.mm-btn {
  flex: 1;
  height: var(--sp-88);
  border-radius: var(--sp-24);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sp-36);
  font-weight: 500;
  transition: all 0.25s ease;
}

.mm-btn:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.mm-btn-cancel {
  background: var(--bg-soft-2);
  color: var(--text-secondary);
}

.mm-btn-confirm {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(37, 99, 235, 0.28);
}

.mm-btn-confirm.is-disabled {
  background: var(--border-soft);
  color: var(--text-muted);
  box-shadow: none;
}

/* 危险态 */
.mm-modal.is-danger .mm-btn-confirm {
  background: linear-gradient(135deg, #F87171 0%, #DC2626 100%);
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(220, 38, 38, 0.3);
}

.mm-modal.is-danger .mm-btn-confirm.is-disabled {
  background: #FEE2E2;
  color: #FCA5A5;
  box-shadow: none;
}

.mm-modal.is-danger .mm-input:focus,
.mm-modal.is-danger .mm-textarea:focus {
  border-color: #DC2626;
  box-shadow: 0 0 0 var(--sp-6) rgba(220, 38, 38, 0.12);
}

/* ===== 动画关键帧 ===== */
@keyframes mmMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes mmMaskOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes mmModalIn {
  from {
    opacity: 0;
    transform: translateY(var(--sp-60)) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes mmModalOut {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  to {
    opacity: 0;
    transform: translateY(var(--sp-40)) scale(0.95);
  }
}
