/**
 * 分页加载组件样式
 */

/* 加载中状态 */
.pagination-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  background-color: var(--bg-soft-2);
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--border-soft);
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* 没有更多数据提示 */
.pagination-no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  background-color: var(--bg-soft-2);
}

.no-more-text {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

/* 空状态提示 */
.pagination-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* 列表容器 */
scroll-view {
  width: 100%;
  box-sizing: border-box;
}


