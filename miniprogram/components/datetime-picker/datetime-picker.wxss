/* datetime-picker.wxss */

/* 容器 */
.datetime-picker {
  position: relative;
  width: 100%;
}

/* 触发器 */
.picker-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--sp-88);
  padding: 0 var(--sp-24);
  background: linear-gradient(135deg, var(--bg-input) 0%, var(--bg-soft-2) 100%);
  border-radius: var(--sp-16);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.picker-trigger::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: var(--sp-2) solid transparent;
  border-radius: var(--sp-16);
  transition: all 0.3s ease;
}

.picker-trigger:active {
  transform: scale(0.98);
}

.picker-trigger:active::before {
  border-color: rgba(37, 99, 235, 0.3);
}

/* 触发器样式变体 */
.picker-trigger--default {
  background: linear-gradient(135deg, var(--bg-input) 0%, var(--bg-soft-2) 100%);
}

.picker-trigger--card {
  background: var(--bg-card);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0, 0, 0, 0.06);
}

.picker-trigger--border {
  background: transparent;
  border: var(--sp-2) solid var(--border-soft);
}

.picker-trigger--border::before {
  display: none;
}

/* 禁用状态 */
.picker-trigger--disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 显示值 */
.picker-value {
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: var(--sp-0_5);
}

.picker-placeholder {
  color: var(--text-muted);
  font-weight: 400;
}

/* 图标 */
.picker-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--sp-48);
  height: var(--sp-48);
  background: rgba(37, 99, 235, 0.1);
  border-radius: 50%;
  transition: all 0.3s ease;
}

.icon-arrow {
  font-size: var(--fs-22);
  color: #2563EB;
  transition: transform 0.3s ease;
}

/* 遮罩层 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  backdrop-filter: blur(4px);
}

.picker-mask--show {
  opacity: 1;
  visibility: visible;
}

/* 弹出层 */
.picker-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  z-index: 10000;
  transform: translateY(100%);
  visibility: hidden;
  transition: transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1), visibility 0.3s ease;
  box-shadow: 0 calc(var(--sp-8) * -1) var(--sp-40) rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

.picker-popup--show {
  transform: translateY(0);
  visibility: visible;
}

/* 头部 */
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-32) var(--sp-40);
  background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-soft-2) 100%);
}

.picker-btn {
  padding: var(--sp-12) var(--sp-24);
  border-radius: var(--sp-12);
  font-size: var(--fs-28);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.picker-btn::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.3s ease, height 0.3s ease;
}

.picker-btn:active::after {
  width: 200%;
  height: 200%;
}

.picker-btn--cancel {
  color: var(--text-tertiary);
  background: rgba(100, 116, 139, 0.1);
}

.picker-btn--cancel:active {
  background: rgba(100, 116, 139, 0.2);
}

.picker-btn--confirm {
  color: #FFFFFF;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  font-weight: 500;
}

.picker-btn--confirm:active {
  background: linear-gradient(135deg, #1D4ED8 0%, #1E40AF 100%);
}

.picker-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: var(--sp-1);
}

/* 分隔线 */
.picker-divider {
  height: var(--sp-2);
  background: linear-gradient(90deg, transparent 0%, var(--border-soft) 20%, var(--border-soft) 80%, transparent 100%);
}

/* 选择器视图 */
.picker-view {
  height: var(--sp-450);
  padding: 0 var(--sp-8);
}

/* 列项 */
.picker-column-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-32);
  color: var(--text-primary);
  font-weight: 500;
  white-space: nowrap;
  flex-wrap: nowrap;
}

/* 年份列特殊样式 - 增加右边距避免与"年"字重叠 */
.picker-column-item--year {
  padding-right: var(--sp-1);
}

.picker-column-num {
  font-size: var(--fs-36);
  font-weight: 600;
  color: #2563EB;
  text-align: center;
}

.picker-column-unit {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
  font-weight: 400;
  margin-left: var(--sp-2);
}

/* 星期文本样式 */
.picker-column-weekday {
  font-size: var(--fs-22);
  color:  var(--text-tertiary);
  font-weight: 400;
  margin-left: var(--sp-4);
}

.picker-column-item--weekday {
  font-size: var(--fs-30);
  font-weight: 500;
  color: var(--text-primary);
}

.picker-column-item--weekday .picker-column-num {
  display: none;
}

/* 选中效果 */
.picker-view-column:first-child .picker-column-item:first-child {
  margin-top: 0;
}

/* 安全区域 */
.picker-safe-area {
  height: env(safe-area-inset-bottom);
  min-height: var(--sp-20);
  background: var(--bg-card);
}

/* 动画关键帧 */
@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 涟漪效果 */
@keyframes ripple {
  to {
    transform: translate(-50%, -50%) scale(2);
    opacity: 0;
  }
}
