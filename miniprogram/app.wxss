/* reset */
page {
  background-color: #EEF2FF;
  height: 100%;
  font-size: 16px;
  line-height: 1.6;
  color: #1E293B;
  display: flex;
  justify-content: center;
}

page>view {
  width: 100vw;
  max-width: 600px;
}

checkbox,
radio {
  margin-right: 5px;
}

button {
  margin-top: 10px;
  margin-bottom: 10px;
}

form {
  width: 100%;
}

input {
  width: 100%;
}



/* 业务样式 */
.office-page {
  min-height: 100%;
  background: #EEF2FF;
  color: #1E293B;
}

.office-gradient-header {
  padding: calc(100rpx + env(safe-area-inset-top)) 32rpx 0;
  background: linear-gradient(135deg, #1D4ED8 0%, #3B82F6 100%);
  color: #FFFFFF;
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  box-sizing: border-box;
}

/* 头部 - 使用圆角渐变 */
.office-subpage-header {
  padding: 40rpx 32rpx 30rpx;
}

.office-subpage-header-content {
  color: #FFFFFF;
}

.office-subpage-title {
  font-size: var(--fs-44);
  font-weight: 600;
}

.office-subpage-subtitle {
  font-size: var(--fs-26);
  opacity: 0.9;
}

.office-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.office-content {
  position: relative;
  z-index: 2;
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.office-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 42rpx rgba(37, 99, 235, 0.08);
}

.office-section {
  margin-top: 28rpx;
}

.office-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.office-section-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #1E293B;
}

.office-link {
  font-size: var(--fs-26);
  color: #2563EB;
}

.office-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: var(--fs-22);
  line-height: 1;
}

.office-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 32rpx;
  border-radius: 999rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: var(--fs-24);
  font-weight: 600;
  box-shadow: 0 14rpx 28rpx rgba(37, 99, 235, 0.16);
}

.office-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 32rpx;
  border-radius: 999rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: var(--fs-24);
  font-weight: 600;
}

.office-empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #94A3B8;
}

.auth-page {
  min-height: 100%;
  padding: calc(56rpx + env(safe-area-inset-top)) 28rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #DBEAFE 0%, #EEF2FF 34%, #F8FAFC 100%);
}

.auth-hero {
  padding: 28rpx 12rpx 24rpx;
  z-index: 10;
}

.auth-brand {
  width: 188rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1D4ED8 0%, #3B82F6 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-36);
  font-weight: 700;
  box-shadow: 0 16rpx 34rpx rgba(37, 99, 235, 0.2);
  z-index: 1;
}

.auth-title {
  margin-top: 28rpx;
  font-size: var(--fs-48);
  line-height: 1.25;
  font-weight: 700;
  z-index: 1;
  color: #0F172A;
}

.auth-subtitle {
  margin-top: 14rpx;
  font-size: var(--fs-28);
  font-weight: 500;
  line-height: 1.6;
  z-index: 1;
  color: #475569;
}

.auth-tip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.auth-tip-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.1);
  color: #1D4ED8;
  font-size: var(--fs-24);
  font-weight: 600;
}

.auth-card {
  margin-top: 20rpx;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.08);
}

.auth-card-title {
  font-size: var(--fs-32);
  font-weight: 700;
  color: #0F172A;
}

.auth-card-desc {
  margin-top: 12rpx;
  font-size: var(--fs-26);
  line-height: 1.7;
  color: #64748B;
}



.auth-submit-btn {
  width: 100%;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1D4ED8 0%, #3B82F6 100%);
  color: #FFFFFF;
  font-size: var(--fs-32);
  font-weight: 600;
  box-shadow: 0 16rpx 30rpx rgba(37, 99, 235, 0.18);
  height: 100%;
  margin: 28rpx;
  justify-content: center;
  padding: 24rpx 12rpx;
}

.auth-submit-btn::after {
  border: none;
}

.auth-submit-btn.is-pending {
  background: linear-gradient(135deg, #9CA3AF 0%, #B0B7C3 100%);
  box-shadow: none;
  color: #E5E7EB;
  pointer-events: none;
}

.auth-note {
  margin-top: 18rpx;
  font-size: var(--fs-24);
  line-height: 1.7;
  color: #64748B;
  margin-bottom: 60rpx;
}



.auth-form {
  margin-top: 28rpx;
}

.auth-field+.auth-field {
  margin-top: 24rpx;
}

.auth-field-label {
  margin-bottom: 14rpx;
  font-size: var(--fs-28);
  font-weight: 600;
  color: #1E293B;
}

.auth-field-optional {
  font-weight: 400;
  font-size: var(--fs-24);
  color: #94A3B8;
}

.auth-input-shell,
.auth-picker-shell {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #F8FAFC;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.auth-picker-shell.is-placeholder,
.auth-input-placeholder {
  color: #94A3B8;
}

.auth-input-shell.is-focused {
  border-color: #93C5FD;
  background: #FFFFFF;
}

.auth-input-shell input {
  width: 100%;
  font-size: var(--fs-26);
  color: #0F172A;
}

.auth-picker-value {
  flex: 1;
  font-size: var(--fs-26);
  color: #0F172A;
}

.auth-picker-arrow {
  margin-left: 16rpx;
  font-size: var(--fs-28);
  color: #94A3B8;
}

.auth-segment {
  display: flex;
  gap: 16rpx;
}

.auth-segment-item {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  background: #F8FAFC;
  color: #475569;
  font-size: var(--fs-26);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.auth-segment-item.is-active {
  background: #EFF6FF;
  border-color: #93C5FD;
  color: #2563EB;
  font-weight: 600;
}



/* 微信头像选择 */
.auth-avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border-radius: 24rpx;
  background: #F1F5F9;
  border: 2rpx dashed #CBD5E1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: 1.5;
}

.auth-avatar-btn::after {
  border: none;
}

.auth-avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.auth-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
  color: #94A3B8;
}

.auth-avatar-icon {
  font-size: var(--fs-36);
  margin-bottom: 6rpx;
}

.auth-avatar-hint {
  margin-top: 10rpx;
  font-size: var(--fs-26);
  color: #3B82F6;
}

.auth-avatar-hint.plain-hint {
  color: #64748B;
}

