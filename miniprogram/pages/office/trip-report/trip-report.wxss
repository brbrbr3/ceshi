/* 外出报备页面样式 */

.trip-page {
  min-height: 100vh;
  background: var(--bg-page);
}





/* 状态卡片 - 参照 approval-modal-copy 风格 */
.trip-status-card {
  margin: var(--sp-28);
  padding: var(--sp-24);
  border-radius: var(--sp-24);
  transition: all 0.3s ease;
}

.trip-status-card.is-active {
  /* 外出中 - 黄色 */
  background: var(--hint-warn-bg);
  border: var(--sp-1) solid var(--hint-warn-border);
}

.trip-status-card.is-active .trip-status-label {
  color: var(--hint-warn-text);
}

.trip-status-card.is-active .trip-status-companion {
  color: var(--hint-warn-text);
}

.trip-status-card.is-active .trip-status-item-label {
  color: var(--hint-warn-text);
  opacity: 0.8;
}

.trip-status-card.is-active .trip-status-item-value {
  color: var(--hint-warn-text);
}

.trip-status-card.is-active .trip-status-detail {
  border-top-color: var(--hint-warn-border);
}

.trip-status-card.is-idle {
  /* 未外出 - 绿色 */
  background: #DCFCE7;
  border: var(--sp-1) solid #166534;
}

.trip-status-card.is-idle .trip-status-label {
  color: #166534;
}

.trip-status-card.is-idle .trip-status-companion {
  color: #15803D;
}

.trip-status-card.is-idle .trip-status-item-label {
  color: #166534;
  opacity: 0.8;
}

.trip-status-card.is-idle .trip-status-item-value {
  color: #166534;
}

.trip-status-card.is-idle .trip-status-detail {
  border-top-color: rgba(74, 222, 128, 0.6);
}

.trip-status-header {
  display: flex;
  align-items: center;
}

.trip-status-icon {
  width: var(--sp-100);
  height: var(--sp-100);
  border-radius: var(--sp-20);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255,0);
  font-size: var(--fs-72);
  margin-right: var(--sp-16);
}

.trip-status-info {
  flex: 1;
}

.trip-status-label {
  font-size: var(--fs-32);
  font-weight: 600;
  margin-bottom: var(--sp-4);
}

.trip-status-companion {
  font-size: var(--fs-28);
  font-weight: 500;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--sp-6);
}

/* 同行人标签 */
.companion-tag {
  display: inline-block;
  font-size: var(--fs-28);
  font-weight: 500;
}

.trip-status-detail {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-24) var(--sp-12);
  padding-top: var(--sp-20);
  margin-top: var(--sp-20);
  border-top: var(--sp-1) solid;
}

.trip-status-item {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.trip-status-item-label {
  font-size: var(--fs-24);
}

.trip-status-item-value {
  font-size: var(--fs-28);
  font-weight: 500;
}

/* 内容区 */
.trip-content {
  padding: 0 var(--sp-24) var(--sp-12);
  padding-bottom: var(--sp-100);
  margin-top: calc(var(--sp-8) * -1);
}

/* 操作按钮 */
.trip-action-section {
  display: flex;
  gap: var(--sp-16);
  margin-bottom: var(--sp-32);
}

.trip-action-btn {
  flex: 1;
  height: var(--sp-100);
  border-radius: var(--sp-20);
  font-size: var(--fs-30);
  font-weight: 600;
  transition: transform 0.3s ease, opacity 0.3s ease;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trip-action-btn-depart {
  background: linear-gradient(135deg, #2563EB 0%, #4F46E5 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(37, 99, 235, 0.3);
}

.trip-action-btn-return {
  background: linear-gradient(135deg, #16A34A 0%, #059669 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(22, 163, 74, 0.3);
}

.trip-action-btn-retro {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(245, 158, 11, 0.3);
}

.trip-action-btn-retro.is-disabled,
.trip-action-btn-retro[disabled] {
  background: var(--border-soft);
  color: var(--text-muted);
  box-shadow: none;
}

.trip-action-btn-cancel {
  background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(220, 38, 38, 0.3);
}

.trip-action-btn:active {
  transform: scale(0.94);
  opacity: 0.85;
}

/* 章节标题 */
.trip-section {
  margin-top: var(--sp-16);
}

.trip-section-title {
  font-size: var(--fs-35);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-20);
  padding-left: var(--sp-8);
}

/* 月份分组 */
.trip-month-group {
  margin-bottom: var(--sp-24);
}

.trip-month-title {
  font-size: var(--fs-32);
  color: var(--text-tertiary);
  margin-bottom: var(--sp-16);
  padding-left: var(--sp-8);
}

/* 列表 */
.trip-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

/* 记录卡片 */
.trip-item {
  background: var(--bg-card);
  border-radius: var(--sp-20);
  padding: var(--sp-24);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0, 0, 0, 0.04);
}

.trip-item-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-16);
}

.trip-item-date {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  margin-right: var(--sp-16);
}

.trip-item-time {
  font-size: var(--fs-28);
  color: var(--text-tertiary);
  flex: 1;
}

.trip-item-status {
  font-size: var(--fs-24);
  padding: var(--sp-6) var(--sp-16);
  border-radius: var(--sp-8);
  font-weight: 500;
}

.trip-item-body {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.trip-item-dest {
  font-size: var(--fs-30);
  color: var(--text-primary);
  font-weight: 500;
}

.trip-item-meta {
  display: flex;
  gap: var(--sp-20);
}

.trip-item-mode,
.trip-item-companions {
  font-size: var(--fs-28);
  color: var(--text-tertiary);
}

/* 出行记录条目内的同行人：去掉标签背景，与出行方式同色 */
.trip-item-meta .companion-tag {
  background: none;
  border-radius: 0;
  padding: 0;
  color: var(--text-tertiary);
}

/* 空状态 */
.trip-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-80) 0;
}

.trip-empty-icon {
  font-size: var(--fs-80);
  margin-bottom: var(--sp-20);
}

.trip-empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* 加载状态 */
.trip-loading {
  display: flex;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.trip-loading-text {
  font-size: var(--fs-26);
  color: var(--text-muted);
}

/* 弹窗遮罩 */
.trip-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.trip-popup-mask.is-visible {
  opacity: 1;
  visibility: visible;
  animation: tripFadeIn 0.25s ease;
}

/* 弹窗容器 */
.trip-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease; 
  max-height: 85vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.trip-popup-mask.is-visible .trip-popup-container {
  transform: translateY(0);
  animation: tripSlideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* 退出动画（与 modalAnimation behavior 的 250ms 对齐；放最后以确保覆盖入场动画） */
.trip-popup-mask.is-closing {
  animation: tripFadeOut 0.25s ease forwards;
}

.trip-popup-mask.is-closing .trip-popup-container {
  animation: tripSlideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

@keyframes tripFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes tripSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes tripFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes tripSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

/* 弹窗头部 */
.trip-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-32);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  flex-shrink: 0;
}

/* 弹窗滚动区域 */
.trip-popup-body {
  flex: 1;
  overflow: hidden;
  max-height: 80vh;
}

.trip-popup-title {
  font-size: var(--fs-35);
  font-weight: 600;
  color: var(--text-primary);
}


.trip-popup-close {
  font-size: var(--fs-48);
  color: var(--text-muted);
  line-height: 1;
  padding: 0 var(--sp-8);
}

/* 表单 */
.trip-popup-form {
  padding: var(--sp-32);
  padding-bottom: var(--sp-90);
}

.trip-field {
  margin-bottom: var(--sp-28);
}

.trip-field-label {
  font-size: var(--fs-32);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: var(--sp-24);
}

.trip-required {
  color: #DC2626;
}

.trip-field-hint {
  font-size: var(--fs-26);
  color: var(--text-muted);
  margin-top: var(--sp-8);
}

.trip-input-wrapper {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: 0 var(--sp-24);
  height: var(--sp-88);
  display: flex;
  align-items: center;
  border: var(--sp-1) solid var(--border-soft);
}

.trip-input {
  flex: 1;
  font-size: var(--fs-30);
  color: var(--text-primary);
}

.trip-input-placeholder {
  color: var(--text-muted);
}

/* 历史记录列表 */
.trip-history-list {
  margin-top: var(--sp-12);
  background: var(--bg-input);
  border-radius: var(--sp-12);
  padding: var(--sp-16);
}

.trip-history-title {
  font-size: var(--fs-30);
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: var(--sp-12);
}

.trip-history-items {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-12);
}

.trip-history-item {
  background: var(--bg-card);
  border: var(--sp-1) solid var(--border-soft);
  border-radius: var(--sp-8);
  padding: var(--sp-10) var(--sp-20);
  font-size: var(--fs-28);
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.trip-history-item:active {
  transform: scale(0.95);
  background: var(--bg-page);
  border-color: #2563EB;
  color: #2563EB;
}



.trip-picker-value {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: 0 var(--sp-24);
  height: var(--sp-88);
  display: flex;
  align-items: center;
  font-size: var(--fs-28);
  color: var(--text-primary);
}

/* 下拉选择器 */
.trip-picker-wrapper {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: 0 var(--sp-24);
  height: var(--sp-88);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: var(--sp-1) solid var(--border-soft);
}

.trip-picker-wrapper.is-placeholder .trip-picker-value {
  color: var(--text-muted);
}

.trip-picker-arrow {
  font-size: var(--fs-36);
  color: var(--text-muted);
  font-weight: 300;
}

/* 提交按钮 */
.trip-submit-btn[disabled] {
  background: var(--text-muted);
}

/* ========== 代报备返回弹窗 ========== */
.proxy-return-tip {
  font-size: var(--fs-30);
  padding: var(--sp-24) var(--sp-40) var(--sp-16);
  line-height: 1.6;
  color: var(--text-primary);
}

.proxy-return-list {
  padding: 0 var(--sp-32) var(--sp-24);
}

.proxy-return-item {
  display: flex;
  align-items: center;
  gap: var(--sp-20);
  padding: var(--sp-20) var(--sp-24);
  margin-bottom: var(--sp-12);
  background: var(--bg-input);
  border-radius: var(--sp-16);
  border: var(--sp-2) solid var(--border-soft);
  transition: all 0.2s ease;
}

.proxy-return-item.is-selected {
  background: var(--selected-bg);
  border-color: #16A34A;
}

.proxy-return-checkbox {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: var(--sp-10);
  border: var(--sp-2) solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-24);
  color: #FFFFFF;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.proxy-return-item.is-selected .proxy-return-checkbox {
  background: #16A34A;
  border-color: #16A34A;
}

.proxy-return-info {
  flex: 1;
  min-width: 0;
}

.proxy-return-name {
  font-size: var(--fs-30);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--sp-4);
}

.proxy-return-dest {
  font-size: var(--fs-26);
  color: var(--text-muted);
}

.proxy-return-footer {
  display: flex;
  gap: var(--sp-16);
  padding: var(--sp-20) var(--sp-32);
  padding-bottom: calc(var(--sp-20) + env(safe-area-inset-bottom));
  border-top: var(--sp-1) solid var(--bg-soft-2);
  flex-shrink: 0;
}

.proxy-return-btn {
  flex: 1;
  height: var(--sp-88);
  border-radius: var(--sp-16);
  font-size: var(--fs-30);
  font-weight: 600;
  display: flex;
  transition: transform 0.3s ease, opacity 0.3s ease;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}

.proxy-return-btn-skip {
  flex: 0.4;
  background: var(--bg-soft-2);
  color: var(--text-tertiary);
}

.proxy-return-btn-confirm {
  flex: 0.6;
  background: linear-gradient(135deg, #16A34A 0%, #059669 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-6) var(--sp-20) rgba(22, 163, 74, 0.3);
}

.proxy-return-btn:active {
  transform: scale(0.94);
  opacity: 0.8;
}

/* ========== 追加目的地按钮 ========== */
.trip-action-btn-append {
  background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(249, 115, 22, 0.3);
}

/* ========== 追加目的地弹窗 ========== */
.append-dest-content {
  padding: var(--sp-24) var(--sp-32);
}

.append-dest-tip {
  font-size: var(--fs-34);
  line-height: 1.6;
  font-weight: 600;
  padding-bottom: var(--sp-24);
  color: #F97316;
}




.append-dest-proxy {
  margin-top: var(--sp-16);
}


.append-dest-proxy-item {
  display: flex;
  align-items: center;
  gap: var(--sp-20);
  padding: var(--sp-20) var(--sp-24);
  margin-bottom: var(--sp-12);
  background: var(--bg-input);
  border-radius: var(--sp-16);
  border: var(--sp-2) solid var(--border-soft);
  transition: all 0.2s ease;
}

.append-dest-proxy-item.is-selected {
  background: var(--danger-soft-bg);
  border-color: #F97316;
}

.append-dest-proxy-checkbox {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: var(--sp-10);
  border: var(--sp-2) solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-24);
  color: #FFFFFF;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.append-dest-proxy-item.is-selected .append-dest-proxy-checkbox {
  background: #F97316;
  border-color: #F97316;
}

.append-dest-proxy-info {
  flex: 1;
  min-width: 0;
}

.append-dest-proxy-name {
  font-size: var(--fs-30);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--sp-4);
}

.append-dest-proxy-dest {
  font-size: var(--fs-26);
  color: var(--text-muted);
}

.append-dest-footer {
  display: flex;
  gap: var(--sp-16);
  padding: var(--sp-20) var(--sp-32);
  padding-bottom: calc(var(--sp-20) + env(safe-area-inset-bottom));
  border-top: var(--sp-1) solid var(--bg-soft-2);
  flex-shrink: 0;
}

.append-dest-btn {
  flex: 1;
  height: var(--sp-88);
  border-radius: var(--sp-16);
  font-size: var(--fs-30);
  font-weight: 600;
  display: flex;
  transition: transform 0.3s ease, opacity 0.3s ease;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}

.append-dest-btn-skip {
  flex: 0.4;
  background: var(--bg-soft-2);
  color: var(--text-tertiary);
}

.append-dest-btn-confirm {
  flex: 0.6;
  background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-6) var(--sp-20) rgba(249, 115, 22, 0.3);
}

.append-dest-btn-single {
  flex: 1;
  background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-6) var(--sp-20) rgba(249, 115, 22, 0.3);
}

.append-dest-btn:active {
  transform: scale(0.94);
  opacity: 0.8;
}
