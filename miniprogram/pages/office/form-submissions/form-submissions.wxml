<view class="office-page form-submissions-page" style="{{fontStyle}}">
  <view class="office-gradient-header form-submissions-header">
    <view class="form-submissions-title">{{title || '提交明细'}}</view>
    <view class="form-submissions-total">共 {{list.length}} 人提交</view>
  </view>

  <view class="office-content form-submissions-content">
    <view wx:if="{{loading}}" class="form-submissions-loading">加载中...</view>

    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="office-card form-submissions-item"
    >
      <view class="fs-item-head" bindtap="handleToggleExpand" data-index="{{index}}">
        <view class="fs-user-avatar" style="background: {{item.role === '馆员' ? '#EFF6FF' : '#F1F5F9'}}; color: {{item.role === '馆员' ? '#2563EB' : '#64748B'}};">{{item.userName ? item.userName[0] : '?'}}</view>
        <view class="fs-user-info">
          <view class="fs-user-name">{{item.userName || '匿名'}}</view>
          <view class="fs-user-time">{{item.timeText}}</view>
        </view>
        <view class="fs-expand-icon {{item.expanded ? 'is-expanded' : ''}}">▾</view>
      </view>

      <view wx:if="{{item.expanded}}" class="fs-answers">
        <view wx:for="{{item.answerDetails}}" wx:for-item="ans" wx:key="blockId" class="fs-answer-row">
          <view class="fs-answer-title">{{ans.title}}</view>
          <view class="fs-answer-value">{{ans.valueText}}</view>
        </view>
        <view wx:if="{{item.answerDetails.length === 0}}" class="fs-answer-empty">（无作答内容）</view>
      </view>
    </view>

    <view wx:if="{{!loading && list.length === 0}}" class="form-submissions-empty">暂无提交记录</view>
  </view>
</view>
