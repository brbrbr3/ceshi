.form-submissions-page {
  min-height: 100%;
}

.form-submissions-header {
  padding: 30rpx 40rpx 70rpx;
}

.form-submissions-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-submissions-header-left {
  flex: 1;
  min-width: 0;
}

.form-submissions-export {
  flex-shrink: 0;
  padding: 14rpx 30rpx;
  background: rgba(255, 255, 255, 0.25);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 600;
}

.form-submissions-export.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.form-submissions-title {
  font-size: var(--fs-40);
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.form-submissions-total {
  font-size: var(--fs-26);
  color: rgba(255, 255, 255, 0.9);
}

.form-submissions-content {
  margin-top: -20rpx;
  padding-bottom: 160rpx;
}

.form-submissions-loading,
.form-submissions-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #94A3B8;
  font-size: var(--fs-28);
}

.fs-bottom-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.fs-sort-btn,
.fs-filter-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 22rpx 0;
  text-align: center;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 48rpx;
  color: #475569;
  font-size: var(--fs-28);
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.fs-filter-btn.is-active {
  background: #EFF6FF;
  border-color: #2563EB;
  color: #2563EB;
  font-weight: 600;
}

.fs-btn-arrow {
  font-size: var(--fs-24);
  color: #94A3B8;
}

.fs-toggle-all {
  flex: 1.1;
  padding: 22rpx 0;
  text-align: center;
  background: #ffffff;
  border: 2rpx solid #DBEAFE;
  border-radius: 48rpx;
  color: #2563EB;
  font-size: var(--fs-30);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.18);
}

.fs-toggle-all,
.fs-sort-btn,
.fs-filter-btn,
.form-submissions-item {
  transition: all 0.3s ease;
}

.fs-toggle-all:active,
.fs-sort-btn:active,
.fs-filter-btn:active,
.form-submissions-item:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.form-submissions-item {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.form-submissions-item:last-child {
  margin-bottom: 80rpx;
}

.fs-item-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.fs-user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-32);
  font-weight: 600;
  flex-shrink: 0;
}

.fs-user-info {
  flex: 1;
}

.fs-user-name {
  font-size: var(--fs-30);
  font-weight: 600;
  color: #1E293B;
}

.fs-user-time {
  font-size: var(--fs-22);
  color: #94A3B8;
  margin-top: 4rpx;
}

.fs-expand-icon {
  font-size: var(--fs-54);
  color: #94A3B8;
  transition: transform 0.25s ease;
}

.fs-expand-icon.is-expanded {
  transform: rotate(180deg);
}

.fs-answers {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F1F5F9;
  animation: fadeIn 0.25s ease;
}

.fs-answer-row {
  padding: 12rpx 0;
}

.fs-answer-title {
  font-size: var(--fs-28);
  color: #64748B;
  margin-bottom: 6rpx;
}

.fs-answer-value {
  font-size: var(--fs-28);
  color: #1E293B;
  line-height: 1.6;
  word-break: break-all;
}

.fs-answer-empty {
  color: #94A3B8;
  font-size: var(--fs-24);
  padding: 8rpx 0;
}

/* ===== 部门分组 ===== */
.fs-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx 12rpx;
  margin-top: 8rpx;
}

.fs-group-name {
  font-size: var(--fs-32);
  font-weight: 700;
  color: #1E293B;
}

.fs-group-count {
  font-size: var(--fs-28);
  color: #94A3B8;
}

/* ===== 分数 ===== */
.fs-score-badge {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: #FEF3C7;
  color: #D97706;
  font-size: var(--fs-26);
  font-weight: 700;
}

.fs-answer-score {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-size: var(--fs-22);
  font-weight: 600;
}

.fs-answer-score.is-correct {
  background: #DCFCE7;
  color: #16A34A;
}

.fs-answer-score.is-wrong {
  background: #FEE2E2;
  color: #DC2626;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
