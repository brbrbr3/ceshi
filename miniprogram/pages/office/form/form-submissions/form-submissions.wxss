.form-submissions-page {
  min-height: 100%;
}

.form-submissions-header {
  padding: var(--sp-30) var(--sp-40) var(--sp-70);
}

.form-submissions-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-submissions-header-left {
  flex: 1;
  min-width: 0;
}

.form-submissions-export {
  flex-shrink: 0;
  padding: var(--sp-14) var(--sp-30);
  background: rgba(255, 255, 255, 0.25);
  border: var(--sp-2) solid rgba(255, 255, 255, 0.7);
  border-radius: var(--sp-24);
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 400;
}

.form-submissions-export.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.form-submissions-title {
  font-size: var(--fs-40);
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: var(--sp-12);
}

.form-submissions-total {
  font-size: var(--fs-28);
  color: rgba(255, 255, 255, 0.9);
}

.form-submissions-content {
  margin-top: calc(var(--sp-20) * -1);
  padding-bottom: var(--sp-160);
}

.form-submissions-loading,
.form-submissions-empty {
  text-align: center;
  padding: var(--sp-80) 0;
  color: var(--text-muted);
  font-size: var(--fs-28);
}

.fs-bottom-bar {
  position: fixed;
  left: var(--sp-32);
  right: var(--sp-32);
  bottom: calc(var(--sp-32) + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  align-items: stretch;
  gap: var(--sp-16);
}

.fs-sort-btn,
.fs-filter-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-6);
  padding: var(--sp-22) 0;
  text-align: center;
  background: var(--bg-card);
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-48);
  color: var(--text-secondary);
  font-size: var(--fs-28);
  font-weight: 500;
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(15, 23, 42, 0.06);
}

.fs-filter-btn.is-active {
  background: var(--bg-soft);
  border-color: #2563EB;
  color: #2563EB;
  font-weight: 600;
}

.fs-btn-arrow {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.fs-toggle-all {
  flex: 1.1;
  padding: var(--sp-22) 0;
  text-align: center;
  background: var(--bg-card);
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-48);
  color: #2563EB;
  font-size: var(--fs-32);
  font-weight: 600;
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(37, 99, 235, 0.18);
}

.fs-toggle-all,
.fs-sort-btn,
.fs-filter-btn,
.form-submissions-item {
  transition: all 0.3s ease;
}

.fs-toggle-all:active,
.fs-sort-btn:active,
.fs-filter-btn:active,
.form-submissions-item:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.form-submissions-item {
  padding: var(--sp-24) var(--sp-28);
  margin-bottom: var(--sp-20);
}

.form-submissions-item:last-child {
  margin-bottom: var(--sp-80);
}

.fs-item-head {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
}

.fs-user-avatar {
  width: var(--sp-72);
  height: var(--sp-72);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-32);
  font-weight: 600;
  flex-shrink: 0;
}

.fs-user-info {
  flex: 1;
}

.fs-user-name {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.fs-user-time {
  font-size: var(--fs-22);
  color: var(--text-muted);
  margin-top: var(--sp-4);
}

.fs-expand-icon {
  font-size: var(--fs-54);
  color: var(--text-muted);
  transition: transform 0.25s ease;
}

.fs-expand-icon.is-expanded {
  transform: rotate(180deg);
}

.fs-answers {
  margin-top: var(--sp-20);
  padding-top: var(--sp-20);
  border-top: var(--sp-2) solid #F1F5F9;
  animation: fadeIn 0.25s ease;
}

.fs-answer-row {
  padding: var(--sp-12) 0;
}

.fs-answer-title {
  font-size: var(--fs-28);
  color: #64748B;
  margin-bottom: var(--sp-6);
}

.fs-answer-value {
  font-size: var(--fs-28);
  color: var(--text-primary);
  line-height: 1.6;
  word-break: break-all;
}

.fs-answer-empty {
  color: var(--text-muted);
  font-size: var(--fs-24);
  padding: var(--sp-8) 0;
}

/* ===== 部门分组 ===== */
.fs-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-20) var(--sp-8) var(--sp-12);
  margin-top: var(--sp-8);
}

.fs-group-name {
  font-size: var(--fs-32);
  font-weight: 700;
  color: var(--text-primary);
}

.fs-group-count {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ===== 分数 ===== */
.fs-score-badge {
  flex-shrink: 0;
  padding: var(--sp-6) var(--sp-20);
  border-radius: var(--sp-24);
  background: var(--hint-warn-bg);
  color: var(--hint-warn-text);
  font-size: var(--fs-26);
  font-weight: 700;
}

.fs-answer-score {
  margin-left: var(--sp-12);
  padding: var(--sp-2) var(--sp-12);
  border-radius: var(--sp-16);
  font-size: var(--fs-22);
  font-weight: 600;
}

.fs-answer-score.is-correct {
  background: #DCFCE7;
  color: #16A34A;
}

.fs-answer-score.is-wrong {
  background: #FEE2E2;
  color: #DC2626;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(calc(var(--sp-8) * -1)); }
  to { opacity: 1; transform: translateY(0); }
}
