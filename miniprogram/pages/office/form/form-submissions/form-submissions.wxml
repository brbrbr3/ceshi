<page-meta page-style="{{pageStyle}}" />
<view wx:if="{{guardReady}}" class="office-page form-submissions-page {{themeClass}}" style="{{fontStyle}}">
  <view class="office-gradient-header form-submissions-header">
    <view class="form-submissions-header-row">
      <view class="form-submissions-header-left">
        <view class="form-submissions-title">{{title || '提交明细'}}</view>
        <view class="form-submissions-total">共 {{list.length}} 人提交</view>
      </view>
      <view wx:if="{{tag === 'side_dish'}}" class="form-submissions-export {{exporting ? 'is-disabled' : ''}}" bindtap="handleExportPdf">导出PDF</view>
    </view>
  </view>

  <view class="office-content form-submissions-content">
    <view wx:if="{{loading}}" class="form-submissions-loading">加载中...</view>

    <block wx:for="{{displayList}}" wx:key="key">
      <view wx:if="{{item.isGroup}}" class="fs-group-header">
        <text class="fs-group-name">{{item.name}}</text>
        <text class="fs-group-count">{{item.count}} 人</text>
      </view>

      <view wx:else class="office-card form-submissions-item">
        <view class="fs-item-head" bindtap="handleToggleExpand" data-id="{{item._id}}">
          <view class="fs-user-avatar" style="background: {{item.role === '馆员' ? '#EFF6FF' : '#F1F5F9'}}; color: {{item.role === '馆员' ? '#2563EB' : '#64748B'}};">{{item.userName ? item.userName[0] : '?'}}</view>
          <view class="fs-user-info">
            <view class="fs-user-name">{{item.userName || '匿名'}}</view>
            <view class="fs-user-time">{{item.timeText}}</view>
          </view>
          <view wx:if="{{isQuiz}}" class="fs-score-badge">{{item.scoreTotal}} 分</view>
          <view class="fs-expand-icon {{item.expanded ? 'is-expanded' : ''}}">▾</view>
        </view>

        <view wx:if="{{item.expanded}}" class="fs-answers">
          <view wx:for="{{item.answerDetails}}" wx:for-item="ans" wx:key="blockId" class="fs-answer-row">
            <view class="fs-answer-title">
              {{ans.index}}. {{ans.title}}
              <text wx:if="{{ans.scoreText}}" class="fs-answer-score {{ans.isCorrect ? 'is-correct' : 'is-wrong'}}">{{ans.scoreText}}</text>
            </view>
            <view class="fs-answer-value">{{ans.valueText}}</view>
          </view>
          <view wx:if="{{item.answerDetails.length === 0}}" class="fs-answer-empty">（无作答内容）</view>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && list.length === 0}}" class="form-submissions-empty">暂无提交记录</view>
  </view>

  <!-- 底部操作区（排序 + 筛选 + 全部展开/收起） -->
  <view wx:if="{{!loading && list.length > 0}}" class="fs-bottom-bar">
    <view wx:if="{{isQuiz}}" class="fs-toggle-all" bindtap="onSortToggle">
      {{sortModeText}}<text class="fs-btn-arrow">⇄</text>
    </view>
    <view wx:if="{{isQuiz && maxSubmissions > 1}}" class="fs-toggle-all {{filterMode === 'highest' ? 'is-active' : ''}}" bindtap="onFilterToggle">{{filterMode === 'highest' ? '只留最高成绩' : '不筛选'}}</view>
    <view class="fs-toggle-all" bindtap="handleToggleAll">
      {{allExpanded ? '全部展开' : '全部收起'}}
    </view>
  </view>
</view>
