.form-compare-page {
  min-height: 100%;
  padding-bottom: var(--sp-40);
}

.form-compare-header {
  padding: var(--sp-30) var(--sp-40) var(--sp-70);
}

.form-compare-title-row {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  margin-bottom: var(--sp-20);
}

.form-compare-badge {
  padding: var(--sp-6) var(--sp-18);
  border-radius: var(--sp-20);
  font-size: var(--fs-22);
  font-weight: 600;
}

.form-compare-title {
  font-size: var(--fs-40);
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.4;
  margin-bottom: var(--sp-12);
}

.form-compare-score {
  display: inline-block;
  padding: var(--sp-10) var(--sp-28);
  border-radius: var(--sp-30);
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
  font-size: var(--fs-30);
  font-weight: 700;
}

.form-compare-content {
  margin-top: calc(var(--sp-40) * -1);
}

.form-compare-loading {
  text-align: center;
  padding: var(--sp-60) 0;
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ===== 分节标题（text 说明块） ===== */
.fc-section-block {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  padding: var(--sp-24) var(--sp-8);
  margin: var(--sp-4) 0;
}

.fc-section-bar {
  width: var(--sp-10);
  height: var(--sp-50);
  border-radius: var(--sp-4);
  background: linear-gradient(180deg, #2563EB, #4F46E5);
  flex-shrink: 0;
}

.fc-section-title {
  flex: 1;
  font-size: var(--fs-32);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

/* ===== 题目卡片 ===== */
.fc-card {
  padding: var(--sp-28);
  margin-bottom: var(--sp-24);
}

.fc-card:last-child {
  margin-bottom: var(--sp-100);
}

.fc-block-head {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-12);
  margin-bottom: var(--sp-20);
}

.fc-block-index {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: 50%;
  background: var(--bg-soft);
  color: #2563EB;
  font-size: var(--fs-24);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fc-block-title {
  flex: 1;
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}

.fc-mark {
  flex-shrink: 0;
  padding: var(--sp-4) var(--sp-16);
  border-radius: var(--sp-20);
  font-size: var(--fs-24);
  font-weight: 600;
  margin-top: var(--sp-6);
}

.fc-mark.is-correct {
  background: #DCFCE7;
  color: #16A34A;
}

.fc-mark.is-wrong {
  background: #FEE2E2;
  color: #DC2626;
}

.fc-options {
  display: flex;
  flex-direction: column;
  gap: var(--sp-10);
}

.fc-option {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  padding: var(--sp-16);
  border-radius: var(--sp-12);
  background: var(--bg-input);
  font-size: var(--fs-30);
  color: var(--text-secondary);
  border: var(--sp-2) solid transparent;
}

.fc-option.is-correct {
  background: #F0FDF4;
  border-color: #86EFAC;
  color: #166534;
}

.fc-option.is-wrong {
  background: #FEF2F2;
  border-color: #FECACA;
  color: #991B1B;
}

/* 选项控件：单选/判断为圆点，多选为方框（选中态 = 我的答案点击态） */
.fc-radio-dot {
  width: var(--sp-32);
  height: var(--sp-32);
  border-radius: 50%;
  border: var(--sp-3) solid #CBD5E1;
  box-sizing: border-box;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.fc-radio-dot.is-checked {
  border-color: #2563EB;
  background: radial-gradient(circle, #2563EB 0%, #2563EB 42%, transparent 50%);
}

.fc-checkbox-box {
  width: var(--sp-32);
  height: var(--sp-32);
  border-radius: var(--sp-8);
  border: var(--sp-3) solid #CBD5E1;
  box-sizing: border-box;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
  color: transparent;
  transition: all 0.15s ease;
}

.fc-checkbox-box.is-checked {
  border-color: #2563EB;
  background: #2563EB;
  color: #FFFFFF;
}

.fc-opt-text {
  flex: 1;
  line-height: 1.5;
}

.fc-block-score {
  margin-top: var(--sp-16);
  padding-top: var(--sp-16);
  border-top: var(--sp-2) dashed #E2E8F0;
  font-size: var(--fs-26);
  color: var(--text-tertiary);
}

.fc-my-answer {
  padding: var(--sp-16) var(--sp-20);
  background: var(--bg-input);
  border-radius: var(--sp-12);
}

.fc-my-label {
  font-size: var(--fs-22);
  color: var(--text-muted);
  margin-bottom: var(--sp-8);
}

.fc-my-value {
  font-size: var(--fs-28);
  color: var(--text-secondary);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}
