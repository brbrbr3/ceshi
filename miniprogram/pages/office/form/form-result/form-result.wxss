.form-result-page {
  min-height: 100%;
}

.form-result-header {
  padding: var(--sp-30) var(--sp-40) var(--sp-70);
}

.form-result-title {
  font-size: var(--fs-40);
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: var(--sp-12);
}

.form-result-total {
  font-size: var(--fs-30);
  color: rgba(255, 255, 255, 0.9);
}

.form-result-content {
  margin-top: calc(var(--sp-40) * -1);
}

.form-result-loading,
.form-result-empty {
  text-align: center;
  padding: var(--sp-80) 0;
  color: var(--text-muted);
  font-size: var(--fs-28);
}

.form-result-card {
  padding: var(--sp-28);
  margin-bottom: var(--sp-24);
}

.fr-block-head {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  margin-bottom: var(--sp-20);
}

.fr-block-icon {
  width: var(--sp-52);
  height: var(--sp-52);
  border-radius: var(--sp-12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-35);
  flex-shrink: 0;
}

.fr-block-title {
  flex: 1;
  font-size: var(--fs-35);
  font-weight: 600;
  color: var(--text-primary);
}

.fr-block-count {
  font-size: var(--fs-30);
  color: var(--text-muted);
  flex-shrink: 0;
}

.fr-option-row {
  margin-bottom: var(--sp-20);
}

.fr-option-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-10);
}

.fr-option-name {
  font-size: var(--fs-26);
  color: var(--text-secondary);
}

.fr-option-count {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
}

.fr-progress {
  height: var(--sp-16);
  background: #F1F5F9;
  border-radius: var(--sp-8);
  overflow: hidden;
}

.fr-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #2563EB, #4F46E5);
  border-radius: var(--sp-8);
  transition: width 0.4s ease;
}

.fr-empty-inline {
  color: var(--text-muted);
  font-size: var(--fs-26);
  padding: var(--sp-12) 0;
}

.fr-text-item {
  padding: var(--sp-16);
  background: var(--bg-input);
  border-radius: var(--sp-12);
  margin-bottom: var(--sp-12);
}

.fr-text-user {
  font-size: var(--fs-24);
  color: #2563EB;
  font-weight: 600;
  margin-bottom: var(--sp-6);
}

.fr-text-value {
  font-size: var(--fs-26);
  color: var(--text-secondary);
  line-height: 1.6;
  word-break: break-all;
}

.fr-side-total {
  font-size: var(--fs-28);
  font-weight: 600;
  color: #16A34A;
  margin-bottom: var(--sp-16);
}

.fr-side-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-14) var(--sp-16);
  background: var(--bg-input);
  border-radius: var(--sp-12);
  margin-bottom: var(--sp-12);
}

.fr-side-name {
  font-size: var(--fs-26);
  color: var(--text-secondary);
}

.fr-side-count {
  font-size: var(--fs-26);
  font-weight: 600;
  color: var(--text-primary);
}

.fr-group-row {
  padding: var(--sp-14) var(--sp-16);
  background: var(--bg-input);
  border-radius: var(--sp-12);
  margin-bottom: var(--sp-12);
}

.fr-group-name {
  font-size: var(--fs-26);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-6);
}

.fr-group-members {
  font-size: var(--fs-32);
  color: var(--text-primary);
  line-height: 1.6;
}
