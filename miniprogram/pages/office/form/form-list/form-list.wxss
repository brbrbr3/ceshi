.form-list-page {
  min-height: 100%;
}

.form-list-header {
  padding: var(--sp-30) var(--sp-40) var(--sp-70);
}

.form-list-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-list-title {
  font-size: var(--fs-48);
  font-weight: 700;
  color: #FFFFFF;
}

.form-list-publish {
  position: fixed;
  right: var(--sp-80);
  bottom: calc(var(--sp-80) + env(safe-area-inset-bottom));
  width: var(--sp-100);
  height: var(--sp-100);
  border-radius: var(--sp-50);
  background: linear-gradient(135deg, #1D4ED8 0%, #3B82F6 100%);
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(24, 22, 163, 0.4);
  z-index: 100;
  transition: all 0.2s ease;
}

/* 用伪元素绘制居中加号（两条线拼十字），避免全角「＋」字形重心偏下 */
.form-list-publish::before,
.form-list-publish::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--bg-card);
  border-radius: var(--sp-3);
}

.form-list-publish::before {
  width: var(--sp-44);
  height: var(--sp-6);
}

.form-list-publish::after {
  width: var(--sp-6);
  height: var(--sp-44);
}

.form-list-publish-hover {
  box-shadow: 0 var(--sp-2) var(--sp-3) rgba(24, 22, 163, 0.4);
  transform: scale(0.98);
}

.form-list-content {
  margin-top: var(--sp-20);
}

.form-list-tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: var(--sp-24);
}

.form-list-tabs {
  display: flex;
  gap: var(--sp-16);
  padding: var(--sp-4) var(--sp-8) var(--sp-12);
}

.form-list-tab {
  padding: var(--sp-10) var(--sp-28);
  border-radius: var(--sp-30);
  font-size: var(--fs-28);
  color: var(--text-tertiary);
  background: var(--bg-card);
  transition: all 0.2s ease;
}

.form-list-tab.is-active {
  background: linear-gradient(135deg, #1D4ED8 0%, #3B82F6 100%);
  color: #FFFFFF;
  font-weight: 500;
}

.form-list-body {
  padding-bottom: var(--sp-40);
}

.form-list-item {
  padding: var(--sp-28);
  margin-bottom: var(--sp-24);
  transition: all 0.2s ease;
  position: relative;
  border-left: var(--sp-6) solid #3B82F6;
}

.form-list-dot-badge {
  position: absolute;
  top: var(--sp-16);
  right: var(--sp-16);
  width: var(--sp-16);
  height: var(--sp-16);
  border-radius: 50%;
  background: #F44336;
}

.form-list-item-hover {
  transform: scale(0.98);
  border-left: var(--sp-2) solid #3B82F6;
}

.form-list-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-16);
}

.form-list-badge {
  padding: var(--sp-6) var(--sp-18);
  border-radius: var(--sp-20);
  font-size: var(--fs-26);
  font-weight: 600;
}

.form-list-status {
  font-size: var(--fs-26);
  color: #16A34A;
}

.form-list-status.is-closed {
  color: var(--text-muted);
}

.form-list-status.is-full {
  color: #DC2626;
  font-weight: 600;
}

.form-list-status.is-partial {
  color: #EA580C;
  font-weight: 600;
}

.form-list-item-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: var(--sp-12);
}

.form-list-item-meta {
  font-size: var(--fs-30);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  margin-bottom: var(--sp-4);
}

.form-list-item-restrict {
  color: #EA580C;
}

.form-list-item-visible {
  color: #DC2626;
}

.form-list-item-limit {
  color: #EA580C;
}

.form-list-dot {
  color: #CBD5E1;
}

.form-list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-120) 0;
}

.form-list-empty-icon {
  font-size: var(--sp-96);
  margin-bottom: var(--sp-20);
}

.form-list-empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.form-list-loading {
  text-align: center;
  padding: var(--sp-24) 0;
  font-size: var(--fs-24);
  color: var(--text-muted);
}
