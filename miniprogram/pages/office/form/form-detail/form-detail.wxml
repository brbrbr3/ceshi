<view class="office-page form-detail-page" style="{{fontStyle}}">
  <view class="office-gradient-header form-detail-header">
    <view class="form-detail-title-row">
      <view class="form-detail-badge" style="background: {{tagBg}}; color: {{tagColor}};">{{tagIcon}} {{tagLabel}}</view>
      <view wx:if="{{isPreview}}" class="form-detail-closed">预览</view>
      <view wx:elif="{{isClosed}}" class="form-detail-closed">已截止</view>
    </view>
    <view class="form-detail-title">{{form.title}}</view>
    <view class="form-detail-meta">{{form.createdByName}} · {{timeText}}</view>
  </view>

  <view class="office-content form-detail-content">
    <!-- 无权填报提示 -->
    <view wx:if="{{!canSubmit && !isClosed}}" class="form-detail-submitted-tip is-denied">
      <text>🔒 该信息仅限指定角色填报，您无权填写</text>
    </view>

    <!-- 匿名填写提示 -->
    <view wx:if="{{!mySubmission && isAnonymous && !isClosed && canSubmit}}" class="form-detail-submitted-tip">
      <text>🔒 本问卷为匿名填写，提交后不显示真实姓名</text>
    </view>

    <!-- 已提交提示 -->
    <view wx:if="{{mySubmission && !isClosed && !quizAnswering}}" class="form-detail-submitted-tip">
      <text wx:if="{{isQuiz}}">✅ 您已提交，您的分数为 {{quizResult.lastScore}} 分</text>
      <text wx:elif="{{maxSubmissions > 1}}">✅ 您已提交，可继续填写</text>
      <text wx:elif="{{isAnonymous}}">✅ 您已匿名提交，可修改后重新提交</text>
      <text wx:else>✅ 您已提交，可修改后重新提交</text>
    </view>

    <!-- 正文说明（富文本） -->
    <view class="office-card form-detail-card" wx:if="{{form.description}}">
      <!-- <view class="fd-card-label">正文说明</view> -->
      <mp-html
        container-style="font-size:var(--fs-30);color:#334155;line-height:1.7"
        content="{{form.description}}"
        selectable
        bind:linktap="onLinkTap"
      />
    </view>

    <!-- 控件区 -->
    <block wx:for="{{blocks}}" wx:for-item="bk" wx:key="id">
      <!-- text：分节标题（左侧竖条 + 加粗标题，不编号、不套卡片） -->
      <view wx:if="{{bk.type === 'text'}}" class="fd-section-block">
        <view class="fd-section-bar"></view>
        <view class="fd-section-title">{{bk.title}}</view>
      </view>

      <!-- 其他填写类控件：卡片 + 连续编号 -->
      <view wx:else class="office-card form-detail-card">
        <view class="fd-block-head">
          <view class="fd-block-index">{{bk.fillIndex}}</view>
          <view class="fd-block-title">
            {{bk.title}}
            <text wx:if="{{bk.required}}" class="fd-required">*</text>
          </view>
          <text wx:if="{{bk.scoreText}}" class="fd-score-text">{{bk.scoreText}}</text>
        </view>

        <!-- 单选 / 判断：始终渲染选项 -->
        <block wx:if="{{bk.type === 'radio' || bk.type === 'judge'}}">
          <view class="fd-options">
            <view
              wx:for="{{bk.options}}"
              wx:for-item="opt"
              wx:key="*this"
              class="fd-option {{readonly ? '' : 'fd-option-tap'}}"
              data-id="{{bk.id}}"
              data-value="{{opt}}"
              bindtap="onOptionTap"
            >
              <view class="fd-radio-dot {{bk.answer === opt ? 'is-checked' : ''}}"></view>
              <text>{{opt}}</text>
            </view>
          </view>
        </block>

        <!-- 多选：始终渲染选项 -->
        <block wx:elif="{{bk.type === 'checkbox'}}">
          <view class="fd-options">
            <view
              wx:for="{{bk.optionItems}}"
              wx:for-item="opt"
              wx:key="value"
              class="fd-option {{readonly ? '' : 'fd-option-tap'}}"
              data-id="{{bk.id}}"
              data-value="{{opt.value}}"
              bindtap="onOptionTap"
            >
              <view class="fd-checkbox-box {{opt.checked ? 'is-checked' : ''}}">✓</view>
              <text>{{opt.value}}</text>
            </view>
          </view>
        </block>

        <!-- 简答 -->
        <block wx:elif="{{bk.type === 'textarea'}}">
          <textarea
            wx:if="{{!readonly}}"
            class="fd-textarea"
            value="{{bk.answer}}"
            bindinput="onTextareaInput"
            data-id="{{bk.id}}"
            placeholder="请输入您的回答"
            placeholder-class="fd-placeholder"
            maxlength="1000"
            auto-height
          ></textarea>
          <view wx:else class="fd-readonly">{{bk.answerText === '未填写' ? '（暂无填写）' : bk.answerText}}</view>
        </block>

        <!-- 副食订购：始终渲染类别 -->
        <block wx:elif="{{bk.type === 'side_dish'}}">
          <view class="fd-side-dish">
            <view wx:for="{{bk.categories}}" wx:for-item="cat" wx:key="id" class="fd-cat-row">
              <view class="fd-cat-info">
                <view class="fd-cat-name">{{cat.name}}</view>
                <view class="fd-cat-max">每人最多可订 {{cat.maxCount}} 份<text>\n</text>如配偶随任可订 {{cat.maxCount * 2}} 份</view>
              </view>
              <view wx:if="{{!readonly}}" class="fd-stepper">
                <view class="fd-step-btn" bindtap="onSideDishCountChange" data-id="{{bk.id}}" data-cat-id="{{cat.id}}" data-delta="-1">−</view>
                <view class="fd-step-val">{{cat.count}}</view>
                <view class="fd-step-btn" bindtap="onSideDishCountChange" data-id="{{bk.id}}" data-cat-id="{{cat.id}}" data-delta="1">＋</view>
              </view>
              <view wx:else class="fd-step-val">{{cat.count}} 份</view>
            </view>
          </view>
        </block>

        <!-- 活动报名 -->
        <block wx:elif="{{bk.type === 'activity'}}">
          <view class="fd-activity-meta">{{bk.activityMetaText}}</view>
          <block wx:if="{{bk.groups.length > 0}}">
            <view class="fd-options">
              <view
                wx:for="{{bk.groups}}"
                wx:for-item="g"
                wx:key="*this"
                class="fd-option {{readonly ? '' : 'fd-option-tap'}}"
                data-id="{{bk.id}}"
                data-value="{{g}}"
                bindtap="onOptionTap"
              >
                <view class="fd-radio-dot {{bk.answer === g ? 'is-checked' : ''}}"></view>
                <text>{{g}}</text>
              </view>
            </view>
          </block>
          <block wx:else>
            <view wx:if="{{bk.registeredNames.length > 0}}" class="fd-reg-list">
              <view class="fd-reg-list-title">已报名（{{bk.registeredNames.length}} 人）</view>
              <view class="fd-reg-chips">
                <text wx:for="{{bk.registeredNames}}" wx:for-item="name" wx:key="*this" class="fd-reg-chip">{{name}}</text>
              </view>
            </view>
            <view wx:if="{{!readonly}}" class="fd-register-btn {{bk.isFull && bk.answer.length === 0 ? 'is-full' : (bk.answer.length > 0 ? 'is-registered' : '')}}" bindtap="onActivityRegisterToggle" data-id="{{bk.id}}">
              {{bk.isFull && bk.answer.length === 0 ? '人数已满，无法报名' : (bk.answer.length > 0 ? '已添加 ' + bk.answer.length + ' 人，点击继续添加' : '我要报名')}}
            </view>
            <view wx:if="{{readonly}}" class="fd-readonly">状态：{{bk.answerText}}</view>
          </block>
        </block>
      </view>
    </block>

    <!-- 空控件提示 
    <view wx:if="{{blocks.length === 0}}" class="office-card form-detail-card">
      <view class="fd-empty">该信息暂无额外内容</view>
    </view> -->

    <!-- 填写操作区（答题类型） -->
    <view class="fd-footer" wx:if="{{hasFillableBlocks && !isClosed && canSubmit && !isPreview && isQuiz}}">
      <!-- 正在重新作答：提交 + 放弃重答 -->
      <block wx:if="{{quizAnswering}}">
        <view class="fd-footer-btn is-ghost" bindtap="handleQuizCancelRetry">放弃重答</view>
        <view class="fd-footer-btn is-primary {{submitting ? 'is-disabled' : ''}}" bindtap="handleSubmit">提交</view>
      </block>
      <!-- 次数用完：查看正确答案 -->
      <view wx:elif="{{mySubmission && quizResult.isExhausted}}" class="fd-footer-btn is-primary" bindtap="handleQuizViewAnswers">查看正确答案</view>
      <!-- 未提交：提交 -->
      <view wx:elif="{{!mySubmission}}" class="fd-footer-btn is-primary {{submitting ? 'is-disabled' : ''}}" bindtap="handleSubmit">提交</view>
      <!-- 已提交、有剩余次数：再次答题 -->
      <view wx:else class="fd-footer-btn is-primary" bindtap="handleQuizRetry">再次答题（剩余 {{quizResult.remainingCount}} 次）</view>
    </view>

    <!-- 填写操作区（非答题类型） -->
    <view class="fd-footer" wx:if="{{hasFillableBlocks && !isClosed && canSubmit && !isPreview && !isQuiz}}">
      <view wx:if="{{mySubmission && maxSubmissions === 1}}" class="fd-footer-btn is-cancel" bindtap="handleCancelSubmit">取消提交</view>
      <view class="fd-footer-btn is-primary {{submitting ? 'is-disabled' : ''}}" bindtap="handleSubmit">{{maxSubmissions > 1 ? '提交' : (mySubmission ? '更新提交' : '提交')}}</view>
    </view>

    <!-- 发布者管理入口 -->
    <view class="fd-footer" wx:if="{{isCreator}}">
      <view class="fd-footer-btn is-ghost" bindtap="goEdit">编辑</view>
      <view wx:if="{{form.tag !== 'announcement'}}" class="fd-footer-btn is-ghost" bindtap="goResult">统计</view>
      <view wx:if="{{form.tag === 'questionnaire' || form.tag === 'quiz' || form.tag === 'side_dish'}}" class="fd-footer-btn is-ghost" bindtap="goSubmissions">明细</view>
      <view class="fd-footer-btn is-danger" bindtap="handleDelete">删除</view>
    </view>
  </view>

  <!-- 活动报名弹窗 -->
  <view wx:if="{{registerModal.show}}" class="fd-modal-mask {{modalAnimating ? 'is-closing' : ''}}" catchtap="closeRegisterModal">
    <view class="fd-modal" catchtap="stopPropagation">
      <view class="fd-modal-title">活动报名</view>
      <view class="fd-modal-hint">默认为本人，可为他人代报名</view>
      <view wx:if="{{registerModal.names.length > 0}}" class="fd-reg-modal-list">
        <view wx:for="{{registerModal.names}}" wx:for-item="name" wx:for-index="idx" wx:key="idx" class="fd-reg-modal-item">
          <text class="fd-reg-modal-name">{{name}}</text>
          <text class="fd-reg-modal-del" bindtap="onRemoveRegisterName" data-index="{{idx}}">删除</text>
        </view>
      </view>
      <view class="fd-reg-modal-input-row">
        <input class="fd-reg-modal-input" value="{{registerModal.input}}" bindinput="onRegisterInput" placeholder="请输入报名人姓名" confirm-type="done" bindconfirm="onAddRegisterName" />
        <view class="fd-reg-modal-add" bindtap="onAddRegisterName">添加</view>
      </view>
      <view class="fd-modal-footer">
        <view class="fd-modal-btn is-cancel" bindtap="closeRegisterModal">取消</view>
        <view class="fd-modal-btn is-confirm" bindtap="confirmRegisterModal">确定</view>
      </view>
    </view>
  </view>
</view>
