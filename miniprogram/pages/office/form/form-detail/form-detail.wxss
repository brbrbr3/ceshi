.form-detail-page {
  min-height: 100%;
}

.form-detail-header {
  padding: var(--sp-30) var(--sp-40) var(--sp-70);
}

.form-detail-title-row {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  margin-bottom: var(--sp-20);
}

.form-detail-badge {
  padding: var(--sp-6) var(--sp-18);
  border-radius: var(--sp-20);
  font-size: var(--fs-22);
  font-weight: 600;
}

.form-detail-closed {
  padding: var(--sp-6) var(--sp-18);
  border-radius: var(--sp-20);
  font-size: var(--fs-22);
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.form-detail-title {
  font-size: var(--fs-40);
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.4;
  margin-bottom: var(--sp-12);
}

.form-detail-meta {
  font-size: var(--fs-30);
  color: rgba(255, 255, 255, 0.85);
}

.form-detail-content {
  margin-top: calc(var(--sp-40) * -1);
}

.form-detail-submitted-tip {
  margin-bottom: var(--sp-20);
  padding: var(--sp-20) var(--sp-28);
  background: #DCFCE7;
  border: var(--sp-2) solid #86EFAC;
  border-radius: var(--sp-16);
  color: #16A34A;
  font-size: var(--fs-28);
}

.form-detail-submitted-tip.is-denied {
  background: #FEF2F2;
  border-color: #FECACA;
  color: #DC2626;
}

.form-detail-card {
  padding: var(--sp-28);
  margin-bottom: var(--sp-24);
}

.fd-card-label {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-16);
}

.fd-rich {
  font-size: var(--fs-30);
  color: var(--text-secondary);
  line-height: 1.7;
}

.fd-block-head {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-12);
  margin-bottom: var(--sp-20);
}

.fd-block-index {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: 50%;
  background: var(--bg-soft);
  color: #2563EB;
  font-size: var(--fs-28);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fd-block-title {
  flex: 1;
  font-size: var(--fs-35);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}

.fd-required {
  color: #DC2626;
  margin-left: var(--sp-4);
}

.fd-score-text {
  flex-shrink: 0;
  padding: var(--sp-4) var(--sp-14);
  border-radius: var(--sp-20);
  background: var(--hint-warn-bg);
  color: var(--hint-warn-text);
  font-size: var(--fs-24);
  font-weight: 600;
  margin-top: var(--sp-6);
}

.fd-text-block {
  font-size: var(--fs-28);
  color: var(--text-secondary);
  line-height: 1.7;
  padding: var(--sp-16);
  background: var(--bg-input);
  border-radius: var(--sp-12);
}

/* ===== 分节标题（text 说明块，不套卡片、不编号） ===== */
.fd-section-block {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  padding: var(--sp-24) var(--sp-8);
  margin: var(--sp-4) 0;
}

.fd-section-bar {
  width: var(--sp-10);
  height: var(--sp-50);
  border-radius: var(--sp-4);
  background: linear-gradient(180deg, #2563EB, #4F46E5);
  flex-shrink: 0;
}

.fd-section-title {
  flex: 1;
  font-size: var(--fs-35);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.fd-options {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.fd-option {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--sp-16) var(--sp-8);
  font-size: var(--fs-30);
  color: var(--text-secondary);
}

.fd-option-tap {
  border-radius: var(--sp-12);
  transition: background 0.15s ease;
}

.fd-option-tap:active {
  background: var(--bg-soft-2);
}

.fd-radio-dot {
  width: var(--sp-32);
  height: var(--sp-32);
  border-radius: 50%;
  border: var(--sp-3) solid #CBD5E1;
  box-sizing: border-box;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.fd-radio-dot.is-checked {
  border-color: #2563EB;
  background: radial-gradient(circle, #2563EB 0%, #2563EB 42%, transparent 50%);
}

.fd-checkbox-box {
  width: var(--sp-32);
  height: var(--sp-32);
  border-radius: var(--sp-8);
  border: var(--sp-3) solid #CBD5E1;
  box-sizing: border-box;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
  color: transparent;
  transition: all 0.15s ease;
}

.fd-checkbox-box.is-checked {
  border-color: #2563EB;
  background: #2563EB;
  color: #FFFFFF;
}

.fd-textarea {
  width: 100%;
  min-height: var(--sp-160);
  background: var(--bg-input);
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-16);
  padding: var(--sp-20);
  font-size: var(--fs-28);
  box-sizing: border-box;
}

.fd-placeholder {
  color: var(--text-muted);
}

.fd-readonly {
  padding: var(--sp-16) var(--sp-20);
  background: var(--bg-input);
  border-radius: var(--sp-12);
  font-size: var(--fs-32);
  color: var(--text-tertiary);
}

.fd-side-dish {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

.fd-cat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-16);
  background: var(--bg-input);
  border-radius: var(--sp-12);
}

.fd-cat-name {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.fd-cat-max {
  font-size: var(--fs-28);
  color: var(--text-muted);
  margin-top: var(--sp-4);
}

.fd-stepper {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.fd-step-btn {
  width: var(--sp-56);
  height: var(--sp-56);
  border-radius: var(--sp-12);
  background: var(--bg-soft);
  color: #2563EB;
  font-size: var(--fs-32);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.fd-step-val {
  min-width: var(--sp-60);
  text-align: center;
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.fd-activity-meta {
  font-size: var(--fs-28);
  color: var(--hint-warn-text);
  margin-bottom: var(--sp-16);
  padding: var(--sp-12) var(--sp-16);
  background: var(--hint-warn-bg);
  border-radius: var(--sp-12);
}

.fd-register-btn {
  padding: var(--sp-22);
  text-align: center;
  border-radius: var(--sp-16);
  background: var(--bg-soft);
  border: var(--sp-2) solid #2563EB;
  color: #2563EB;
  font-size: var(--fs-30);
  font-weight: 600;
  transition: all 0.2s ease;
}

.fd-register-btn.is-registered {
  background: #DCFCE7;
  border-color: #16A34A;
  color: #16A34A;
}

.fd-register-btn.is-full {
  background: var(--bg-soft-2);
  border-color: #CBD5E1;
  color: var(--text-muted);
}

.fd-register-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.fd-empty {
  text-align: center;
  padding: var(--sp-40) 0;
  color: var(--text-muted);
  font-size: var(--fs-28);
}

.fd-footer {
  display: flex;
  gap: var(--sp-20);
  margin-top: var(--sp-8);
}

.fd-footer-btn {
  flex: 1;
  height: var(--sp-100);
  border-radius: var(--sp-24);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-30);
  font-weight: 600;
  transition: all 0.3s ease;
  margin-bottom: var(--sp-16);
}

.fd-footer-btn:active {
  opacity: 0.75;
  transform: scale(0.9);
}

.fd-footer-btn.is-primary {
  background: linear-gradient(135deg, #2563EB, #4F46E5);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-8) var(--sp-20) rgba(37, 99, 235, 0.3);
}

.fd-footer-btn.is-cancel {
  background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
  color: #FFFFFF;
  border: var(--sp-2) solid var(--border-soft);
}

.fd-footer-btn.is-ghost {
  background: var(--bg-card);
  color: #2563EB;
}

.fd-footer-btn.is-danger {
  background: var(--bg-card);
  color: #DC2626;
}

.fd-footer-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* ===== 活动报名名单 ===== */
.fd-reg-list {
  margin-bottom: var(--sp-16);
}

.fd-reg-list-title {
  font-size: var(--fs-30);
  color: var(--text-tertiary);
  font-weight: 600;
  margin-bottom: var(--sp-12);
  margin-top: var(--sp-36);
}

.fd-reg-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-12);
  margin-bottom: var(--sp-60);
}

.fd-reg-chip {
  padding: var(--sp-8) var(--sp-20);
  background: var(--bg-soft-2);
  border-radius: var(--sp-24);
  font-size: var(--fs-32);
  color: var(--text-primary);
}

/* ===== 活动报名弹窗 ===== */
.fd-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fdFadeIn 0.2s ease;
}

.fd-modal-mask.is-closing {
  animation: fdFadeOut 0.25s ease forwards;
}

.fd-modal {
  width: var(--sp-620);
  background: var(--bg-card);
  border-radius: var(--sp-24);
  padding: var(--sp-40) var(--sp-32) var(--sp-32);
  box-sizing: border-box;
  animation: fdSlideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.is-closing .fd-modal {
  animation: fdSlideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

.fd-modal-title {
  font-size: var(--fs-34);
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: var(--sp-8);
}

.fd-modal-hint {
  font-size: var(--fs-24);
  color: var(--text-muted);
  text-align: center;
  margin-bottom: var(--sp-24);
}

.fd-reg-modal-list {
  max-height: var(--sp-320);
  overflow-y: auto;
  margin-bottom: var(--sp-20);
}

.fd-reg-modal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-14) var(--sp-16);
  background: var(--bg-input);
  border-radius: var(--sp-12);
  margin-bottom: var(--sp-10);
}

.fd-reg-modal-name {
  font-size: var(--fs-28);
  color: var(--text-secondary);
}

.fd-reg-modal-del {
  font-size: var(--fs-24);
  color: #DC2626;
}

.fd-reg-modal-input-row {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  margin-bottom: var(--sp-24);
}

.fd-reg-modal-input {
  flex: 1;
  height: var(--sp-72);
  background: var(--bg-input);
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-12);
  padding: 0 var(--sp-20);
  font-size: var(--fs-28);
  box-sizing: border-box;
}

.fd-reg-modal-add {
  flex-shrink: 0;
  padding: 0 var(--sp-28);
  height: var(--sp-72);
  line-height: var(--sp-72);
  text-align: center;
  background: var(--bg-soft);
  color: #2563EB;
  border-radius: var(--sp-12);
  font-size: var(--fs-28);
  font-weight: 600;
}

.fd-modal-footer {
  display: flex;
  gap: var(--sp-20);
}

.fd-modal-btn {
  flex: 1;
  height: var(--sp-80);
  border-radius: var(--sp-20);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-30);
  font-weight: 600;
}

.fd-modal-btn.is-cancel {
  background: var(--bg-soft-2);
  color: var(--text-tertiary);
}

.fd-modal-btn.is-confirm {
  background: linear-gradient(135deg, #2563EB, #4F46E5);
  color: #FFFFFF;
}

@keyframes fdFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fdFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes fdSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fdSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}
