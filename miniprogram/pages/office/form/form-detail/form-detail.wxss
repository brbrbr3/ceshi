.form-detail-page {
  min-height: 100%;
}

.form-detail-header {
  padding: 30rpx 40rpx 70rpx;
}

.form-detail-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.form-detail-badge {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: var(--fs-22);
  font-weight: 600;
}

.form-detail-closed {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: var(--fs-22);
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.form-detail-title {
  font-size: var(--fs-40);
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.form-detail-meta {
  font-size: var(--fs-24);
  color: rgba(255, 255, 255, 0.85);
}

.form-detail-content {
  margin-top: -40rpx;
}

.form-detail-submitted-tip {
  margin-bottom: 20rpx;
  padding: 20rpx 28rpx;
  background: #DCFCE7;
  border: 2rpx solid #86EFAC;
  border-radius: 16rpx;
  color: #16A34A;
  font-size: var(--fs-28);
}

.form-detail-submitted-tip.is-denied {
  background: #FEF2F2;
  border-color: #FECACA;
  color: #DC2626;
}

.form-detail-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.fd-card-label {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 16rpx;
}

.fd-rich {
  font-size: var(--fs-30);
  color: #334155;
  line-height: 1.7;
}

.fd-block-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.fd-block-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #EFF6FF;
  color: #2563EB;
  font-size: var(--fs-24);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fd-block-title {
  flex: 1;
  font-size: var(--fs-32);
  font-weight: 600;
  color: #1E293B;
  line-height: 1.5;
}

.fd-required {
  color: #DC2626;
  margin-left: 4rpx;
}

.fd-score-text {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #FEF3C7;
  color: #D97706;
  font-size: var(--fs-24);
  font-weight: 600;
  margin-top: 6rpx;
}

.fd-text-block {
  font-size: var(--fs-28);
  color: #475569;
  line-height: 1.7;
  padding: 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
}

/* ===== 分节标题（text 说明块，不套卡片、不编号） ===== */
.fd-section-block {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 8rpx;
  margin: 4rpx 0;
}

.fd-section-bar {
  width: 10rpx;
  height: 50rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2563EB, #4F46E5);
  flex-shrink: 0;
}

.fd-section-title {
  flex: 1;
  font-size: var(--fs-32);
  font-weight: 700;
  color: #1E293B;
  line-height: 1.4;
}

.fd-options {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fd-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 8rpx;
  font-size: var(--fs-30);
  color: #334155;
}

.fd-option-tap {
  border-radius: 12rpx;
  transition: background 0.15s ease;
}

.fd-option-tap:active {
  background: #F1F5F9;
}

.fd-radio-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #CBD5E1;
  box-sizing: border-box;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.fd-radio-dot.is-checked {
  border-color: #2563EB;
  background: radial-gradient(circle, #2563EB 0%, #2563EB 42%, transparent 50%);
}

.fd-checkbox-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 3rpx solid #CBD5E1;
  box-sizing: border-box;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
  color: transparent;
  transition: all 0.15s ease;
}

.fd-checkbox-box.is-checked {
  border-color: #2563EB;
  background: #2563EB;
  color: #FFFFFF;
}

.fd-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: var(--fs-28);
  box-sizing: border-box;
}

.fd-placeholder {
  color: #94A3B8;
}

.fd-readonly {
  padding: 16rpx 20rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  font-size: var(--fs-28);
  color: #64748B;
}

.fd-side-dish {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fd-cat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
}

.fd-cat-name {
  font-size: var(--fs-30);
  font-weight: 600;
  color: #1E293B;
}

.fd-cat-max {
  font-size: var(--fs-28);
  color: #94A3B8;
  margin-top: 4rpx;
}

.fd-stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.fd-step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: var(--fs-32);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.fd-step-val {
  min-width: 60rpx;
  text-align: center;
  font-size: var(--fs-30);
  font-weight: 600;
  color: #1E293B;
}

.fd-activity-meta {
  font-size: var(--fs-28);
  color: #EA580C;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #FFF7ED;
  border-radius: 12rpx;
}

.fd-register-btn {
  padding: 22rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #EFF6FF;
  border: 2rpx solid #2563EB;
  color: #2563EB;
  font-size: var(--fs-30);
  font-weight: 600;
  transition: all 0.2s ease;
}

.fd-register-btn.is-registered {
  background: #DCFCE7;
  border-color: #16A34A;
  color: #16A34A;
}

.fd-register-btn.is-full {
  background: #F1F5F9;
  border-color: #CBD5E1;
  color: #94A3B8;
}

.fd-register-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.fd-empty {
  text-align: center;
  padding: 40rpx 0;
  color: #94A3B8;
  font-size: var(--fs-28);
}

.fd-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.fd-footer-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-30);
  font-weight: 600;
  transition: all 0.3s ease;
  margin-bottom: 16rpx;
}

.fd-footer-btn:active {
  opacity: 0.75;
  transform: scale(0.9);
}

.fd-footer-btn.is-primary {
  background: linear-gradient(135deg, #2563EB, #4F46E5);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.3);
}

.fd-footer-btn.is-cancel {
  background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
  color: #FFFFFF;
  border: 2rpx solid #E2E8F0;
}

.fd-footer-btn.is-ghost {
  background: #FFFFFF;
  color: #2563EB;
}

.fd-footer-btn.is-danger {
  background: #FFFFFF;
  color: #DC2626;
}

.fd-footer-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* ===== 活动报名名单 ===== */
.fd-reg-list {
  margin-bottom: 16rpx;
}

.fd-reg-list-title {
  font-size: var(--fs-30);
  color: #64748B;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.fd-reg-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.fd-reg-chip {
  padding: 8rpx 20rpx;
  background: #F1F5F9;
  border-radius: 24rpx;
  font-size: var(--fs-32);
  color: #334155;
}

/* ===== 活动报名弹窗 ===== */
.fd-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fdFadeIn 0.2s ease;
}

.fd-modal-mask.is-closing {
  animation: fdFadeOut 0.25s ease forwards;
}

.fd-modal {
  width: 620rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  animation: fdSlideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.is-closing .fd-modal {
  animation: fdSlideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

.fd-modal-title {
  font-size: var(--fs-34);
  font-weight: 700;
  color: #1E293B;
  text-align: center;
  margin-bottom: 8rpx;
}

.fd-modal-hint {
  font-size: var(--fs-24);
  color: #94A3B8;
  text-align: center;
  margin-bottom: 24rpx;
}

.fd-reg-modal-list {
  max-height: 320rpx;
  overflow-y: auto;
  margin-bottom: 20rpx;
}

.fd-reg-modal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.fd-reg-modal-name {
  font-size: var(--fs-28);
  color: #334155;
}

.fd-reg-modal-del {
  font-size: var(--fs-24);
  color: #DC2626;
}

.fd-reg-modal-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.fd-reg-modal-input {
  flex: 1;
  height: 72rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: var(--fs-28);
  box-sizing: border-box;
}

.fd-reg-modal-add {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #EFF6FF;
  color: #2563EB;
  border-radius: 12rpx;
  font-size: var(--fs-28);
  font-weight: 600;
}

.fd-modal-footer {
  display: flex;
  gap: 20rpx;
}

.fd-modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-30);
  font-weight: 600;
}

.fd-modal-btn.is-cancel {
  background: #F1F5F9;
  color: #64748B;
}

.fd-modal-btn.is-confirm {
  background: linear-gradient(135deg, #2563EB, #4F46E5);
  color: #FFFFFF;
}

@keyframes fdFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fdFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes fdSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fdSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}
