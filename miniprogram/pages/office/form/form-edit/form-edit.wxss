.form-edit-page {
  min-height: 100%;
  padding-bottom: var(--sp-40);
}

.form-edit-header {
  padding: var(--sp-30) var(--sp-40) var(--sp-80);
}

.form-edit-title {
  font-size: var(--fs-48);
  font-weight: 700;
  color: #FFFFFF;
  text-align: left;
}

.form-edit-content {
  margin-top: calc(var(--sp-60) * -1);
}

.form-edit-card {
  padding: var(--sp-28);
  margin-bottom: var(--sp-24);
}

.fe-label {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-20);
  margin-top: var(--sp-20);
}

.fe-sub-label {
  font-size: var(--fs-35);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-30);
}

.fe-required {
  color: #DC2626;
}

/* ===== tag 选择 ===== */
.fe-tag-scroll {
  width: 100%;
  white-space: nowrap;
}

.fe-tag-row {
  display: inline-flex;
  gap: var(--sp-16);
  padding: var(--sp-5) var(--sp-15) var(--sp-5) var(--sp-10);
}

.fe-tag-item {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-8);
  padding: var(--sp-14) var(--sp-28);
  border-radius: var(--sp-40);
  font-size: var(--fs-28);
  color: var(--text-tertiary);
  background: var(--bg-soft-2);
  border: var(--sp-2) solid var(--border-soft);
  transition: all 0.2s ease;
}

.fe-tag-item.is-active {
  transform: scale(1.05);
  font-weight: 600;
}

.fe-tag-icon {
  font-size: var(--fs-28);
}

/* ===== 富文本 ===== */
.fe-editor-wrapper {
  border-radius: var(--sp-24);
  overflow: hidden;
  background: var(--bg-input);
  border: var(--sp-1) solid var(--border-soft);
}

.fe-editor-wrapper editor {
  min-height: var(--sp-300);
  padding: var(--sp-20);
  box-sizing: border-box;
}

.fe-editor-wrapper .ql-editor.ql-blank::before {
  color: var(--text-muted);
}

/* ===== 控件库 ===== */
.fe-palette {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.fe-palette-item {
  width: 48.5%;
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  padding: var(--sp-20);
  border-radius: var(--sp-20);
  box-sizing: border-box;
  margin-bottom: var(--sp-16);
  flex-shrink: 0;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.fe-palette-item-hover {
  transform: scale(0.96);
  opacity: 0.85;
}

.fe-palette-icon {
  font-size: var(--sp-44);
}

.fe-palette-text {
  flex: 1;
}

.fe-palette-label {
  font-size: var(--fs-28);
  font-weight: 600;
}

.fe-palette-desc {
  font-size: var(--fs-22);
  opacity: 0.7;
  margin-top: var(--sp-4);
}

.fe-palette-add {
  font-size: var(--fs-36);
  font-weight: 700;
  opacity: 0.6;
}

/* ===== 已添加控件 ===== */
.fe-block-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-20);
}

.fe-block-item {
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-20);
  padding: var(--sp-20);
  background: var(--bg-input);
  transition: transform 0.25s ease, opacity 0.3s ease;
}

.fe-block-item.is-new {
  animation: blockIn 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.fe-block-item.is-removing {
  animation: blockOut 0.3s ease forwards;
}

@keyframes blockIn {
  from { opacity: 0; transform: translateY(var(--sp-24)) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes blockOut {
  from { opacity: 1; max-height: var(--sp-600); }
  to { opacity: 0; max-height: 0; transform: translateX(var(--sp-30)); padding-top: 0; padding-bottom: 0; border-width: 0; }
}

/* 上移/下移动画 */
.fe-block-item.is-move-up {
  animation: moveUp 0.35s ease;
}

.fe-block-item.is-move-down {
  animation: moveDown 0.35s ease;
}

@keyframes moveUp {
  0% { transform: translateY(var(--sp-24)); opacity: 0.4; }
  100% { transform: translateY(0); opacity: 1; }
}

@keyframes moveDown {
  0% { transform: translateY(calc(var(--sp-24) * -1)); opacity: 0.4; }
  100% { transform: translateY(0); opacity: 1; }
}

.fe-block-head {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  flex-wrap: wrap;
}

.fe-block-index {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: 50%;
  background: var(--border-soft);
  color: var(--text-secondary);
  font-size: var(--fs-24);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fe-block-type {
  padding: var(--sp-4) var(--sp-16);
  border-radius: var(--sp-20);
  font-size: var(--fs-22);
  font-weight: 600;
  flex-shrink: 0;
}

.fe-block-title {
  flex: 1;
  min-width: var(--sp-200);
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 600;
}

.fe-block-required {
  padding: var(--sp-2) var(--sp-12);
  border-radius: var(--sp-8);
  background: #FEE2E2;
  color: #DC2626;
  font-size: var(--fs-20);
  flex-shrink: 0;
}

.fe-block-preview {
  margin-top: var(--sp-16);
  padding: var(--sp-16);
  background: var(--bg-card);
  border-radius: var(--sp-12);
}

.fe-preview-option {
  display: flex;
  align-items: center;
  gap: var(--sp-10);
  font-size: var(--fs-26);
  color: var(--text-secondary);
  padding: var(--sp-4) 0;
}

.fe-preview-dot {
  width: var(--sp-24);
  height: var(--sp-24);
  border-radius: 50%;
  border: var(--sp-2) solid var(--text-muted);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-18);
  color: #FFFFFF;
  box-sizing: border-box;
}

.fe-preview-dot.is-square {
  border-radius: var(--sp-5);
}

.fe-preview-dot.is-correct {
  background: #16A34A;
  border-color: #16A34A;
  color: #FFFFFF;
}

.fe-block-actions {
  display: flex;
  gap: var(--sp-12);
  margin-top: var(--sp-16);
}

.fe-block-btn {
  flex: 1;
  text-align: center;
  padding: var(--sp-10) 0;
  border-radius: var(--sp-12);
  background: var(--bg-soft);
  color: #2563EB;
  font-size: var(--fs-24);
  transition: all 0.3s ease;
}

.fe-block-btn:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.fe-block-btn.is-danger {
  background: #FEE2E2;
  color: #DC2626;
}

/* ===== 开关 ===== */
.fe-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fe-switch {
  width: var(--sp-88);
  height: var(--sp-48);
  border-radius: var(--sp-24);
  background: #CBD5E1;
  position: relative;
  transition: background 0.25s ease;
}

.fe-switch.is-on {
  background: #2563EB;
}

.fe-switch-dot {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: 50%;
  background: var(--bg-card);
  position: absolute;
  top: var(--sp-5);
  left: var(--sp-5);
  transition: transform 0.25s ease;
}

.fe-switch.is-on .fe-switch-dot {
  transform: translateX(var(--sp-41));
}

.fe-switch-hint {
  font-size: var(--fs-30);
  color: var(--text-tertiary);
}

/* ===== 填写次数步进器 ===== */
.fe-stepper {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.fe-step-btn {
  width: var(--sp-56);
  height: var(--sp-56);
  border-radius: var(--sp-12);
  background: var(--bg-soft);
  color: #2563EB;
  font-size: var(--fs-32);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  transition: opacity 0.15s ease;
}

.fe-step-btn.is-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.fe-step-val {
  min-width: var(--sp-60);
  text-align: center;
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.fe-hint {
  font-size: var(--fs-28);
  color: var(--text-muted);
  margin-top: var(--sp-12);
}

.fe-extra-area {
  margin-top: var(--sp-20);
}

.fe-sub-block{
  margin-top: var(--sp-24);
}

/* 动效 */
.fe-extra-area,
.fe-sub-label,
.fe-check-row,
.fe-sub-block,
.fe-switch-row,
.fe-hint,
.form-edit-card {
  animation: blockIn 0.3s ease;
}


.fe-role-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-16);
}

.fe-role-item {
  flex-shrink: 0;
  padding: var(--sp-12) var(--sp-28);
  border-radius: var(--sp-40);
  background: var(--bg-soft-2);
  border: var(--sp-2) solid var(--border-soft);
  color: var(--text-tertiary);
  font-size: var(--fs-26);
  transition: all 0.2s ease;
}

.fe-role-item.is-active {
  background: var(--bg-soft);
  border-color: #2563EB;
  color: #2563EB;
}

/* 部门横向滚动列表 */
.fe-dept-scroll {
  margin-top: var(--sp-16);
  white-space: nowrap;
  width: 100%;
}

.fe-dept-list {
  display: inline-flex;
  gap: var(--sp-16);
  padding: var(--sp-4) var(--sp-2);
}

.fe-check-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
  margin-top: var(--sp-16);
  font-size: var(--fs-28);
  color: var(--text-tertiary);
}

/* ===== 底部按钮 ===== */
.fe-footer {
  display: flex;
  gap: var(--sp-20);
  margin-top: var(--sp-8);
  padding: 0 var(--sp-4);
}

.fe-btn {
  flex: 1;
  height: var(--sp-92);
  border-radius: var(--sp-24);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-30);
  font-weight: 600;
  transition: all 0.3s ease;
}

.fe-btn:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.fe-btn-draft {
  background: var(--bg-card);
  color: var(--text-secondary);
  border: var(--sp-2) solid var(--border-soft);
}


.fe-btn-publish {
  background: linear-gradient(135deg, #2563EB, #4F46E5);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-8) var(--sp-20) rgba(37, 99, 235, 0.3);
}

.fe-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* ===== 弹窗 ===== */
.fe-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  animation: fadeIn 0.2s ease;
  display: flex;
  align-items: flex-end;
}

.fe-modal-mask.is-closing {
  animation: fadeOut 0.25s ease forwards;
}

.fe-modal-container {
  width: 100%;
  max-height: 85vh;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  animation: slideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
  display: flex;
  flex-direction: column;
}

.is-closing .fe-modal-container {
  animation: slideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

.fe-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-28) var(--sp-32);
  border-bottom: var(--sp-2) solid var(--bg-soft-2);
}

.fe-modal-title {
  font-size: var(--fs-34);
  font-weight: 700;
  color: var(--text-primary);
}

.fe-modal-close {
  font-size: var(--fs-44);
  color: var(--text-muted);
  padding: 0 var(--sp-8);
}

.fe-modal-body {
  flex: 1;
  max-height: 60vh;
  padding: var(--sp-24) var(--sp-32);
  box-sizing: border-box;
}

.fe-modal-field {
  margin-bottom: var(--sp-28);
}

.fe-modal-label {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-16);
}

.fe-option-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

.fe-option-row {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
}

.fe-option-dot {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: 50%;
  border: var(--sp-2) solid var(--text-muted);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-24);
  color: #FFFFFF;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.fe-option-dot.is-square {
  border-radius: var(--sp-8);
}

.fe-option-dot.is-correct {
  background: #16A34A;
  border-color: #16A34A;
  color: #FFFFFF;
}

.fe-option-input {
  flex: 1;
  height: var(--sp-72);
  background: var(--bg-input);
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-12);
  padding: 0 var(--sp-20);
  font-size: var(--fs-26);
}

.fe-option-remove {
  width: var(--sp-48);
  height: var(--sp-48);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #DC2626;
  font-size: var(--fs-36);
  flex-shrink: 0;
}

.fe-add-btn {
  margin-top: var(--sp-16);
  padding: var(--sp-16);
  text-align: center;
  border: var(--sp-2) dashed #CBD5E1;
  border-radius: var(--sp-12);
  color: #2563EB;
  font-size: var(--fs-26);
}

.fe-category-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

.fe-category-row {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
}

.fe-category-name {
  flex: 1;
  height: var(--sp-72);
  background: var(--bg-input);
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-12);
  padding: 0 var(--sp-20);
  font-size: var(--fs-28);
}

.fe-category-max {
  width: var(--sp-140);
  height: var(--sp-72);
  background: var(--bg-input);
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-12);
  padding: 0 var(--sp-20);
  font-size: var(--fs-28);
  text-align: center;
}

.fe-modal-footer {
  display: flex;
  gap: var(--sp-20);
  padding: var(--sp-24) var(--sp-32) calc(var(--sp-24) + env(safe-area-inset-bottom));
  border-top: var(--sp-2) solid var(--bg-soft-2);
}

/* ===== 草稿提示 ===== */
.fe-draft-tip {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  padding: var(--sp-48) var(--sp-32) calc(var(--sp-48) + env(safe-area-inset-bottom));
  text-align: center;
  animation: slideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.fe-draft-tip-icon {
  font-size: var(--sp-88);
  margin-bottom: var(--sp-20);
}

.fe-draft-tip-title {
  font-size: var(--fs-34);
  font-weight: 700;
  color: var(--text-primary);
}

.fe-draft-tip-desc {
  font-size: var(--fs-28);
  color: var(--text-tertiary);
  margin: var(--sp-16) 0 var(--sp-32);
}

.fe-draft-tip-actions {
  display: flex;
  gap: var(--sp-20);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes slideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

/* ===== 答题分数设置 ===== */
.fe-score-mode-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
  margin-top: var(--sp-8);
}

.fe-score-mode-item {
  display: flex;
  flex-direction: column;
  gap: var(--sp-6);
  padding: var(--sp-20) var(--sp-24);
  border-radius: var(--sp-16);
  background: var(--bg-input);
  border: var(--sp-2) solid var(--border-soft);
  transition: all 0.2s ease;
}

.fe-score-mode-item.is-active {
  background: var(--bg-soft);
  border-color: #2563EB;
}

.fe-score-mode-label {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.fe-score-mode-item.is-active .fe-score-mode-label {
  color: #2563EB;
}

.fe-score-mode-desc {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
}

.fe-choice-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
  margin-top: var(--sp-8);
  margin-bottom: var(--sp-16);
}

.fe-choice-row {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  padding: var(--sp-16) var(--sp-20);
  border-radius: var(--sp-14);
  background: var(--bg-input);
  border: var(--sp-2) solid var(--border-soft);
  font-size: var(--fs-28);
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.fe-choice-row.is-active {
  background: var(--bg-soft);
  border-color: #2563EB;
  color: #2563EB;
}

.fe-choice-dot {
  width: var(--sp-30);
  height: var(--sp-30);
  border-radius: 50%;
  border: var(--sp-2) solid var(--text-muted);
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.fe-choice-dot.is-checked {
  background: #2563EB;
  border-color: #2563EB;
  box-shadow: inset 0 0 0 var(--sp-6) #FFFFFF;
}

.fe-score-row {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  padding: var(--sp-16) 0;
  border-bottom: var(--sp-2) solid var(--bg-soft-2);
}

.fe-score-row-label {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--text-primary);
  word-break: break-all;
}

.fe-score-input {
  width: var(--sp-180);
  height: var(--sp-68);
  background: var(--bg-input);
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-12);
  padding: 0 var(--sp-20);
  font-size: var(--fs-26);
  text-align: center;
  box-sizing: border-box;
}

.fe-score-row-unit {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
}
