.notifications-page {
  background: var(--bg-page);
  min-height: 100vh;
}

.office-header {
  background: var(--bg-card);
  padding: var(--sp-24) var(--sp-32) var(--sp-20);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: var(--sp-1) solid var(--border-soft);
  padding-top: calc(var(--sp-24) + env(safe-area-inset-top));
}

.office-header-title {
  font-size: var(--fs-36);
  font-weight: 600;
  color: var(--text-primary);
}

.office-header-actions {
  display: flex;
  gap: var(--sp-24);
}

.notifications-content {
  padding: var(--sp-24) var(--sp-32);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-120) 0;
}

.empty-icon {
  font-size: var(--sp-120);
  margin-bottom: var(--sp-24);
}

.empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.notifications-list {
  padding: 0;
}

.notification-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: var(--sp-24) 0;
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  background: transparent !important;
}

.notification-item:last-child {
  border-bottom: none;
}

.notification-item.is-read {
  opacity: 0.6;
}

.notification-left {
  padding-left: var(--sp-10);
  display: flex;
  flex: 1;
  gap: var(--sp-20);
}

.notification-icon {
  width: var(--sp-80);
  height: var(--sp-80);
  border-radius: var(--sp-16);
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-40);
  flex-shrink: 0;
}

.notification-main {
  flex: 1;
  min-width: 0;
}

.notification-title {
  font-size: var(--fs-28);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--sp-8);
}

.notification-title.is-unread {
  color: #2563EB;
  font-weight: 600;
}

.notification-content {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
  line-height: 1.6;
  margin-bottom: var(--sp-8);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notification-time {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.notification-right {
  padding-right: var(--sp-10);
  display: flex;
  align-items: center;
  padding-left: var(--sp-16);
}

.notification-dot {
  width: var(--sp-16);
  height: var(--sp-16);
  border-radius: 50%;
  background: #EF4444;
  flex-shrink: 0;
}
