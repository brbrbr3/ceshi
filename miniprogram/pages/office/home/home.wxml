<page-meta page-style="{{pageStyle}}" />
<view class="office-page home-page {{themeClass}}" style="{{fontStyle}}">
  <view class="office-gradient-header home-header">





    <!-- 背景装饰图片 -->
    <view class="home-bg-image-wrapper">
      <image class="home-bg-image" src="/image/nm-low.jpg" mode="widthFix" />
    </view>
  </view>


  <view class="office-content">
    <!--全馆日历模块-->
    <view class="office-glass-card home-calendar" hover-class="home-btn-active" hover-stay-time="300" bindtap="goCalendar">
      <view class="home-calendar-main">
        <view class="home-calendar-icon">🗓️</view>
        <view>
          <view class="home-calendar-title">{{currentDateText}}</view>
          <view class="home-calendar-desc">{{todayTypeText}}</view>
        </view>
      </view>
    </view>
    <!--欢迎词 + 通知、搜索图标-->
    <view class="home-greeting-row">
      <view class="home-greeting">{{greetingText}}</view>
      <view class="home-actions">
        <view class="office-icon-btn-wrapper" bindtap="toggleTheme">
          <view class="office-icon-btn home-icon-btn-theme">{{themeIcon}}</view>
        </view>
        <view class="office-icon-btn-wrapper" bindtap="goNotifications">
          <view class="office-icon-btn home-icon-btn-ntf">🔔</view>
          <view wx:if="{{unreadNotificationCount > 0}}" class="office-badge">{{unreadNotificationCount}}</view>
        </view>
      </view>
    </view>
    <!--外出状态栏-->
    <view wx:if="{{activeTrip}}" class="home-trip-status">
      <view class="home-trip-status-info" hover-class="home-trip-status-info-active" hover-stay-time="300" bindtap="goTripReport">
        <text class="home-trip-status-icon">🚗</text>
        <view class="home-trip-status-text">
          <view class="home-trip-status-label">外出中：{{activeTrip.destination}}</view>
          <view class="home-trip-status-sub">已外出 {{activeTrip.elapsedTimeText}}</view>
        </view>
      </view>
      <view class="home-trip-return-btn" hover-class="home-trip-status-info-active" hover-stay-time="300" catchtap="handleReturnFromHome">返回报备</view>
    </view>
    <!--功能面板（所有图标对所有人可见）-->
    <view class="office-section">
      <view class="office-card home-grid-card">
        <view class="home-grid">
          <view wx:for="{{quickActions}}" wx:key="label" class="home-grid-item" hover-class="home-btn-active" hover-stay-time="300" bindtap="handleQuickAction" data-label="{{item.label}}" data-feature="{{item.featureKey}}">
            <view class="home-grid-icon {{item.implemented === false ? 'is-implemented' : ''}}" style="background: {{item.bg}}; color: {{item.color}};">{{item.icon}}</view>
            <view class="home-grid-label {{item.implemented === false ? 'is-implemented' : ''}}">{{item.label}}</view>
          </view>
        </view>
      </view>
    </view>

    <!--馆内动态-->
    <view class="office-section">
      <view class="office-card home-news-card" hover-class="{{(!loadingContentForms && contentForms.length === 0) ? 'home-btn-active' : ''}}" hover-stay-time="{{(!loadingContentForms && contentForms.length === 0) ? '300' : ''}}">
      <view class="office-section-header home-section-header" hover-class="{{(!loadingContentForms && contentForms.length === 0) ? '' : 'home-btn-active'}}" hover-stay-time="{{(!loadingContentForms && contentForms.length === 0) ? '' : '300'}}" bindtap="goContentForms">
        <view class="office-section-title home-section-title">📢馆内动态</view>
        <view class="office-link home-link">进入栏目</view>
      </view>
        <view class="home-news-item" hover-class="home-btn-active" hover-stay-time="300" wx:for="{{contentForms}}" wx:key="_id" bindtap="handleContentFormTap" data-id="{{item._id}}">
          <view class="office-pill home-news-tag" style="background: {{item.tagBg}}; color: {{item.tagColor}};">{{item.tagIcon}} {{item.tagLabel}}</view>
          <view class="home-news-main">
            <view class="home-news-title">{{item.title}}</view>
            <view class="home-news-time">{{item.time}}</view>
          </view>
          <view wx:if="{{item.isClosed}}" class="office-pill home-news-closed">已截止</view>
          <view wx:if="{{item.isUnread}}" class="home-news-dot"></view>
        </view>
        <view wx:if="{{loadingContentForms}}" class="home-news-loading">
          <view class="home-news-loading-spinner"></view>
          <text class="home-news-loading-text">加载中...</text>
        </view>
        <view wx:if="{{!loadingContentForms && contentForms.length === 0}}" class="empty-announcement" bindtap="goContentForms">
          <text class="empty-text">暂无内容</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 日程详情弹窗 -->
  <view class="detail-popup-mask {{showScheduleDetail ? 'is-visible' : ''}}" catchtouchmove="stopPropagation" bindtap="hideScheduleDetail">
    <view class="detail-popup-container" catchtap="stopPropagation">
      <!-- 弹窗头部 -->
      <view class="detail-popup-header">
        <view class="detail-popup-close" bindtap="hideScheduleDetail">×</view>
        <view class="detail-popup-title">日程详情</view>
        <view class="detail-popup-unsubscribe" bindtap="handleUnsubscribe">取消订阅</view>
      </view>

      <!-- 详情内容 -->
      <scroll-view class="detail-popup-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
        <view class="detail-popup-content" wx:if="{{detailSchedule}}">
          <!-- 标题区域 -->
          <view class="detail-header">
            <view class="detail-type-dot" style="background: {{detailSchedule.color}};"></view>
            <text class="detail-title">{{detailSchedule.title}}</text>
            <text class="detail-type-name">{{detailSchedule.typeName}}</text>
          </view>

          <!-- 时间信息 -->
          <view class="detail-section">
            <view class="detail-section-title">时间</view>
            <view class="detail-time-info">
              <view class="detail-time-row" wx:if="{{detailSchedule.isAllDay}}">
                <text class="detail-time-label">全天</text>
                <text class="detail-time-value">{{detailSchedule.startDate}}</text>
              </view>
              <view class="detail-time-row" wx:else>
                <text class="detail-time-label">开始</text>
                <text class="detail-time-value">{{detailSchedule.startDate}} {{detailSchedule.startTime}}</text>
              </view>
              <view class="detail-time-row" wx:if="{{!detailSchedule.isAllDay}}">
                <text class="detail-time-label">结束</text>
                <text class="detail-time-value">{{detailSchedule.endDate}} {{detailSchedule.endTime}}</text>
              </view>
            </view>
          </view>

          <!-- 地点 -->
          <view class="detail-section" wx:if="{{detailSchedule.location}}">
            <view class="detail-section-title">地点</view>
            <text class="detail-section-value">{{detailSchedule.location}}</text>
          </view>

          <!-- 备注 -->
          <view class="detail-section" wx:if="{{detailSchedule.description}}">
            <view class="detail-section-title">备注</view>
            <text class="detail-section-value">{{detailSchedule.description}}</text>
          </view>

          <!-- 创建者 -->
          <view class="detail-section" wx:if="{{detailSchedule.creatorName}}">
            <view class="detail-section-title">创建者</view>
            <text class="detail-section-value">{{detailSchedule.creatorName}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 通用弹窗（队列顺序显示） -->
  <multiuse-modal
    visible="{{modalVisible}}"
    title="{{modalTitle}}"
    content="{{modalContent}}"
    confirmText="{{modalConfirmText}}"
    cancelText="{{modalCancelText}}"
    danger="{{modalDanger}}"
    countdown="{{modalCountdown}}"
    bind:confirm="onModalConfirm"
    bind:cancel="onModalCancel"
  />
</view>