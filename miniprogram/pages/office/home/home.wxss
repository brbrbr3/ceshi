page {
  background: var(--bg-page);
}

/* 从 app.wxss 迁移的样式 - 仅本页面使用 */
.office-glass-card {
  background: rgba(255, 255, 255, 0.1);
  border: var(--sp-3) solid rgba(255, 255, 255, 0.48);
  box-shadow: var(--sp-3) var(--sp-3) var(--sp-2) rgba(255, 255, 255, 0.42);
  backdrop-filter: blur(15px);
}

.office-icon-btn {
  width: var(--sp-72);
  height: var(--sp-72);
  border-radius: var(--sp-36);
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: var(--fs-28);
}

.home-header {
  height: 30%;
  padding-bottom: var(--sp-40);
  position: relative;
  overflow: hidden;
  background: var(--bg-card);
}

/* 背景装饰图片 */
.home-bg-image-wrapper {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  overflow: hidden;
  z-index: 0;
  pointer-events: none;
  /* -webkit-mask-image: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, rgba(0,0,0,1) 20%); */
}

.home-bg-image {
  width: 100%;
  position: absolute;
  top: 50%;
  left: 0;
  transform: translateY(-52%);
  display: block;
  border-radius: 0;
}

/* 顶部渐变遮罩：从透明到半透明深色 */
/* .home-bg-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to bottom, #3b83f69f 0% , rgba(255, 255, 255, 0) 30%); 
  pointer-events: none;
} */

.home-brand {
  display: flex;
  align-items: center;
  gap: var(--sp-18);
}

.home-brand-mark {
  width: var(--sp-64);
  height: var(--sp-64);
  border-radius: var(--sp-22);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  font-size: var(--fs-28);
  font-weight: 700;
}

.home-brand-name {
  font-size: var(--fs-24);
  opacity: 0.84;
}

.home-brand-sub {
  margin-top: var(--sp-6);
  font-size: var(--fs-22);
  opacity: 0.72;
}

.home-actions {
  display: flex;
  gap: var(--sp-16);
  flex-shrink: 0;
}

.home-greeting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-20);
  position: relative;
  z-index: 1;
}

.office-icon-btn-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.home-icon-btn-ntf,
.home-icon-btn-theme {
  border: none;
  background: var(--bg-card);
  border-radius: var(--sp-100);  
  box-shadow: 0 var(--sp-16) var(--sp-42) rgba(37, 99, 235, 0.08);
}

.office-badge {
  position: absolute;
  top: calc(var(--sp-4) * -1);
  right: calc(var(--sp-4) * -1);
  min-width: var(--sp-32);
  height: var(--sp-32);
  padding: 0 var(--sp-10);
  border-radius: var(--sp-16);
  background: #F44336;
  color: #FFFFFF;
  font-size: var(--fs-18);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: 0 var(--sp-2) var(--sp-8) rgba(244, 67, 54, 0.3);
}

/* 外出状态栏 */
.home-trip-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-20);
  padding: var(--sp-24) var(--sp-28);
  background: var(--hint-warn-bg);
  border: var(--sp-1) solid var(--hint-warn-border);
  border-radius: var(--sp-20);
  transition: all 0.25s ease;
  animation: trip-status-in 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

/* 状态栏按压反馈 */
.home-trip-status-info-active {
  transform: scale(0.95);
  opacity: 0.7;
}

/* 状态栏入场动效：淡入 + 上滑 */
@keyframes trip-status-in {
  from {
    opacity: 0;
    transform: translateY(var(--sp-20));
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.home-trip-status-info {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  flex: 1;
  min-width: 0;
  transition: all 0.25s ease;
}

.home-trip-status-icon {
  font-size: var(--fs-48);
  flex-shrink: 0;
}

.home-trip-status-text {
  flex: 1;
  min-width: 0;
}

.home-trip-status-label {
  font-size: var(--fs-28);
  font-weight: 600;
  color: var(--hint-warn-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-trip-status-sub {
  font-size: var(--fs-24);
  color: var(--hint-warn-text);
  margin-top: var(--sp-4);
}

.home-trip-return-btn {
  flex-shrink: 0;
  padding: var(--sp-12) var(--sp-28);
  background: linear-gradient(135deg, #16A34A 0%, #059669 100%);
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 600;
  border-radius: var(--sp-12);
  transition: all 0.25s ease;
}

.home-trip-return-btn:active {
  opacity: 0.8;
}

.home-greeting {
  font-size: var(--fs-36);
  font-weight: 600;
}

.home-calendar {
  border: none;
  margin: calc(var(--sp-4) * -1) 0 0;
  border-radius: var(--sp-28);
  padding: var(--sp-24) var(--sp-28);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
  box-shadow: 0 var(--sp-16) var(--sp-42) rgba(37, 99, 235, 0.08);
  background: var(--bg-card);
}

.home-calendar-main {
  display: flex;
  align-items: center;
  gap: var(--sp-18);
}

.home-calendar-icon {
  width: var(--sp-64);
  height: var(--sp-64);
  border-radius: var(--sp-20);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-70);
  padding-right: var(--sp-8);
}

.home-calendar-title {
  font-size: var(--fs-30);
  font-weight: 600;
}

.home-calendar-desc {
  margin-top: var(--sp-6);
  font-size: var(--fs-26);
}

.home-calendar-tag {
  margin-right: calc(var(--sp-20) * -1);
  min-width: var(--sp-106);
  padding: var(--sp-14) var(--sp-26);
  border-radius: var(--sp-999);
  text-align: center;
  background: rgba(255, 255, 255, 0.1);
  font-size: var(--fs-24);
  font-weight: 400;
  border: 1px solid rgba(0, 0, 0, 0.238);
}

.home-stats-card {
  padding: var(--sp-145) 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.home-stats-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--sp-26) var(--sp-12);
  height: 100%;
  width: 100%;
}

.home-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 17%;
  box-sizing: border-box;
  border-radius: var(--sp-25);
  padding: 0 0 var(--sp-20);
}

.home-stat-item.stat-clickable {
  cursor: pointer;
  transition: opacity 0.2s;
}

.home-stat-item.stat-clickable:active {
  opacity: 0.7;
}

.home-stat-badge {
  min-width: var(--sp-76);
  height: var(--sp-76);
  padding: var(--sp-10) var(--sp-10) 0;
  border-radius: var(--sp-24);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-40);
  font-weight: 700;
}

.home-stat-label {
  font-size: var(--fs-26);
  color: #ffffff;
}

.home-grid-card,
.home-list-card,
.home-news-card,
.home-schedule-card {
  padding: var(--sp-24);
}

.home-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-26) var(--sp-12);
}

.home-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 23.6%;
  box-sizing: border-box;
}

.home-grid-icon {
  width: var(--sp-100);
  height: var(--sp-100);
  border-radius: var(--sp-28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-66);
}

.home-grid-icon.is-implemented {
  background: var(--bg-soft-2) !important;
  color: var(--text-muted) !important;
}

.home-section-title {
  padding-bottom: var(--sp-20);
}

.home-link {
  padding-bottom: var(--sp-20);
}

/* 通用点击动效 */
.home-calendar,
.office-icon-btn-wrapper,
.home-grid-item,
.home-section-title,
.home-link,
.home-news-item,
.home-section-header,
.home-news-card {
  transition: all 0.3s ease;
}

.home-section-header {
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

.home-btn-active {
  transform: scale(0.93);
  opacity: 0.75;
}

.home-grid-label {
  margin-top: var(--sp-14);
  font-size: var(--fs-28);
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.4;
}

.home-grid-label.is-implemented {
  color: var(--text-muted);
}

.home-title-with-badge {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
}

.home-count-badge {
  min-width: var(--sp-34);
  height: var(--sp-34);
  border-radius: var(--sp-17);
  background: #F44336;
  color: #FFFFFF;
  font-size: var(--fs-22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-list-item {
  display: flex;
  align-items: center;
  gap: var(--sp-20);
  padding: var(--sp-18) 0;
}

.home-list-item + .home-list-item {
  border-top: var(--sp-1) solid rgba(37, 99, 235, 0.1);
}

.home-list-main {
  flex: 1;
  min-width: 0;
}

.home-list-title-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-6);
}

.home-list-name {
  font-size: var(--fs-26);
  font-weight: 600;
  color: var(--text-primary);
}

.home-dot,
.home-list-sub {
  font-size: var(--fs-24);
  color: var(--text-muted);
  margin-left: var(--sp-8);
}

.home-list-type {
  font-size: var(--fs-24);
  color: var(--text-secondary);
}

.home-list-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--sp-10);
}

.home-list-time {
  font-size: var(--fs-22);
  color: var(--text-muted);
}

.home-mini-btn {
  padding: var(--sp-10) var(--sp-20);
  font-size: var(--fs-22);
}

.home-news-item {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-16);
  padding: var(--sp-16) 0 var(--sp-16);
}

.home-news-item + .home-news-item {
  border-top: var(--sp-1) solid rgba(37, 99, 235, 0.1);
  padding-top: var(--sp-24);
}

.home-news-tag {
  font-size: var(--fs-26);
  margin-top: var(--sp-2);
}

.home-news-main {
  flex: 1;
  min-width: 0;
}

.home-news-title {
  font-size: var(--fs-30);
  color: var(--text-primary);
  line-height: 1.45;
}

.home-news-title.is-read {
  color: var(--text-muted);
}

.home-news-time {
  margin-top: var(--sp-10);
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.home-news-dot {
  width: var(--sp-14);
  height: var(--sp-14);
  border-radius: 50%;
  background: #F44336;
  margin-top: var(--sp-12);
}

/* 已截止标签：与左侧类型标签同一行对齐，右端展示，不抢标题视觉 */
.home-news-closed {
  flex-shrink: 0;
  margin-top: var(--sp-2);
  color: var(--danger-text);
  background: var(--danger-soft-bg);
}

.home-news-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-15) 0;
}


.home-news-loading-spinner {
  width: var(--sp-56);
  height: var(--sp-56);
  border: var(--sp-4) solid var(--border-soft);
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: home-news-spin 0.8s linear infinite;
}

@keyframes home-news-spin {
  to { transform: rotate(360deg); }
}

.home-news-loading-text {
  margin-top: var(--sp-20);
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.home-schedule-item {
  display: flex;
  align-items: center;
  gap: var(--sp-18);
}

.home-schedule-item + .home-schedule-item {
  margin-top: var(--sp-22);
}

.home-schedule-time {
  width: var(--sp-80);
  text-align: right;
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.home-schedule-line {
  width: var(--sp-8);
  height: var(--sp-54);
  border-radius: var(--sp-999);
}

.home-schedule-main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
}

.home-schedule-title {
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.home-schedule-type {
  flex-shrink: 0;
}

.empty-announcement {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--sp-60) 0;
}

.empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* 学习园地首页模块 */
.home-learning-icon {
  width: var(--sp-48);
  height: var(--sp-48);
  border-radius: var(--sp-14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-28);
  background: linear-gradient(135deg, #FEE2E2, #FECACA);
  flex-shrink: 0;
  margin-top: var(--sp-2);
}

.home-learning-pinned {
  display: inline-block;
  font-size: var(--fs-18);
  color: #FFFFFF;
  background: linear-gradient(135deg, #DC2626, #B91C1C);
  padding: 0 var(--sp-8);
  border-radius: var(--sp-4);
  margin-right: var(--sp-6);
  vertical-align: middle;
  line-height: 1.4;
}

/* 群团活动首页模块 */
.home-activity-icon {
  width: var(--sp-48);
  height: var(--sp-48);
  border-radius: var(--sp-14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-28);
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
  flex-shrink: 0;
  margin-top: var(--sp-2);
}

.activity-home-tag {
  flex-shrink: 0;
  padding: var(--sp-4) var(--sp-16);
  border-radius: var(--sp-999);
  font-size: var(--fs-22);
  font-weight: 500;
}

.tag-active {
  color: #10B981;
  background: #D1FAE5;
}

.tag-ended {
  color: var(--text-muted);
  background: var(--bg-soft-2);
}

/* 空状态 */
.empty-schedule,
.loading-schedule {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--sp-60) 0;
}

/* ========================================
   日程详情弹窗样式
   ======================================== */

/* 弹窗遮罩 */
.detail-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.detail-popup-mask.is-visible {
  opacity: 1;
  visibility: visible;
}

/* 弹窗容器 */
.detail-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-input);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.detail-popup-mask.is-visible .detail-popup-container {
  transform: translateY(0);
}

/* 弹窗头部 */
.detail-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-28) var(--sp-32);
  background: var(--bg-card);
  border-bottom: var(--sp-1) solid var(--border-soft);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  flex-shrink: 0;
}

.detail-popup-close {
  font-size: var(--fs-48);
  color: var(--text-tertiary);
  width: var(--sp-48);
  height: var(--sp-48);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-popup-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  padding-left: var(--sp-40);
}

.detail-popup-unsubscribe {
  font-size: var(--fs-26);
  color: #EF4444;
  font-weight: 500;
}

/* 详情滚动区域 */
.detail-popup-scroll {
  flex: 1;
  height: 0;
  overflow: hidden;
}

.detail-popup-content {
  padding: var(--sp-24);
}

/* 标题区域 */
.detail-header {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  margin-bottom: var(--sp-24);
  flex-wrap: wrap;
}

.detail-type-dot {
  width: var(--sp-16);
  height: var(--sp-16);
  border-radius: 50%;
  flex-shrink: 0;
}

.detail-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.detail-type-name {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
  background: var(--bg-soft-2);
  padding: var(--sp-8) var(--sp-16);
  border-radius: var(--sp-8);
}

/* 详情区块 */
.detail-section {
  background: var(--bg-card);
  border-radius: var(--sp-24);
  padding: var(--sp-24) var(--sp-32);
  margin-bottom: var(--sp-16);
}

.detail-section-title {
  font-size: var(--fs-24);
  color: var(--text-muted);
  margin-bottom: var(--sp-12);
  font-weight: 500;
}

.detail-section-value {
  font-size: var(--fs-28);
  color: var(--text-primary);
  line-height: 1.6;
}

/* 时间信息 */
.detail-time-info {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

.detail-time-row {
  display: flex;
  align-items: center;
  gap: var(--sp-24);
}

.detail-time-label {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
  width: var(--sp-80);
  flex-shrink: 0;
}

.detail-time-value {
  font-size: var(--fs-26);
  color: var(--text-primary);
}
