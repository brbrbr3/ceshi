/* 本馆日历页面样式 */

.calendar-page {
  min-height: 100vh;
  background: var(--bg-page);
}
.calendar-gradient-header{
  padding: var(--sp-30) var(--sp-28) var(--sp-32);
}
.calendar-header-top{
}

/* 头部标题 */
.calendar-title {
  font-size: var(--fs-48);
  font-weight: 600;
  color: #FFFFFF;
}

.calendar-subtitle {
  font-size: var(--fs-26);
  color: rgba(255, 255, 255);
}

/* 配置按钮 */
.calendar-config-btn {
  padding: var(--sp-12) var(--sp-24);
  min-width: var(--sp-190);
  margin-top: var(--sp-70);
  border-radius: var(--sp-24);
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: var(--fs-24);
  font-weight: 400;
  display: flex;
  align-content: center;
  justify-content: center;
  border: var(--sp-1) solid rgba(255, 255, 255, 0.3);
}

/* 日历容器 */
.calendar-container {
  padding: var(--sp-2) 0 0;
}

/* 巴西节假日提示 */
.brazil-holiday-tip {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  margin: var(--sp-8) var(--sp-24) 0;
  padding: var(--sp-20) var(--sp-28);
  background: linear-gradient(135deg, var(--bg-soft) 0%, var(--bg-soft) 100%);
  border-radius: var(--sp-16);
  border: var(--sp-1) solid #BFDBFE;
}

.brazil-holiday-flag {
  font-size: var(--fs-40);
  flex-shrink: 0;
}

.brazil-holiday-text {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.brazil-holiday-pt {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--checklist-on-text);
}

.brazil-holiday-zh {
  font-size: var(--fs-28);
  color: var(--checklist-on-text);
}

/* 配置弹窗遮罩 */
.config-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.config-popup-mask.is-visible {
  opacity: 1;
  visibility: visible;
}

/* 配置弹窗容器 */
.config-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  height: 80vh;
  display: flex;
  flex-direction: column;
  margin: 0 var(--sp-20) 0;
}

.config-popup-mask.is-visible .config-popup-container {
  transform: translateY(0);
}

/* 固定头部区域（标题 + 年份选择） */
.config-popup-fixed-header {
  flex-shrink: 0;
}

/* 配置弹窗头部 */
.config-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-32);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

/* 弹窗标题 */
.config-popup-title {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.config-popup-close {
  font-size: var(--fs-48);
  color: var(--text-muted);
  line-height: 1;
  padding: 0 var(--sp-8);
}

/* 年份选择 */
.config-field {
  display: flex;
  align-items: center;
  padding: var(--sp-16) var(--sp-32);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

/* 可滚动区域 */
.config-popup-scroll {
  flex: 1;
  height: 0;
  overflow: hidden;
}

/* 配置表单（scroll-view 内部） */
.config-popup-form {
  padding: var(--sp-24) var(--sp-32);
}

.config-field-label {
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
}

.config-field-label-inline {
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
}

.config-year-picker {
  display: flex;
  align-items: center;
  background: var(--bg-input);
  border-radius: var(--sp-12);
  padding: var(--sp-16) var(--sp-24);
  margin: 0 var(--sp-16);
}

.config-year-picker text:first-child {
  font-size: var(--fs-28);
  color: #2563EB;
  font-weight: 600;
}

.config-picker-arrow {
  font-size: var(--fs-22);
  color: var(--text-muted);
  margin-left: var(--sp-8);
}

/* 节假日列表 */
.config-holidays-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-20);
  margin-bottom: var(--sp-24);
}

.config-holiday-item {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
}

.config-holiday-label {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
  width: var(--sp-180);
  flex-shrink: 0;
}

.config-date-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: 0 var(--sp-24);
  height: var(--sp-80);
}

.config-date-picker text:first-child {
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.config-delete-btn {
  width: var(--sp-56);
  height: var(--sp-56);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FEE2E2;
  border-radius: 50%;
  font-size: var(--fs-32);
  color: #DC2626;
  flex-shrink: 0;
}

/* 添加按钮 */
.config-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--sp-96);
  font-size: var(--fs-32);
  font-weight: 600;
  border-radius: var(--sp-16);
  border: none;
  background: var(--bg-soft);
  border: var(--sp-2) dashed #2563EB;
  color: #2563EB;
}

.config-add-icon {
  font-size: var(--fs-36);
  font-weight: 600;
}

/* 弹窗底部（固定提交按钮） */
.config-popup-footer {
  padding: var(--sp-24) var(--sp-32);
  padding-bottom: calc(var(--sp-24) + env(safe-area-inset-bottom));
  border-top: var(--sp-1) solid var(--bg-soft-2);
  flex-shrink: 0;
  z-index: 100;
}

/* 提交按钮 */
.config-submit-btn {
  width: 100%;
  height: var(--sp-96);
  background: linear-gradient(135deg, #2563EB 0%, #4F46E5 100%);
  color: #FFFFFF;
  font-size: var(--fs-32);
  font-weight: 600;
  border-radius: var(--sp-16);
  border: none;
}

.config-submit-btn[disabled] {
  background: var(--text-muted);
}

/* ========================================
   时间轴日程列表样式
   ======================================== */

/* 日程区域容器 */
.schedule-section {
  margin: var(--sp-4) var(--sp-8) 0;
  background: var(--bg-card);
  border-radius: var(--sp-24);
  overflow: hidden;
  position: relative;
  box-shadow: 0 var(--sp-8) var(--sp-32) rgba(37, 99, 235, 0.08);
}

/* 日期标题 */
.schedule-date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--sp-28) var(--sp-32);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

.schedule-date-title {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.schedule-date-count {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
}

/* 全天日程区域 */
.all-day-section {
  display: flex;
  align-items: flex-start;
  padding: var(--sp-20) var(--sp-24);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  background: var(--bg-input);
}

.all-day-label {
  width: var(--sp-80);
  font-size: var(--fs-24);
  color: var(--text-tertiary);
  flex-shrink: 0;
  padding-top: var(--sp-8);
}

.all-day-events {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-12);
}

.all-day-event {
  padding: var(--sp-12) var(--sp-20);
  border-radius: var(--sp-12);
  border-left: var(--sp-4) solid;
  flex-shrink: 0;
}

.all-day-event-title {
  font-size: var(--fs-26);
  color: var(--text-primary);
  font-weight: 500;
}

/* 时间轴滚动区域 */
.timeline-scroll {
  height: var(--sp-700);
  position: relative;
}

.timeline-container {
  position: relative;
  min-height: 100%;
}

/* 小时网格 */
.timeline-grid {
  position: relative;
}

.hour-row {
  display: flex;
  align-items: flex-start;
  height: var(--sp-100);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

.hour-label {
  width: var(--sp-80);
  font-size: var(--fs-24);
  color: var(--text-muted);
  text-align: center;
  padding-top: var(--sp-4);
  flex-shrink: 0;
}

/* .hour-line {
  flex: 1;
  height: var(--sp-1);
  background: var(--border-soft);
  margin-top: var(--sp-16);
} */

/* 日程条容器 */
.schedule-bars {
  position: absolute;
  top: 0;
  left: var(--sp-80);
  right: var(--sp-16);
  bottom: 0;
  pointer-events: none;
  box-sizing: border-box;
}

/* 日程条 */
.schedule-bar {
  position: absolute;
  border-radius: var(--sp-12);
  padding: var(--sp-12) var(--sp-16);
  box-sizing: border-box;
  pointer-events: auto;
  overflow: hidden;
  min-height: var(--sp-50);
  opacity: 0.9;
  box-shadow: 0 var(--sp-4) var(--sp-12) rgba(0, 0, 0, 0.1);
}

.schedule-bar-title {
  font-size: var(--fs-24);
  color: #FFFFFF;
  font-weight: 500;
  display: block;
  text-shadow: 0 var(--sp-1) var(--sp-2) rgba(0, 0, 0, 0.2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-bar-time {
  font-size: var(--fs-22);
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-top: var(--sp-4);
}

/* 当前时间红线 */
.current-time-line {
  margin-top: calc(var(--sp-10) * -1);
  position: absolute;
  left: var(--sp-70);
  right: 0;
  display: flex;
  align-items: center;
  pointer-events: none;
  z-index: 100;
}

.current-time-label {
  position: absolute;
  left: calc(var(--sp-66) * -1);
  font-size: var(--fs-24);
  color: #EF4444;
  font-weight: 600;
  width: var(--sp-72);
  text-align: center;
  background: rgba(255, 255, 255, 0.8);
  border: var(--sp-1) solid  #EF4444;
  border-radius: var(--sp-255);
}

.current-time-dot {
  width: var(--sp-16);
  height: var(--sp-16);
  background: #EF4444;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 var(--sp-8) rgba(239, 68, 68, 0.7);
  margin-left: var(--sp-14);
}

.current-time-bar {
  flex: 1;
  height: var(--sp-2);
  background: #EF4444;
  box-shadow: 0 0 var(--sp-4) rgba(239, 68, 68, 0.5);
}

/* 添加日程按钮 */
.add-schedule-btn {
  position: absolute;
  right: var(--sp-32);
  bottom: var(--sp-32);
  width: var(--sp-100);
  height: var(--sp-100);
  background: linear-gradient(135deg, #2563EB 0%, #4F46E5 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(37, 99, 235, 0.4);
  z-index: 250;
}

.add-schedule-icon {
  font-size: var(--fs-48);
  color: #FFFFFF;
  font-weight: 300;
}

/* ========================================
   日程编辑弹窗样式
   ======================================== */

/* 弹窗遮罩 */
.schedule-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.schedule-popup-mask.is-visible {
  opacity: 1;
  visibility: visible;
  animation: scheduleFadeIn 0.25s ease;
}

/* 弹窗容器 */
.schedule-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-input);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  height: 85vh;
  display: flex;
  flex-direction: column;
}

.schedule-popup-mask.is-visible .schedule-popup-container {
  transform: translateY(0);
  animation: scheduleSlideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* 退出动画（与 modalAnimation behavior 的 250ms 对齐；放最后以确保覆盖入场动画） */
.schedule-popup-mask.is-closing {
  animation: scheduleFadeOut 0.25s ease forwards;
}

.schedule-popup-mask.is-closing .schedule-popup-container {
  animation: scheduleSlideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

@keyframes scheduleFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scheduleSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes scheduleFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes scheduleSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

/* 弹窗头部 */
.schedule-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-28) var(--sp-32);
  background: var(--bg-card);
  border-bottom: var(--sp-1) solid var(--border-soft);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  flex-shrink: 0;
}

.schedule-popup-cancel {
  font-size: var(--fs-28);
  color: var(--text-tertiary);
  padding: var(--sp-8) var(--sp-16);
}

.schedule-popup-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
}

.schedule-popup-save {
  font-size: var(--fs-28);
  color: #2563EB;
  font-weight: 600;
  padding: var(--sp-8) var(--sp-16);
}

/* 弹窗滚动区域 */
.schedule-popup-scroll {
  flex: 1;
  height: 0;
  overflow: hidden;
}

.schedule-popup-form {
  padding: var(--sp-24);
}

/* 表单卡片 */
.schedule-form-card {
  background: var(--bg-card);
  border-radius: var(--sp-24);
  padding: var(--sp-8) var(--sp-24);
  margin-bottom: var(--sp-20);
}

/* 表单字段 */
.schedule-field {
  padding: var(--sp-20) 0;
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

.schedule-field:last-child {
