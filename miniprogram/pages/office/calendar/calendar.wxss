}

.schedule-field-value-content-repeatEndDate{
  margin-top: calc(var(--sp-40) * -1);
}

.schedule-field-value-content{
  padding-right: var(--sp-20);
}

/* 类型颜色点 */
.schedule-type-dot {
  width: var(--sp-16);
  height: var(--sp-16);
  border-radius: 50%;
  margin-right: var(--sp-16);
}

/* 输入框 */
.schedule-input {
  width: 100%;
  height: var(--sp-80);
  font-size: var(--fs-28);
  color: var(--text-primary);
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: 0 var(--sp-20);
