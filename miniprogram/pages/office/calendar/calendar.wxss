  justify-content: space-between;
  padding: var(--sp-28) var(--sp-32);
  background: var(--bg-card);
  border-bottom: var(--sp-1) solid var(--border-soft);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  flex-shrink: 0;
}

.detail-popup-close {
  font-size: var(--fs-48);
  color: var(--text-muted);
  line-height: 1;
  padding: var(--sp-8);
}

.detail-popup-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
}

.detail-popup-edit {
  font-size: var(--fs-28);
  color: #2563EB;
  font-weight: 600;
}

/* 详情滚动区域 */
.detail-popup-scroll {
  flex: 1;
  height: 0;
  overflow: hidden;
}

.detail-popup-content {
  padding: var(--sp-24);
  padding-bottom: calc(var(--sp-10) + env(safe-area-inset-bottom));
}

/* 详情头部 */
.detail-header {
  background: var(--bg-card);
  border-radius: var(--sp-24);
  padding: var(--sp-32);
  margin-bottom: var(--sp-24);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--sp-16);
}

.detail-type-dot {
  width: var(--sp-16);
  height: var(--sp-16);
  border-radius: 50%;
  margin-bottom: var(--sp-8);
}

.detail-title {
  font-size: var(--fs-36);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.detail-type-name {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
  background: var(--bg-soft-2);
  padding: var(--sp-8) var(--sp-16);
  border-radius: var(--sp-8);
}

/* 详情区块 */
.detail-section {
  background: var(--bg-card);
  border-radius: var(--sp-24);
  padding: var(--sp-24) var(--sp-32);
  margin-bottom: var(--sp-16);
}

.detail-section-title {
  font-size: var(--fs-24);
  color: var(--text-muted);
  margin-bottom: var(--sp-12);
  font-weight: 500;
}

.detail-section-value {
  font-size: var(--fs-28);
  color: var(--text-primary);
  line-height: 1.6;
}

/* 时间信息 */
.detail-time-info {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

.detail-time-row {
  display: flex;
  align-items: center;
  gap: var(--sp-24);
}

.detail-time-label {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
  width: var(--sp-80);
  flex-shrink: 0;
}

.detail-time-value {
  font-size: var(--fs-26);
  color: var(--text-primary);
}

/* 重复信息 */
.detail-repeat-info {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
}

.detail-repeat-label {
  font-size: var(--fs-26);
  color: var(--text-primary);
}

.detail-repeat-end {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
}

/* 日期选择器容器 */
.date-picker-container {
  padding: var(--sp-32);
  background: var(--bg-input);
  border-radius: var(--sp-16);
  margin: var(--sp-16);
}

/* 占位符样式 */
.is-placeholder {
  color: var(--text-muted) !important;
  color: var(--text-tertiary);
  width: var(--sp-60);
  flex-shrink: 0;
}

.detail-time-value {
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
}

/* 详情弹窗底部按钮区 */
.detail-popup-footer {
  padding: var(--sp-5) 0 var(--sp-24);
  background: var(--bg-card);
  border-top: var(--sp-1) solid var(--border-soft);
  flex-shrink: 0;
}

.detail-subscribe-btn {
  width: 100%;
  height: var(--sp-88);
  line-height: var(--sp-88);
  border-radius: var(--sp-16);
  background: #2563EB;
  color: #FFFFFF;
  font-size: var(--fs-30);
  font-weight: 500;
  border: none;
}

.detail-subscribe-btn-text{
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;  
  text-align: center；
}

.detail-subscribe-btn.is-subscribed {
  background: var(--bg-soft-2);
  color: var(--text-tertiary);
}

.detail-subscribe-btn::after {
  border: none;
}
