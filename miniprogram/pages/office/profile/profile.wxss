page {
  background: var(--bg-page);
}

.profile-header {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: var(--sp-40) var(--sp-40) var(--sp-40);
}

.profile-theme-switch {
  width: var(--sp-140);
  height: var(--sp-56);
  margin-left: auto;
  border-radius: var(--sp-999);
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-24);
}

.profile-user-row {
  display: flex;
  align-items: center;
  gap: var(--sp-20);
}

.profile-avatar-wrap {
  position: relative;
}

.profile-avatar {
  width: var(--sp-150);
  height: var(--sp-150);
  border-radius: var(--sp-40);
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-48);
  font-weight: 700;
}

.profile-avatar-img {
  object-fit: cover;
  background: none;
}

.profile-avatar-status {
  position: absolute;
  right: var(--sp-2);
  bottom: var(--sp-2);
  width: var(--sp-24);
  height: var(--sp-24);
  border-radius: 50%;
  border: var(--sp-4) solid #FFFFFF;
}

.profile-avatar-status.status-online {
  background: #4ADE80;
}

.profile-avatar-status.status-busy {
  background: #F9A825;
}

.profile-avatar-status.status-out {
  background: #F9A825;
}

.profile-avatar-status.status-offline {
  background: var(--text-muted);
}

.profile-user-main {
  flex: 1;
}

.profile-name {
  font-size: var(--fs-38);
  font-weight: 600;
}

.profile-role {
  margin-top: var(--sp-8);
  font-size: var(--fs-28);
  opacity: 0.76;
}

.profile-tags {
  display: flex;
  gap: var(--sp-12);
  margin-top: var(--sp-14);
}

.profile-tag {
  padding: var(--sp-8) var(--sp-16);
  border-radius: var(--sp-999);
  background: rgba(255, 255, 255, 0.18);
  font-size: var(--fs-26);
}


.profile-arrow {
  font-size: var(--fs-40);
  opacity: 0.64;
}

.profile-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-16);
  margin-top: var(--sp-28);
}

.profile-stat-item {
  padding: var(--sp-20) var(--sp-16);
  border-radius: var(--sp-24);
  background: rgba(255, 255, 255, 0.14);
  text-align: center;
}

.profile-stat-icon {
  font-size: var(--fs-28);
}

.profile-stat-value {
  margin-top: var(--sp-10);
  font-size: var(--fs-28);
  font-weight: 700;
}

.profile-stat-label {
  margin-top: var(--sp-6);
  font-size: var(--fs-22);
  opacity: 0.7;
}

.profile-reward-card {
  border-radius: var(--sp-32);
  padding: var(--sp-24);
  background: linear-gradient(135deg, #FF9800 0%, #FF5722 100%);
  box-shadow: 0 var(--sp-16) var(--sp-34) rgba(255, 152, 0, 0.22);
  display: flex;
  align-items: center;
  gap: var(--sp-18);
}

.profile-reward-icon {
  width: var(--sp-80);
  height: var(--sp-80);
  border-radius: var(--sp-24);
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-34);
}

.profile-reward-main {
  flex: 1;
  color: #FFFFFF;
}

.profile-reward-title {
  font-size: var(--fs-26);
  font-weight: 600;
}

.profile-reward-sub {
  margin-top: var(--sp-8);
  font-size: var(--fs-24);
  opacity: 0.8;
}

.profile-reward-btn {
  min-width: var(--sp-92);
  height: var(--sp-56);
  border-radius: var(--sp-999);
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-24);
}

.profile-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-18);
  margin-top: var(--sp-24);
}

.profile-info-card,
.profile-menu-card,
.profile-company-card,
.profile-logout-btn {
  padding: var(--sp-24);
}

.profile-info-top,
.profile-company-head,
.profile-menu-item {
  display: flex;
  align-items: center;
}

.profile-info-icon,
.profile-company-logo,
.profile-menu-icon {
  width: var(--sp-64);
  height: var(--sp-64);
  border-radius: var(--sp-20);
  background: var(--bg-soft);
  color: #2563EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-30);
}

.profile-info-title,
.profile-menu-label,
.profile-company-name{
  margin-left: var(--sp-16);
  font-size: var(--fs-32);
  color: var(--text-primary);
  font-weight: 500;
}

.profile-company-row:not(:last-child) {
  margin-bottom: var(--sp-8);
}

.profile-info-value {
  margin-top: var(--sp-18);
  font-size: var(--fs-40);
  font-weight: 700;
}

.profile-info-desc,
.profile-group-title,
.profile-company-label {
  font-size: var(--fs-30);
  color: var(--text-muted);
}

.profile-company-address {
  font-size: var(--fs-30);
  color: var(--text-primary);
  font-weight: 400;
}

.profile-info-desc {
  margin-top: var(--sp-8);
}

.profile-group {
  margin-top: var(--sp-24);
}

.profile-group-title {
  margin-bottom: var(--sp-14);
  padding-left: var(--sp-6);
}

.profile-menu-item + .profile-menu-item {
  border-top: var(--sp-1) solid rgba(37, 99, 235, 0.1);
  margin-top: var(--sp-18);
  padding-top: var(--sp-18);
}

.profile-menu-label {
  flex: 1;
}

.profile-menu-badge {
  color: #2563EB;
  font-size: var(--fs-22);
}
.fontsize-stepper-control {
  display: flex;
  align-items: center;
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-12);
  overflow: hidden;
  background: var(--bg-card);
}

.fontsize-stepper-btn {
  width: var(--sp-64);
  height: var(--sp-60);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-36);
  color: #2563EB;
  background: var(--bg-soft-2);
  transition: background 0.2s;
}

.fontsize-stepper-btn:active {
  background: var(--bg-soft);
}

.fontsize-stepper-value {
  width: var(--sp-100);
  height: var(--sp-60);
  text-align: center;
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
  border-left: var(--sp-2) solid var(--border-soft);
  border-right: var(--sp-2) solid var(--border-soft);
}


.profile-menu-arrow {
  margin-left: var(--sp-12);
  font-size: var(--fs-34);
  color: var(--text-muted);
}

.profile-company-card {
  margin-top: var(--sp-24);
}

.profile-company-address {
  margin-left: var(--sp-16);
  margin-top: var(--sp-8);
}

.profile-company-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-16);
  margin-top: var(--sp-24);
  padding-top: var(--sp-24);
  border-top: var(--sp-1) solid rgba(37, 99, 235, 0.1);
}

.profile-company-value {
  margin-top: var(--sp-8);
  font-size: var(--fs-30);
  color: var(--text-primary);
}

.profile-logout-btn {
  margin-top: var(--sp-24);
  text-align: center;
  font-size: var(--fs-30);
  font-weight: 600;
  color: #EF4444;
}

.profile-contact-btn {
  padding: var(--sp-24);
  text-align: center;
  font-size: var(--fs-30);
  font-weight: 600;
  border: none;
  line-height: inherit;
  color: green;
  box-shadow: none;
}

.profile-contact-btn::after {
  border: none;
}

/* 按钮点击动效 */
.profile-logout-btn,
.profile-contact-btn {
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.profile-btn-active {
  transform: scale(0.95);
  opacity: 0.7;
}

.profile-version {
  margin: var(--sp-24) 0 var(--sp-20);
  text-align: center;
  font-size: var(--fs-26);
  letter-spacing: var(--sp-2);
  color: var(--text-muted);
}
