page {
  background: var(--bg-page);
}

.auth-input-shell.is-disabled {
  background: var(--bg-soft-2);
  opacity: 0.8;
}

.auth-input-shell.is-disabled input {
  color: var(--text-tertiary);
}

.auth-segment.is-disabled .auth-segment-item {
  opacity: 0.8;
  pointer-events: none;
}

.auth-field-hint {
  margin-top: 8rpx;
  font-size: var(--fs-26);
  color: var(--text-tertiary);
  padding-left: 4rpx;
}

/* 退回说明 */
.edit-profile-review-banner {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--danger-soft-bg);
  color: var(--danger-text);
}

.edit-profile-review-title {
  font-size: var(--fs-24);
  font-weight: 600;
}

.edit-profile-review-text {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.7;
}
