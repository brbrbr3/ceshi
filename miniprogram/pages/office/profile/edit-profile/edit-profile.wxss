page {
  background: var(--bg-page);
}

.auth-input-shell.is-disabled {
  background: var(--bg-soft-2);
  opacity: 0.8;
}

.auth-input-shell.is-disabled input {
  color: var(--text-tertiary);
}

.auth-segment.is-disabled .auth-segment-item {
  opacity: 0.8;
  pointer-events: none;
}

.auth-field-hint {
  margin-top: var(--sp-8);
  font-size: var(--fs-26);
  color: var(--text-tertiary);
  padding-left: var(--sp-4);
}

/* 退回说明 */
.edit-profile-review-banner {
  margin-top: var(--sp-20);
  padding: var(--sp-22) var(--sp-24);
  border-radius: var(--sp-24);
  background: var(--danger-soft-bg);
  color: var(--danger-text);
}

.edit-profile-review-title {
  font-size: var(--fs-24);
  font-weight: 600;
}

.edit-profile-review-text {
  margin-top: var(--sp-10);
  font-size: var(--fs-24);
  line-height: 1.7;
}
