/* 兴趣班备案页面样式 */

.ic-page {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ========== 头部 ========== */
.ic-header {
  padding: var(--sp-40) var(--sp-32) var(--sp-36);
  padding-top: calc(var(--sp-40) + env(safe-area-inset-top));
}

.ic-header-content {
  color: #FFFFFF;
}

.ic-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ic-header-title {
  font-size: var(--fs-44);
  font-weight: 600;
  letter-spacing: var(--sp-2);
}

.ic-header-add {
  display: flex;
  align-items: center;
  gap: var(--sp-6);
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(var(--sp-8));
  padding: var(--sp-12) var(--sp-24);
  border-radius: var(--sp-40);
  transition: all 0.2s ease;
}

.ic-header-add:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.96);
}

.ic-header-add-icon {
  font-size: var(--fs-32);
  font-weight: 600;
}

.ic-header-add-text {
  font-size: var(--fs-26);
  font-weight: 500;
}

.ic-header-scope {
  font-size: var(--fs-26);
  opacity: 0.9;
}

/* ========== 搜索栏 ========== */
.ic-search-bar {
  padding: var(--sp-20) var(--sp-24) 0;
}

.ic-search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--sp-40);
  padding: 0 var(--sp-24);
  height: var(--sp-72);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0, 0, 0, 0.04);
}

.ic-search-icon {
  font-size: var(--fs-28);
  margin-right: var(--sp-12);
  opacity: 0.6;
}

.ic-search-input {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.ic-search-placeholder {
  color: var(--text-muted);
}

.ic-search-clear {
  font-size: var(--fs-36);
  color: var(--text-muted);
  padding: 0 var(--sp-8);
  line-height: 1;
}

/* ========== 状态筛选 ========== */
.ic-filter-bar {
  display: flex;
  gap: var(--sp-16);
  padding: var(--sp-20) var(--sp-24) 0;
}

.ic-filter-item {
  padding: var(--sp-10) var(--sp-28);
  border-radius: var(--sp-30);
  font-size: var(--fs-28);
  color: #64748B;
  background: var(--bg-card);
  transition: all 0.2s ease;
}

.ic-filter-item.is-active {
  background: #2563EB;
  color: #FFFFFF;
  font-weight: 500;
}

/* ========== 搜索无结果 ========== */
.ic-empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-80) 0;
}

.ic-empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ========== 空状态（暂无备案） ========== */
.ic-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-120) 0 var(--sp-80);
}

.ic-empty-icon {
  font-size: var(--sp-96);
  line-height: 1.2;
}

.ic-empty-title {
  font-size: var(--fs-32);
  color: var(--text-primary);
  font-weight: 500;
  margin-top: var(--sp-24);
}

.ic-empty-desc {
  font-size: var(--fs-26);
  color: var(--text-muted);
  margin-top: var(--sp-12);
}

/* ========== 首次加载动画 ========== */
.ic-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-120) 0;
}

.ic-loading-spinner {
  width: var(--sp-56);
  height: var(--sp-56);
  border: var(--sp-4) solid #E2E8F0;
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: ic-spin 0.8s linear infinite;
}

@keyframes ic-spin {
  to { transform: rotate(360deg); }
}

.ic-loading-text {
  margin-top: var(--sp-20);
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ========== 加载更多 / 没有更多（列表底部） ========== */
.ic-load-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-40) 0;
}

.ic-load-more .ic-loading-spinner {
  width: var(--sp-40);
  height: var(--sp-40);
  border-width: var(--sp-3);
}

.ic-no-more-text {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

/* ========== 列表 ========== */
.ic-list-section {
  padding: var(--sp-20) var(--sp-24) var(--sp-120);
}

.ic-card {
  background: var(--bg-card);
  border-radius: var(--sp-24);
  padding: var(--sp-28);
  margin-bottom: var(--sp-20);
  box-shadow: 0 var(--sp-4) var(--sp-16) rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.ic-card:active {
  transform: scale(0.99);
}

.ic-card.is-ended {
  opacity: 0.65;
  background: var(--bg-input);
}

.ic-card-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-16);
  gap: var(--sp-12);
}

.ic-card-name {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.ic-card-role-tag {
  font-size: var(--fs-26);
  color: #64748B;
  background: var(--bg-soft-2);
  padding: var(--sp-4) var(--sp-14);
  border-radius: var(--sp-8);
}

.ic-card-status {
  margin-left: auto;
  font-size: var(--fs-24);
  padding: var(--sp-6) var(--sp-18);
  border-radius: var(--sp-20);
  font-weight: 500;
}

.ic-card-status.is-active {
  background: #DCFCE7;
  color: #16A34A;
}

.ic-card-status.is-ended {
  background: var(--bg-soft-2);
  color: var(--text-muted);
}

.ic-card-body {
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
}

.ic-card-classname {
  font-size: var(--fs-30);
  font-weight: 600;
  color: #2563EB;
  line-height: 1.4;
}

.ic-card-meta {
  display: flex;
  gap: var(--sp-32);
  flex-wrap: wrap;
}

.ic-card-meta-item {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.ic-card-meta-label {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.ic-card-meta-value {
  font-size: var(--fs-30);
  color: var(--text-secondary);
}

.ic-card-extra {
  font-size: var(--fs-28);
  color: #64748B;
  line-height: 1.5;
}

.ic-card-extra-label {
  color: var(--text-muted);
}

.ic-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-20);
  padding-top: var(--sp-20);
  border-top: var(--sp-1) solid var(--bg-soft-2);
}

.ic-card-time {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.ic-card-actions {
  display: flex;
  gap: var(--sp-16);
}

.ic-card-btn {
  font-size: var(--fs-24);
  padding: var(--sp-10) var(--sp-24);
  border-radius: var(--sp-30);
  font-weight: 500;
  transition: all 0.2s ease;
}

.ic-card-btn:active {
  transform: scale(0.95);
}

.ic-card-btn-edit {
  background: var(--bg-soft);
  color: #2563EB;
}

.ic-card-btn-end {
  background: var(--hint-warn-bg);
  color: var(--hint-warn-text);
}

/* ========== 弹窗 ========== */
.ic-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
}

.ic-popup-mask.is-visible {
  opacity: 1;
  visibility: visible;
  animation: icFadeIn 0.2s ease;
}

.ic-popup-mask.is-closing {
  animation: icFadeOut 0.25s ease forwards;
}

.ic-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  max-height: 85vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  margin: 0 var(--sp-24) 0;
  transform: translateY(100%);
}

.ic-popup-mask.is-visible .ic-popup-container {
  transform: translateY(0);
  animation: icSlideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.ic-popup-mask.is-closing .ic-popup-container {
  animation: icSlideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

.ic-popup-container-detail {
  height: 80vh;
}

.ic-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-32);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  flex-shrink: 0;
}

.ic-popup-title {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.ic-popup-close {
  font-size: var(--fs-48);
  color: var(--text-muted);
  line-height: 1;
  padding: 0 var(--sp-8);
}

.ic-popup-body {
  flex: 1;
  max-height: 80vh;
  overflow: hidden;
}

/* 编辑提示 */
.ic-edit-tip {
  background: var(--hint-warn-bg);
  color: var(--hint-warn-text);
  font-size: var(--fs-26);
  padding: var(--sp-20) var(--sp-32);
  text-align: center;
  font-weight: 500;
}

/* ========== 表单 ========== */
.ic-popup-form {
  padding: var(--sp-28) var(--sp-32);
  padding-bottom: var(--sp-90);
}

.ic-form-section {
  margin-bottom: var(--sp-32);
}

.ic-form-section-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #2563EB;
  margin-bottom: var(--sp-20);
  padding-left: var(--sp-16);
  border-left: var(--sp-6) solid #2563EB;
}

.ic-field {
  margin-bottom: var(--sp-24);
}

.ic-field-label {
  font-size: var(--fs-30);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: var(--sp-12);
}

.ic-required {
  color: #DC2626;
}

.ic-input-wrapper {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: 0 var(--sp-24);
  height: var(--sp-88);
  display: flex;
  align-items: center;
  border: var(--sp-1) solid var(--border-soft);
  transition: border-color 0.2s ease;
}

.ic-input-wrapper:focus-within {
  border-color: #2563EB;
}

.ic-input {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.ic-input-placeholder {
  color: var(--text-muted);
}

/* 教学模式快捷标签 */
.ic-quick-tags {
  display: flex;
  gap: var(--sp-16);
  margin-top: var(--sp-16);
}

.ic-quick-tag {
  padding: var(--sp-12) var(--sp-28);
  border-radius: var(--sp-30);
  font-size: var(--fs-26);
  color: var(--text-secondary);
  background: var(--bg-soft-2);
  transition: all 0.2s ease;
}

.ic-quick-tag.is-selected {
  background: #2563EB;
  color: #FFFFFF;
  font-weight: 500;
}

.ic-quick-tag:active {
  transform: scale(0.95);
}

/* 提交按钮 */
.ic-submit-btn {
  width: 100%;
  height: var(--sp-96);
  border-radius: var(--sp-20);
  font-size: var(--fs-32);
  font-weight: 600;
  background: linear-gradient(135deg, #2563EB 0%, #4F46E5 100%);
  color: #FFFFFF;
  border: none;
  margin-top: var(--sp-16);
  box-shadow: 0 var(--sp-8) var(--sp-24) rgba(37, 99, 235, 0.3);
  transition: all 0.2s ease;
}

.ic-submit-btn:active {
  transform: scale(0.98);
}

.ic-submit-btn[disabled] {
  background: var(--text-muted);
  box-shadow: none;
}

/* ========== 详情弹窗 ========== */
.ic-detail-content {
  padding: var(--sp-32);
  padding-bottom: calc(var(--sp-40) + env(safe-area-inset-bottom));
}

.ic-detail-status-row {
  margin-bottom: var(--sp-20);
}

.ic-detail-status {
  display: inline-block;
  font-size: var(--fs-26);
  padding: var(--sp-8) var(--sp-24);
  border-radius: var(--sp-20);
  font-weight: 500;
}

.ic-detail-status.is-active {
  background: #DCFCE7;
  color: #16A34A;
}

.ic-detail-status.is-ended {
  background: var(--bg-soft-2);
  color: var(--text-muted);
}

.ic-detail-name {
  font-size: var(--fs-40);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-8);
}

.ic-detail-classname {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #2563EB;
  margin-bottom: var(--sp-32);
}

.ic-detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-24);
  margin-bottom: var(--sp-32);
}

.ic-detail-item {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: var(--sp-20);
}

.ic-detail-item-label {
  font-size: var(--fs-28);
  color: var(--text-muted);
  margin-bottom: var(--sp-8);
}

.ic-detail-item-value {
  font-size: var(--fs-30);
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
}

.ic-detail-info {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: var(--sp-24);
}

.ic-detail-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--sp-12) 0;
  border-bottom: var(--sp-1) solid #E2E8F0;
}

.ic-detail-info-row:last-child {
  border-bottom: none;
}

.ic-detail-info-label {
  font-size: var(--fs-30);
  color: var(--text-muted);
}

.ic-detail-info-value {
  font-size: var(--fs-30);
  color: var(--text-secondary);
  font-weight: 500;
}

/* ========== 动画关键帧 ========== */
@keyframes icFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes icFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes icSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes icSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}
