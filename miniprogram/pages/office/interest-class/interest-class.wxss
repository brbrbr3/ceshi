/* 兴趣班备案页面样式 */

.ic-page {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ========== 头部 ========== */
.ic-header {
  padding: 40rpx 32rpx 36rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
}

.ic-header-content {
  color: #FFFFFF;
}

.ic-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ic-header-title {
  font-size: var(--fs-44);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.ic-header-add {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(8rpx);
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  transition: all 0.2s ease;
}

.ic-header-add:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.96);
}

.ic-header-add-icon {
  font-size: var(--fs-32);
  font-weight: 600;
}

.ic-header-add-text {
  font-size: var(--fs-26);
  font-weight: 500;
}

.ic-header-scope {
  font-size: var(--fs-26);
  opacity: 0.9;
}

/* ========== 搜索栏 ========== */
.ic-search-bar {
  padding: 20rpx 24rpx 0;
}

.ic-search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.ic-search-icon {
  font-size: var(--fs-28);
  margin-right: 12rpx;
  opacity: 0.6;
}

.ic-search-input {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.ic-search-placeholder {
  color: var(--text-muted);
}

.ic-search-clear {
  font-size: var(--fs-36);
  color: var(--text-muted);
  padding: 0 8rpx;
  line-height: 1;
}

/* ========== 状态筛选 ========== */
.ic-filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
}

.ic-filter-item {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: var(--fs-28);
  color: #64748B;
  background: var(--bg-card);
  transition: all 0.2s ease;
}

.ic-filter-item.is-active {
  background: #2563EB;
  color: #FFFFFF;
  font-weight: 500;
}

/* ========== 搜索无结果 ========== */
.ic-empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.ic-empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ========== 空状态（暂无备案） ========== */
.ic-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0 80rpx;
}

.ic-empty-icon {
  font-size: 96rpx;
  line-height: 1.2;
}

.ic-empty-title {
  font-size: var(--fs-32);
  color: var(--text-primary);
  font-weight: 500;
  margin-top: 24rpx;
}

.ic-empty-desc {
  font-size: var(--fs-26);
  color: var(--text-muted);
  margin-top: 12rpx;
}

/* ========== 首次加载动画 ========== */
.ic-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.ic-loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #E2E8F0;
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: ic-spin 0.8s linear infinite;
}

@keyframes ic-spin {
  to { transform: rotate(360deg); }
}

.ic-loading-text {
  margin-top: 20rpx;
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ========== 加载更多 / 没有更多（列表底部） ========== */
.ic-load-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.ic-load-more .ic-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border-width: 3rpx;
}

.ic-no-more-text {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

/* ========== 列表 ========== */
.ic-list-section {
  padding: 20rpx 24rpx 120rpx;
}

.ic-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.ic-card:active {
  transform: scale(0.99);
}

.ic-card.is-ended {
  opacity: 0.65;
  background: var(--bg-input);
}

.ic-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.ic-card-name {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.ic-card-role-tag {
  font-size: var(--fs-26);
  color: #64748B;
  background: var(--bg-soft-2);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.ic-card-status {
  margin-left: auto;
  font-size: var(--fs-24);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.ic-card-status.is-active {
  background: #DCFCE7;
  color: #16A34A;
}

.ic-card-status.is-ended {
  background: var(--bg-soft-2);
  color: var(--text-muted);
}

.ic-card-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ic-card-classname {
  font-size: var(--fs-30);
  font-weight: 600;
  color: #2563EB;
  line-height: 1.4;
}

.ic-card-meta {
  display: flex;
  gap: 32rpx;
  flex-wrap: wrap;
}

.ic-card-meta-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ic-card-meta-label {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.ic-card-meta-value {
  font-size: var(--fs-30);
  color: var(--text-secondary);
}

.ic-card-extra {
  font-size: var(--fs-28);
  color: #64748B;
  line-height: 1.5;
}

.ic-card-extra-label {
  color: var(--text-muted);
}

.ic-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--bg-soft-2);
}

.ic-card-time {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.ic-card-actions {
  display: flex;
  gap: 16rpx;
}

.ic-card-btn {
  font-size: var(--fs-24);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.ic-card-btn:active {
  transform: scale(0.95);
}

.ic-card-btn-edit {
  background: var(--bg-soft);
  color: #2563EB;
}

.ic-card-btn-end {
  background: #FEF3C7;
  color: #D97706;
}

/* ========== 弹窗 ========== */
.ic-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
}

.ic-popup-mask.is-visible {
  opacity: 1;
  visibility: visible;
  animation: icFadeIn 0.2s ease;
}

.ic-popup-mask.is-closing {
  animation: icFadeOut 0.25s ease forwards;
}

.ic-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  margin: 0 24rpx 0;
  transform: translateY(100%);
}

.ic-popup-mask.is-visible .ic-popup-container {
  transform: translateY(0);
  animation: icSlideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.ic-popup-mask.is-closing .ic-popup-container {
  animation: icSlideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

.ic-popup-container-detail {
  height: 80vh;
}

.ic-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--bg-soft-2);
  flex-shrink: 0;
}

.ic-popup-title {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.ic-popup-close {
  font-size: var(--fs-48);
  color: var(--text-muted);
  line-height: 1;
  padding: 0 8rpx;
}

.ic-popup-body {
  flex: 1;
  max-height: 80vh;
  overflow: hidden;
}

/* 编辑提示 */
.ic-edit-tip {
  background: #FEF3C7;
  color: #92400E;
  font-size: var(--fs-26);
  padding: 20rpx 32rpx;
  text-align: center;
  font-weight: 500;
}

/* ========== 表单 ========== */
.ic-popup-form {
  padding: 28rpx 32rpx;
  padding-bottom: 90rpx;
}

.ic-form-section {
  margin-bottom: 32rpx;
}

.ic-form-section-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #2563EB;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #2563EB;
}

.ic-field {
  margin-bottom: 24rpx;
}

.ic-field-label {
  font-size: var(--fs-30);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.ic-required {
  color: #DC2626;
}

.ic-input-wrapper {
  background: var(--bg-input);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #E2E8F0;
  transition: border-color 0.2s ease;
}

.ic-input-wrapper:focus-within {
  border-color: #2563EB;
}

.ic-input {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.ic-input-placeholder {
  color: var(--text-muted);
}

/* 教学模式快捷标签 */
.ic-quick-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.ic-quick-tag {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: var(--fs-26);
  color: var(--text-secondary);
  background: var(--bg-soft-2);
  transition: all 0.2s ease;
}

.ic-quick-tag.is-selected {
  background: #2563EB;
  color: #FFFFFF;
  font-weight: 500;
}

.ic-quick-tag:active {
  transform: scale(0.95);
}

/* 提交按钮 */
.ic-submit-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: var(--fs-32);
  font-weight: 600;
  background: linear-gradient(135deg, #2563EB 0%, #4F46E5 100%);
  color: #FFFFFF;
  border: none;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.3);
  transition: all 0.2s ease;
}

.ic-submit-btn:active {
  transform: scale(0.98);
}

.ic-submit-btn[disabled] {
  background: var(--text-muted);
  box-shadow: none;
}

/* ========== 详情弹窗 ========== */
.ic-detail-content {
  padding: 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.ic-detail-status-row {
  margin-bottom: 20rpx;
}

.ic-detail-status {
  display: inline-block;
  font-size: var(--fs-26);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.ic-detail-status.is-active {
  background: #DCFCE7;
  color: #16A34A;
}

.ic-detail-status.is-ended {
  background: var(--bg-soft-2);
  color: var(--text-muted);
}

.ic-detail-name {
  font-size: var(--fs-40);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.ic-detail-classname {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #2563EB;
  margin-bottom: 32rpx;
}

.ic-detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.ic-detail-item {
  background: var(--bg-input);
  border-radius: 16rpx;
  padding: 20rpx;
}

.ic-detail-item-label {
  font-size: var(--fs-28);
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.ic-detail-item-value {
  font-size: var(--fs-30);
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
}

.ic-detail-info {
  background: var(--bg-input);
  border-radius: 16rpx;
  padding: 24rpx;
}

.ic-detail-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #E2E8F0;
}

.ic-detail-info-row:last-child {
  border-bottom: none;
}

.ic-detail-info-label {
  font-size: var(--fs-30);
  color: var(--text-muted);
}

.ic-detail-info-value {
  font-size: var(--fs-30);
  color: var(--text-secondary);
  font-weight: 500;
}

/* ========== 动画关键帧 ========== */
@keyframes icFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes icFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes icSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes icSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}
