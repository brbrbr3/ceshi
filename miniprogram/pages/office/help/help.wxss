/* pages/office/help/help.wxss */

.feedback-container {
  min-height: 100vh;
}





/* 内容区域 */
.feedback-content {
  padding: var(--sp-20) var(--sp-30) var(--sp-40);
}

/* 功能分类区块 */
.help-section {
  margin-bottom: var(--sp-40);
}

.section-title {
  font-size: var(--fs-38);
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: var(--sp-24);
  padding-left: var(--sp-10);
  border-left: var(--sp-6) solid #667eea;
}

/* 功能卡片 */
.help-card {
  background: var(--bg-card);
  border-radius: var(--sp-16);
  padding: var(--sp-32);
  margin-bottom: var(--sp-24);
  box-shadow: 0 var(--sp-4) var(--sp-12) rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-24);
}

.card-icon {
  font-size: var(--fs-48);
  margin-right: var(--sp-20);
}

.card-title {
  font-size: var(--fs-35);
  font-weight: bold;
  color: var(--text-primary);
  flex: 1;
}

.card-content {
}

.card-desc {
  font-size: var(--fs-32);
  color: var(--text-secondary);
  line-height: var(--sp-44);
  margin-bottom: var(--sp-20);
}

.card-features {
  margin-bottom: var(--sp-20);
}

.feature-item {
  font-size: var(--fs-30);
  color: var(--text-secondary);
  line-height: var(--sp-40);
  margin-bottom: var(--sp-8);
}

.card-permission {
  display: flex;
  align-items: flex-start;
  padding: var(--sp-16) var(--sp-20);
  background: var(--bg-soft-2);
  border-radius: var(--sp-12);
  border-left: var(--sp-4) solid #667eea;
}

.permission-label {
  font-size: var(--fs-30);
  color: var(--text-muted);
  margin-right: var(--sp-8);
  flex-shrink: 0;
}

.permission-value {
  font-size: var(--fs-30);
  color: #667eea;
  font-weight: 500;
}

/* 权限说明提示 */
.permission-tips {
  background: var(--bg-card);
  border-radius: var(--sp-16);
  padding: var(--sp-32);
  box-shadow: 0 var(--sp-4) var(--sp-12) rgba(0, 0, 0, 0.08);
}

.tips-item {
  display: flex;
  margin-bottom: var(--sp-32);
}

.tips-item:last-child {
  margin-bottom: 0;
}

.tips-icon {
  font-size: var(--fs-40);
  margin-right: var(--sp-20);
  flex-shrink: 0;
}

.tips-content {
  flex: 1;
}

.tips-title {
  font-size: var(--fs-32);
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: var(--sp-12);
}

.tips-desc {
  font-size: var(--fs-30);
  color: var(--text-secondary);
  line-height: var(--sp-40);
}


/* 底部提示 */
.help-footer {
  text-align: left;
}

.footer-text {
  font-size: var(--fs-30);
  padding: 0 0 var(--sp-60);
  color: var(--text-secondary);
}
