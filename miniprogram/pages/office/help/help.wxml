<page-meta page-style="{{pageStyle}}" />
<view class="feedback-container {{themeClass}}" style="{{fontStyle}}">
  <!-- 头部区域 -->
  <view class="office-gradient-header office-subpage-header">
    <view class="office-subpage-header-content">
      <view class="office-subpage-title">帮助中心</view>
      <view class="office-subpage-subtitle">小程序各功能模块简介</view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view wx:if="{{!isReviewer}}" class="feedback-content">

    <!-- ========== 首页 ========== -->
    <view class="help-section">
      <view class="section-title">首页</view>


      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">🗓️</view>
          <view class="card-title">全馆日历</view>
        </view>
        <view class="card-content">
          <view class="card-desc">以日历视图展示{{(isReviewer ? '法定节假日' : '馆定节假日和巴西节假日')}}安排</view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">所有用户可查看。</view>
          </view>
        </view>
      </view>


      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">🛴</view>
          <view class="card-title">外出报备</view>
        </view>
        <view class="card-content">
          <view class="card-desc">报备外出和返回：</view>
          <view class="card-features">
          <view class="feature-item">• 出行时可自动为同行人代报备（同行人需为本系统注册用户），返回时可为同行人报备返回。</view>
          <view class="feature-item">• 报备后5分钟内可撤回，可为进行中的外出追加目的地。</view>
          <view class="feature-item">• 当日超23时未归计为超时，将对超时用户推送消息提醒。</view>
          </view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">所有用户可使用。</view>
          </view>
        </view>
      </view>

      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">🛹</view>
          <view class="card-title">兴趣班备案</view>
        </view>
        <view class="card-content">
          <view class="card-desc">登记当前参与的兴趣班信息，便于馆内备案备查。支持以下功能：</view>
          <view class="card-features">
            <view class="feature-item">• 新增备案：填写参与人姓名、兴趣班名称、时段、教学模式、陪同人、备注等。</view>
            <view class="feature-item">• 编辑备案：编辑会结束原备案记录，并新增一条新的备案记录。</view>
            <view class="feature-item">• 结束兴趣班：将备案标记为"已结束"，记录保留不删除。</view>
            <view class="feature-item">• 每月提醒：每月月初提醒全体用户更新备案。</view>
          </view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">领导、部门负责人可查看管辖范围人员生效中的备案；其他用户仅可查看自己的备案（含已结束）。</view>
          </view>
        </view>
      </view>

      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">🍽️</view>
          <view class="card-title">每周菜单</view>
        </view>
        <view class="card-content">
          <view class="card-desc">查看每周工作餐菜单安排。</view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">所有用户可查看菜单并打分、评论，仅厨师、部分特定岗位人员可发布、编辑、删除菜单。</view>
          </view>
        </view>
      </view>

      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">💈</view>
          <view class="card-title">理发预约</view>
        </view>
        <view class="card-content">
          <view class="card-desc">在线预约理发服务，支持以下功能：</view>
          <view class="card-features">
            <view class="feature-item">• 预约理发：选择日期和时段进行预约，支持为他人代约。招待员可进行理发日更换、时段管理。</view>
            <view class="feature-item">• 理发统计：按月统计每人理发次数。</view>
            <view class="feature-item">• 我的预约：查看历史预约记录。</view>
          </view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">所有用户可预约。招待员及部分特定岗位人员可查看理发统计。</view>
          </view>
        </view>
      </view>


      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">ℹ️</view>
          <view class="card-title">生活资讯</view>
        </view>
        <view class="card-content">
          <view class="card-desc">{{(isReviewer ? '' : '巴西利亚')}}当地生活参考信息</view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">全体用户可查看。</view>
          </view>
        </view>
      </view>

      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">📋</view>
          <view class="card-title">审批中心</view>
        </view>
        <view class="card-content">
          <view class="card-desc">查看和审批小程序用户提交的各类申请。</view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">当前仅限管理员使用。</view>
          </view>
        </view>
      </view>

      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">📢</view>
          <view class="card-title">馆内动态</view>
        </view>
        <view class="card-content">
          <view class="card-desc">发布公告、副食订购、活动报名、问卷、答题等各类信息，供用户查看、填报。</view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">馆员和获授权人员可发布。</view>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== 审批中心 ========== -->
    <view class="help-section">
      <view class="section-title">出行数据板</view>


      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">📊</view>
          <view class="card-title">出行数据板</view>
        </view>
        <view class="card-content">
          <view class="card-desc">可查看当前人员外出情况，查看个人外出历史记录。</view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">领导，部门负责人、报备接收人、居住区片长可查看管辖范围人员出行情况。</view>
          </view>
        </view>
      </view>

    </view>


    <!-- ========== 我的 ========== -->
    <view class="help-section">
      <view class="section-title">我的</view>

      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">🔔</view>
          <view class="card-title">消息中心</view>
        </view>
        <view class="card-content">
          <view class="card-desc">接收系统消息提醒，包括审批状态变更通知、菜单更新通知等。支持标记已读和清除功能。</view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">无限制，所有用户可查看。</view>
          </view>
        </view>
      </view>

      <view class="help-card">
        <view class="card-header">
          <view class="card-icon">👤</view>
          <view class="card-title">修改个人信息</view>
        </view>
        <view class="card-content">
          <view class="card-desc">查看和修改个人信息。个人信息修改后需管理员审批方可生效。</view>
          <view class="card-permission">
            <view class="permission-label">权限要求：</view>
            <view class="permission-value">无限制，所有用户可用。</view>
          </view>
        </view>
      </view>


    </view>

    <!-- 权限说明 -->
    <view class="help-section">
      <view class="section-title">权限说明</view>

      <view class="permission-tips">
        <view class="tips-item">
          <view class="tips-icon">❓</view>
          <view class="tips-content">
            <view class="tips-title">如何获取权限？</view>
            <view class="tips-desc">部分功能需要特定角色或岗位才有权使用。</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="help-footer">
      <view class="footer-text">如有疑问，请在"我的"页点击"联系管理员"。</view>
    </view>

  </view>
  <view wx:else class="feedback-content">
    <view class="help-section">
      <view class="section-title">暂无数据</view>
    </view>
  </view>
</view>