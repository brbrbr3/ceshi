/* 全屏背景 */
.arrival-guide-page {
  position: relative;
}

/* fixed 背景层：固定在视口，滚动不露底 */
.arrival-guide-page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #22272f 0%, #3d413f 100%);
  z-index: 0;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 130%;
  height: 130%;
  z-index: 0;
  transform: translateY(5%);
  transform: translateX(-7%);
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.custom-nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 var(--sp-24);
  position: relative;
}

.nav-back {
  width: var(--sp-60);
  height: var(--sp-60);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sp-52);
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: var(--fs-30);
  font-weight: 400;
  color: #ffffff;
  letter-spacing: var(--sp-2);
}

/* 删除 .nav-placeholder */

/* 页面内容 */
.guide-content {
  position: relative;
  z-index: 1;
  padding: var(--sp-40) var(--sp-40) var(--sp-60);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 欢迎文字 */
.welcome-text {
  text-align: center;
  margin-bottom: var(--sp-10);
  padding-top: var(--sp-10);
}

.welcome-title {
  font-size: var(--fs-45);
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 var(--sp-2) var(--sp-8) rgba(0, 0, 0, 0.3);
}

.welcome-desc {
  font-size: var(--fs-32);
  color: rgba(255, 255, 255, 0.85);
  text-shadow: 0 var(--sp-1) var(--sp-4) rgba(0, 0, 0, 0.3);
}

/* 按钮列表 */
.button-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-24);
}

/* 毛玻璃按钮 */
.guide-button {
  display: flex;
  align-items: center;
  padding: var(--sp-15) var(--sp-36);
  background: rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: var(--sp-24);
  border: var(--sp-3) solid rgba(255, 255, 255, 0.8);
  box-shadow: var(--sp-4) var(--sp-8) var(--sp-32) rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.guide-button:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.98);
}

.guide-button-icon {
  font-size: var(--fs-42);
  margin-right: var(--sp-24);
  flex-shrink: 0;
}

.guide-button-label {
  flex: 1;
  font-size: var(--fs-35);
  font-weight: 500;
  color: #ffffff;
  text-shadow: var(--sp-1) var(--sp-1) var(--sp-4) rgba(0, 0, 0, 0.2);
}

.guide-button-arrow {
  font-size: var(--fs-46);
  color: rgba(255, 255, 255);
  font-weight: 300;
  margin-left: var(--sp-12);
}

/* ========== 弹窗 ========== */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.popup-mask.is-visible {
  opacity: 1;
  visibility: visible;
}

.popup-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  max-height: 85vh;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;

}

.popup-container.is-visible {
  transform: translateY(0);
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-36) var(--sp-40) var(--sp-24);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  flex-shrink: 0;
}

.popup-title {
  font-size: var(--fs-34);
  font-weight: 700;
  color: var(--text-primary);
}

.popup-close {
  width: var(--sp-56);
  height: var(--sp-56);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-32);
  color: var(--text-muted);
  border-radius: 50%;
  background: var(--bg-soft-2);
}

.popup-body {
  flex: 1;
  max-height: 75vh;
}

.popup-body-inner {
  padding: var(--sp-16) var(--sp-40) var(--sp-90);
  box-sizing: border-box;
}

/* ========== Checklist 样式 ========== */
.checklist-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-24);
}

.checklist-progress {
  font-size: var(--fs-30);
  color: var(--text-tertiary);
}

.checklist-all {
  font-size: var(--fs-28);
  color: var(--checklist-on-text);
  font-weight: 600;
  padding: var(--sp-8) var(--sp-20);
  background: var(--bg-soft);
  border-radius: var(--sp-20);
}

.checklist-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

.checklist-item {
  display: flex;
  align-items: flex-start;
  padding: var(--sp-24);
  background: var(--bg-input);
  border-radius: var(--sp-16);
  border: var(--sp-2) solid var(--border-soft);
  transition: all 0.2s ease;
}

.checklist-item.is-checked {
  background: var(--selected-bg);
  border-color: var(--checklist-on-text);
}

.checklist-box {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: var(--sp-10);
  border: var(--sp-2) solid var(--border-soft);
  margin-right: var(--sp-20);
  display: flex;
  align-items: center;
  justify-content:center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.checklist-item.is-checked .checklist-box {
  background: #16A34A;
  border-color: #16A34A;
}

.checklist-check {
  font-size: var(--fs-24);
  color: #ffffff;
  font-weight: 700;
}

/* Checklist 卡片体（三栏：类别/具体事项/备注） */
.checklist-card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--sp-6);
}

.checklist-category {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--checklist-on-text);
}

.checklist-item.is-checked .checklist-category {
  color: var(--checklist-on-text);
}

.checklist-detail {
  font-size: var(--fs-30);
  color: var(--text-secondary);
  line-height: 1.5;
}

.checklist-item.is-checked .checklist-detail {
}

.checklist-item.is-checked .checklist-note {
  color: var(--checklist-on-text);
  opacity: 0.75;
}

.checklist-note {
  font-size: var(--fs-28);
  color: var(--text-muted);
  line-height: 1.5;
}

/* ========== 静态内容样式 ========== */
.content-section {
  margin-bottom: var(--sp-32);
}

.content-section:last-child {
  margin-bottom: 0;
}

.content-category {
  font-size: var(--fs-32);
  font-weight: 400;
  color: var(--text-primary);
  margin-bottom: var(--sp-10);
  padding-left: var(--sp-4);
  word-break: break-all;
}

.content-card {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: var(--sp-24);
  margin-bottom: var(--sp-12);
  border: var(--sp-1) solid var(--border-soft);
}

.content-card:last-child {
  margin-bottom: 0;
}

.content-card-name {
  font-size: var(--fs-30);
  font-weight: 400;
  color: var(--text-primary);
  margin-bottom: var(--sp-8);
  word-break: break-all;
}

/* 可点击链接样式 */
.content-card-link {
  color: #2563eb;
  text-decoration: underline;
}

.content-card-link:active {
  opacity: 0.7;
}

/* 可点击电话样式 */
.content-card-phone {
  color: #16a34a;
  font-weight: 500;
}

.content-card-phone:active {
  opacity: 0.7;
}

/* 可点击邮箱样式 */
.content-card-email {
  color: #7c3aed;
  font-weight: 500;
}

.content-card-email:active {
  opacity: 0.7;
}

/* 可点击地址样式 */
.content-card-address {
  color: #ea580c;
  font-weight: 500;
}

.content-card-address:active {
  opacity: 0.7;
}

.content-card-desc {
  font-size: var(--fs-28);
  color: var(--text-tertiary);
  line-height: 1.5;
  word-break: break-all;
}

/* ========== 指南下载（自定义弹窗） ========== */
.download-file-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-20);
}

.download-file-item {
  display: flex;
  align-items: center;
  gap: var(--sp-20);
  padding: var(--sp-28) var(--sp-24);
  background: var(--bg-input);
  border: var(--sp-2) solid var(--border-soft);
  border-radius: var(--sp-16);
  transition: all 0.2s ease;
}

.download-file-item:active {
  background: var(--bg-soft);
  transform: scale(0.98);
}

.download-file-icon {
  font-size: var(--fs-32);
  flex-shrink: 0;
}

.download-file-name {
  flex: 1;
  font-size: var(--fs-30);
  color: var(--text-primary);
  word-break: break-all;
}

.download-file-arrow {
  font-size: var(--fs-36);
  color: var(--text-muted);
  flex-shrink: 0;
}

