/* 理发预约页面样式 */

page {
  background: var(--bg-card);
  height: 100%;
}

.haircut-page {
  min-height: 100%;
}

/* ========== 头部 - 渐变色背景（橙色系） ========== */
.haircut-header {
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  padding: var(--sp-40) var(--sp-28) var(--sp-10);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.haircut-header-content {
  color: #FFFFFF;
}

.haircut-title {
  font-size: var(--fs-48);
  font-weight: 600;
}

.haircut-subtitle {
  font-size: var(--fs-26);
  padding-top: var(--sp-5);
  opacity: 0.9;
}

/* ========== Tab栏 ========== */
.haircut-tabs {
  background: var(--bg-card);
  display: flex;
  padding: 0 var(--sp-16);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  position: sticky;
  top: 0;
  z-index: 50;
}

.haircut-tab {
  flex: 1;
  text-align: center;
  padding: var(--sp-28) 0;
  font-size: var(--fs-32);
  color: var(--text-primary);
  font-weight: 500;
  position: relative;
  transition: all 0.3s ease;
}

.haircut-tab.is-active {
  color: #EA580C;
  font-weight: 600;
}

.haircut-tab.is-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: var(--sp-48);
  height: var(--sp-6);
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  border-radius: var(--sp-3);
}

/* ========== 内容区 ========== */
.haircut-content {
  padding: var(--sp-24);
  padding-bottom: var(--sp-100);
}

/* ========== 日期选择器（完全仿会议室样式） ========== */
.date-selector {
  background: var(--bg-card);
  padding: var(--sp-5) 0 var(--sp-5);
  margin-left: calc(var(--sp-24) * -1);
  margin-right: calc(var(--sp-24) * -1);
  border-top: var(--sp-1) solid var(--border-soft);
  border-bottom: var(--sp-1) solid var(--border-soft);
}

.date-scroll {
  width: 100%;
  white-space: nowrap;
  margin-left: var(--sp-10);
}

.date-list {
  display: inline-flex;
  padding: var(--sp-8) var(--sp-24);
  gap: var(--sp-16);
}

.date-item {
  min-width: var(--sp-130);
  padding: var(--sp-24) var(--sp-24);
  border-radius: var(--sp-24);
  background: var(--bg-soft-2);
  border: var(--sp-3) solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
  gap: var(--sp-8);
}

.date-item:active {
  transform: scale(0.95);
}

.date-item.is-active {
  border: var(--sp-3) solid #EA580C;
  background: #ea5a0c1f;
}

.date-item.is-disabled {
  opacity: 0.5;
  background: var(--bg-soft-2);
}

.date-item-left {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: var(--sp-8);
}

.date-weekday {
  font-size: var(--fs-30);
  color: var(--text-secondary);
}

.date-day {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.date-item.is-active .date-day,
.date-item.is-active .date-weekday {
  color: #EA580C;
}

/* 预约数圆圈徽章（橙色） */
.date-count-badge {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: 50%;
  background: #EA580C;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--sp-10);
  margin-bottom: var(--sp-9);
}

.date-count-badge text {
  font-size: var(--fs-26);
  color: #FFFFFF;
  font-weight: 500;
}

/* ========== 日期提示 ========== */
.haircut-date-hint {
  padding: var(--sp-20) var(--sp-24);
  background: var(--hint-warn-bg);
  border-radius: var(--sp-12);
  margin-top: var(--sp-20);
  margin-bottom: var(--sp-20);
}

.haircut-date-hint-text {
  font-size: var(--fs-28);
  color: var(--hint-warn-text);
}

/* ========== 时段列表 ========== */
.haircut-slots-section {
  margin-top: var(--sp-20);
}

.haircut-slots-title {
  font-size: var(--fs-35);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-16);
  padding-left: var(--sp-8);
}

.haircut-slots-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
}

.haircut-slot-item {
  display: flex;
  
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-24);
  background: var(--bg-card);
  border-radius: var(--sp-16);
  border: var(--sp-4) solid var(--border-soft);
  transition: all 0.3s ease;
}

.haircut-slot-item.is-selected {
  border-color: #EA580C;
  background: #ea5a0c1f;
}

.haircut-slot-item.is-booked {
  opacity: 0.8;
  background: var(--bg-soft-2);
  border-color: transparent;
}

/* 我已预约的时段：与普通时段一致，仅不显示边框 */
.haircut-slot-item.is-my-booked {
  border-color: transparent;
}

.haircut-slot-time {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
}

.haircut-slot-item.is-booked .haircut-slot-time {
  color: var(--text-muted);
}

/* 招待员视角：已被预约的时段时间与预约人姓名用正常文字色，便于核对；
   只覆盖文字色 —— 背景色、边框、以及 .is-booked 上的整体透明度都保持原样。
   选择器权重与上一条相同，靠源码顺序覆盖，因此必须写在这里之后。 */
.haircut-slot-item.is-receptionist-view .haircut-slot-time {
  color: var(--text-primary);
}

.haircut-slot-status {
  font-size: var(--fs-24);
  padding: var(--sp-6) var(--sp-16);
  border-radius: var(--sp-8);
}

.haircut-slot-status.is-available {
  background: var(--chip-green-bg);
  color: var(--chip-green-text);
}

.haircut-slot-status.is-booked {
  background: var(--chip-red-bg);
  color: var(--chip-red-text);
}

/* 我已预约 - 黄色 */
.haircut-slot-status.is-myBooked {
  background: var(--chip-amber-bg);
  color: var(--chip-amber-text);
}

/* 不可预约 - 灰色 */
.haircut-slot-status.is-unavailable {
  background: var(--bg-soft-2);
  color: #6B7280;
}

/* 时段左侧 */
.haircut-slot-left {
  display: flex;
  gap: var(--sp-4);
}


/* 时段右侧 */
.haircut-slot-right {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
}

/* 操作按钮 */
.haircut-slot-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: var(--sp-10);
  margin-left: calc(var(--sp-10) * -1);
}

.haircut-slot-action {
  width: var(--sp-54);
  height: var(--sp-54);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-40);
}

/* 设为不可预约按钮 - 红色 */
.haircut-slot-action.is-disable {
  background: #FEE2E2;
  color: #DC2626;
}

/* 恢复为可预约按钮 - 绿色 */
.haircut-slot-action.is-restore {
  background: #DCFCE7;
  color: #16A34A;
}

/* 取消按钮 - 红色 */
.haircut-slot-action.is-cancel {
  background: #FEE2E2;
  color: #DC2626;
}


.haircut-slot-item.is-selected .haircut-slot-status.is-available {
  background: #EA580C;
  color: #FFFFFF;
}



/* ========== 排序切换 ========== */
.haircut-sort-bar {
  display: flex;
  gap: var(--sp-16);
  margin-bottom: var(--sp-20);
}

.haircut-sort-btn {
  padding: var(--sp-12) var(--sp-24);
  background: var(--bg-card);
  border-radius: var(--sp-24);
  font-size: var(--fs-30);
  color: var(--text-tertiary);
  transition: all 0.3s ease;
}

.haircut-sort-btn.is-active {
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  color: #FFFFFF;
}

/* ========== 列表 ========== */
.haircut-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

/* ========== 记录卡片 ========== */
.haircut-item {
  background: var(--bg-card);
  border-radius: var(--sp-20);
  padding: var(--sp-24);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0, 0, 0, 0.04);
  border: var(--sp-4) solid var(--border-soft);
}

.haircut-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-16);
}

.haircut-item-datetime {
  display: flex;
  flex-direction: row;
  /* 日期(30rpx) 与时段(26rpx) 字号不同，靠容器居中对齐两者的垂直中心；
     align-items / justify-content 是「容器」属性，写在 .haircut-item-time 上不生效 */
  align-items: center;
}

.haircut-item-date {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.haircut-item-time {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
  margin-left: var(--sp-24);
}

.haircut-item-status {
  font-size: var(--fs-24);
  padding: var(--sp-6) var(--sp-16);
  border-radius: var(--sp-8);
  font-weight: 400;
}

/* 已预约 状态 */
.haircut-item-status.is-booked {
  background: var(--chip-amber-bg);
  color: var(--chip-amber-text);
}

.haircut-item-status.is-cancelled {
  background: var(--chip-red-bg);
  color: var(--chip-red-text);
}

/* 已完成 状态 */
.haircut-item-status.is-completed {
  background: var(--chip-green-bg);
  color: var(--chip-green-text);
}

.haircut-item-body {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.haircut-item-name {
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
}

.haircut-item-meta {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
}

.haircut-item-reason {
  font-size: var(--fs-24);
  color: #DC2626;
  margin-top: var(--sp-8);
}

.haircut-item-actions {
  display: flex;
  gap: var(--sp-24);
  padding-top: var(--sp-16);
  margin-top: var(--sp-16);
  border-top: var(--sp-1) solid var(--bg-soft-2);
}

.haircut-item-action {
  font-size: var(--fs-26);
  color: #EA580C;
  font-weight: 500;
}

.haircut-item-action.is-danger {
  color: #DC2626;
}

/* ========== 空状态 ========== */
.haircut-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-80) 0;
}

.haircut-empty-icon {
  font-size: var(--fs-80);
  margin-bottom: var(--sp-20);
}

.haircut-empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ========== 加载状态 ========== */
.haircut-loading {
  display: flex;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.haircut-loading-text {
  font-size: var(--fs-26);
  color: var(--text-muted);
}

/* ========== 弹窗遮罩 ========== */
.haircut-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.haircut-popup-mask.is-visible {
  opacity: 1;
  visibility: visible;
  animation: haircutFadeIn 0.25s ease;
}

/* ========== 弹窗容器 ========== */
.haircut-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 90vh;
  overflow-y: auto;
  margin: 0 var(--sp-28) 0;
}

.haircut-popup-mask.is-visible .haircut-popup-container {
  transform: translateY(0);
  animation: haircutSlideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* 退出动画（与 modalAnimation behavior 的 250ms 对齐；放最后以确保覆盖入场动画） */
.haircut-popup-mask.is-closing {
  animation: haircutFadeOut 0.25s ease forwards;
}

.haircut-popup-mask.is-closing .haircut-popup-container {
  animation: haircutSlideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

@keyframes haircutFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes haircutSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes haircutFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes haircutSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

/* ========== 弹窗头部 ========== */
.haircut-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-32);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  position: sticky;
  top: 0;
  background: var(--bg-card);
  z-index: 1;
}

.haircut-popup-title {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.haircut-popup-close {
  font-size: var(--fs-48);
  color: var(--text-muted);
  line-height: 1;
  padding: 0 var(--sp-8);
}

/* ========== 表单 ========== */
.haircut-popup-form {
  padding: var(--sp-32) var(--sp-32) var(--sp-40);
}

.haircut-field {
  margin-bottom: var(--sp-28);
}

.haircut-field-label {
  font-size: var(--fs-32);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: var(--sp-18);
}

.haircut-required {
  color: #DC2626;
}

.haircut-field-hint {
  font-size: var(--fs-28);
  color: var(--text-muted);
  margin-top: var(--sp-8);
}

.haircut-input-wrapper {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: 0 var(--sp-24);
  height: var(--sp-88);
  display: flex;
  align-items: center;
  border: var(--sp-1) solid var(--border-soft);
}

.haircut-input {
  flex: 1;
  font-size: var(--fs-30);
  color: var(--text-primary);
}

.haircut-input-placeholder {
  color: var(--text-muted);
}

/* ========== 单选组 ========== */
.haircut-radio-group {
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
}

.haircut-radio-item {
  display: flex;
  align-items: center;
  padding: var(--sp-24);
  background: var(--bg-input);
  border-radius: var(--sp-16);
  border: var(--sp-2) solid transparent;
  transition: all 0.3s ease;
}

.haircut-radio-item.is-active {
  background: #FFF7ED;
  border-color: #EA580C;
}

.haircut-radio-dot {
  width: var(--sp-36);
  height: var(--sp-36);
  border-radius: 50%;
  border: var(--sp-2) solid #D1D5DB;
  margin-right: var(--sp-16);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.haircut-radio-item.is-active .haircut-radio-dot {
  border-color: #EA580C;
  background: #EA580C;
}

.haircut-radio-dot-inner {
  width: var(--sp-16);
  height: var(--sp-16);
  border-radius: 50%;
  background: var(--bg-card);
}

.haircut-radio-text {
  font-size: var(--fs-28);
  color: var(--text-primary);
}

/* ========== 提交按钮 ========== */
.haircut-submit-btn {
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  margin-bottom: var(--sp-90);
}

.haircut-submit-btn[disabled] {
  background: var(--text-muted);
}

/* ========== 弹窗操作按钮 ========== */
.haircut-popup-actions {
  padding: var(--sp-16) var(--sp-32);
  padding-bottom: calc(var(--sp-16) + env(safe-area-inset-bottom));
  display: flex;
  gap: var(--sp-16);
}

.haircut-action-btn {
  flex: 1;
  height: var(--sp-88);
  font-size: var(--fs-30);
  font-weight: 600;
  border-radius: var(--sp-16);
  border: none;
}

.haircut-action-btn.is-primary {
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  color: #FFFFFF;
}

.haircut-action-btn.is-secondary {
  background: var(--bg-soft-2);
  color: var(--text-tertiary);
}

.haircut-action-btn.is-danger {
  background: #DC2626;
  color: #FFFFFF;
}

.haircut-action-btn[disabled] {
  background: var(--text-muted);
  color: #FFFFFF;
}

/* ========== 提示信息 ========== */
.haircut-info-card {
  border-radius: var(--sp-12);
  padding: var(--sp-12) var(--sp-12);
  margin-bottom: var(--sp-20);
}

.haircut-info-text {
  font-size: var(--fs-30);
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ========== 统计月分组 ========== */
.haircut-stats-month-group {
  margin-bottom: var(--sp-32);
}

.haircut-stats-month-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  padding: var(--sp-16) var(--sp-24);
  border-left: var(--sp-6) solid #EA580C;
  background: var(--bg-card);
  border-radius: 0 var(--sp-12) var(--sp-12) 0;
  margin-bottom: var(--sp-16);
}

/* ========== 按人员统计 - 人名列表 ========== */
.haircut-stats-name-list {
  background: var(--bg-card);
  border-radius: var(--sp-16);
  padding: var(--sp-16) var(--sp-24);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0, 0, 0, 0.04);
  border: var(--sp-4) solid var(--border-soft);
}

.haircut-stats-name-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-16) 0;
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

.haircut-stats-name-item:last-child {
  border-bottom: none;
}

.haircut-stats-name-text {
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
}

.haircut-stats-count-text {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
  background: var(--bg-soft-2);
  padding: var(--sp-4) var(--sp-16);
  border-radius: var(--sp-20);
}

/* ========== 统计Tab分页加载 ========== */
.pagination-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
  background-color: var(--bg-soft-2);
}

.loading-spinner {
  width: var(--sp-32);
  height: var(--sp-32);
  border: var(--sp-3) solid #e0e0e0;
  border-top-color: #EA580C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: var(--sp-16);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: var(--fs-28);
  color: #999;
}

/* 点击加载更多 */
.pagination-load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.load-more-text {
  font-size: var(--fs-26);
  color: #EA580C;
  background: #FFF7ED;
  padding: var(--sp-16) var(--sp-48);
  border-radius: var(--sp-40);
  border: var(--sp-2) solid #FED7AA;
}

/* 没有更多数据 */
.pagination-no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.no-more-text {
  font-size: var(--fs-24);
  color: #ccc;
}

/* ========== 理发统计：导出选择模式 ========== */

/* 统计 Tab 底部留白：避免悬浮按钮遮住最后一条 */
.haircut-stats-tab {
  padding-bottom: calc(var(--sp-160) + var(--sp-32));
}

/*
  底部居中悬浮按钮（样式参考 form-submission 页的底部悬浮条）：
  - 默认：单个主按钮居中收窄
  - 进入导出模式：主按钮过渡为等分宽度，取消按钮由「宽 0」展开，形成一分为二的动画
  - 容器本身不吃点击（pointer-events: none），避免遮挡列表；按钮各自恢复点击
*/
.haircut-export-bar {
  position: fixed;
  left: var(--sp-32);
  right: var(--sp-32);
  bottom: calc(var(--sp-32) + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 0;
  pointer-events: none;
  animation: haircutFabRise 0.28s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.haircut-export-bar.is-exporting {
  gap: var(--sp-16);
}

.haircut-fab {
  pointer-events: auto;
  padding: var(--sp-22) 0;
  text-align: center;
  background: var(--bg-card);
  border: var(--sp-2) solid var(--primary-border);
  border-radius: var(--sp-48);
  color: var(--primary-text-strong);
  font-size: var(--fs-32);
  font-weight: 600;
  box-shadow: 0 var(--sp-8) var(--sp-24) var(--primary-glow);
  transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.haircut-fab:active {
  transform: scale(0.95);
  opacity: 0.7;
}

/* 主按钮：未进入选择模式时居中收窄（固定 68% 宽） */
.haircut-fab-main {
  flex: 0 0 68%;
}

.haircut-export-bar.is-exporting .haircut-fab-main {
  flex: 1 1 0;
}

/*
  一分为二时两颗按钮必须左右等宽。
  坑：flex-basis 为 0 时，元素在 content-box 下的实际宽度 = 平分到的宽度 + 自身水平内边距，
  两颗按钮若内边距不同（主按钮 0、取消按钮 sp-22），最终就会一大一小。
  因此这里给两颗按钮补上相同的水平内边距。
*/
.haircut-export-bar.is-exporting .haircut-fab {
  padding-left: var(--sp-22);
  padding-right: var(--sp-22);
}

.haircut-fab-main.is-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 取消按钮：默认完全收起（宽 0 + 无内边距/边框 + 透明），进入选择模式后展开 */
.haircut-fab-cancel {
  flex: 1 1 0;
  max-width: 0;
  padding-left: 0;
  padding-right: 0;
  border-width: 0;
  opacity: 0;
  overflow: hidden;
  white-space: nowrap;
  transform: translateX(var(--sp-40)) scale(0.92);
}

.haircut-export-bar.is-exporting .haircut-fab-cancel {
  max-width: 1000rpx;
  padding-left: var(--sp-22);
  padding-right: var(--sp-22);
  border-width: var(--sp-2);
  opacity: 1;
  transform: none;
}

@keyframes haircutFabRise {
  from {
    opacity: 0;
    transform: translateY(var(--sp-40));
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 导出选择模式的月份行：沿用月份分组标题的样式语言 + 复选框 */
.haircut-export-tip {
  font-size: var(--fs-30);
  color: var(--text-muted);
  padding: var(--sp-8) var(--sp-24) var(--sp-20);
}

.haircut-export-month {
  display: flex;
  align-items: center;
  gap: var(--sp-20);
  margin-bottom: var(--sp-20);
  padding: var(--sp-16) var(--sp-24);
  border-left: var(--sp-6) solid #EA580C;
  background: var(--bg-card);
  border-radius: 0 var(--sp-12) var(--sp-12) 0;
  transition: background 0.2s ease, opacity 0.2s ease;
  animation: haircutMonthIn 0.3s cubic-bezier(0.25, 0.1, 0.25, 1) both;
}

.haircut-export-month:active {
  opacity: 0.85;
}

.haircut-export-month.is-checked {
  background: var(--selected-bg);
}

.haircut-export-month-title {
  flex: 1;
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
}

.haircut-export-month-count {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* 方形复选框（与 menus 页导出评分的复选框一致，主色换成本页橙色） */
.haircut-month-checkbox {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: var(--sp-8);
  border: var(--sp-3) solid #CBD5E1;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.18s ease;
}

.haircut-export-month.is-checked .haircut-month-checkbox {
  border-color: #EA580C;
  background: #EA580C;
  transform: scale(1.08);
}

.haircut-month-checkbox-tick {
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 700;
  animation: haircutTickIn 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes haircutMonthIn {
  from {
    opacity: 0;
    transform: translateY(var(--sp-20)) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes haircutTickIn {
  from {
    opacity: 0;
    transform: scale(0.5);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}