/* 理发预约页面样式 */

page {
  background: var(--bg-card);
  height: 100%;
}

.haircut-page {
  min-height: 100%;
}

/* ========== 头部 - 渐变色背景（橙色系） ========== */
.haircut-header {
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  padding: var(--sp-40) var(--sp-28) var(--sp-10);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.haircut-header-content {
  color: #FFFFFF;
}

.haircut-title {
  font-size: var(--fs-48);
  font-weight: 600;
}

.haircut-subtitle {
  font-size: var(--fs-26);
  padding-top: var(--sp-5);
  opacity: 0.9;
}

/* ========== Tab栏 ========== */
.haircut-tabs {
  background: var(--bg-card);
  display: flex;
  padding: 0 var(--sp-16);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  position: sticky;
  top: 0;
  z-index: 50;
}

.haircut-tab {
  flex: 1;
  text-align: center;
  padding: var(--sp-28) 0;
  font-size: var(--fs-32);
  color: var(--text-tertiary);
  font-weight: 500;
  position: relative;
  transition: all 0.3s ease;
}

.haircut-tab.is-active {
  color: #EA580C;
  font-weight: 600;
}

.haircut-tab.is-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: var(--sp-48);
  height: var(--sp-6);
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  border-radius: var(--sp-3);
}

/* ========== 内容区 ========== */
.haircut-content {
  padding: var(--sp-24);
  padding-bottom: var(--sp-100);
}

/* ========== 日期选择器（完全仿会议室样式） ========== */
.date-selector {
  background: var(--bg-card);
  padding: var(--sp-5) 0 var(--sp-5);
  margin-left: calc(var(--sp-24) * -1);
  margin-right: calc(var(--sp-24) * -1);
  border-top: var(--sp-1) solid var(--border-soft);
  border-bottom: var(--sp-1) solid var(--border-soft);
}

.date-scroll {
  width: 100%;
  white-space: nowrap;
  margin-left: var(--sp-10);
}

.date-list {
  display: inline-flex;
  padding: var(--sp-8) var(--sp-24);
  gap: var(--sp-16);
}

.date-item {
  min-width: var(--sp-120);
  padding: var(--sp-20) var(--sp-24);
  border-radius: var(--sp-24);
  background: var(--bg-input);
  border: var(--sp-3) solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
  gap: var(--sp-8);
}

.date-item:active {
  transform: scale(0.95);
}

.date-item.is-active {
  border: var(--sp-3) solid #EA580C;
  background: #ea5a0c1f;
}

.date-item.is-disabled {
  opacity: 0.5;
  background: var(--bg-soft-2);
}

.date-item-left {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: var(--sp-8);
}

.date-weekday {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.date-day {
  font-size: var(--fs-28);
  font-weight: 600;
  color: var(--text-primary);
}

.date-item.is-active .date-day,
.date-item.is-active .date-weekday {
  color: #EA580C;
}

/* 预约数圆圈徽章（橙色） */
.date-count-badge {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: 50%;
  background: #EA580C;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--sp-4);
}

.date-count-badge text {
  font-size: var(--fs-24);
  color: #FFFFFF;
  font-weight: 500;
}

/* ========== 日期提示 ========== */
.haircut-date-hint {
  padding: var(--sp-20) var(--sp-24);
  background: var(--hint-warn-bg);
  border-radius: var(--sp-12);
  margin-top: var(--sp-20);
  margin-bottom: var(--sp-20);
}

.haircut-date-hint-text {
  font-size: var(--fs-26);
  color: var(--hint-warn-text);
}

/* ========== 时段列表 ========== */
.haircut-slots-section {
  margin-top: var(--sp-20);
}

.haircut-slots-title {
  font-size: var(--fs-35);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-16);
  padding-left: var(--sp-8);
}

.haircut-slots-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
}

.haircut-slot-item {
  display: flex;
  
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-24);
  background: var(--bg-card);
  border-radius: var(--sp-16);
  border: var(--sp-4) solid var(--border-soft);
  transition: all 0.3s ease;
}

.haircut-slot-item.is-selected {
  border-color: #EA580C;
  background: #ea5a0c1f;
}

.haircut-slot-item.is-booked {
  opacity: 0.8;
  background: var(--bg-soft-2);
  border-color: transparent;
}

/* 我已预约的时段：与普通时段一致，仅不显示边框 */
.haircut-slot-item.is-my-booked {
  border-color: transparent;
}

.haircut-slot-time {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
}

.haircut-slot-item.is-booked .haircut-slot-time {
  color: var(--text-muted);
}

.haircut-slot-status {
  font-size: var(--fs-24);
  padding: var(--sp-6) var(--sp-16);
  border-radius: var(--sp-8);
}

.haircut-slot-status.is-available {
  background: #DCFCE7;
  color: #16A34A;
}

.haircut-slot-status.is-booked {
  background: #FEE2E2;
  color: #DC2626;
}

/* 我已预约 - 黄色 */
.haircut-slot-status.is-myBooked {
  background: var(--hint-warn-bg);
  color: var(--hint-warn-text);
}

/* 不可预约 - 灰色 */
.haircut-slot-status.is-unavailable {
  background: var(--bg-soft-2);
  color: #6B7280;
}

/* 时段左侧 */
.haircut-slot-left {
  display: flex;
  gap: var(--sp-4);
}


/* 时段右侧 */
.haircut-slot-right {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
}

/* 操作按钮 */
.haircut-slot-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: var(--sp-10);
  margin-left: calc(var(--sp-10) * -1);
}

.haircut-slot-action {
  width: var(--sp-54);
  height: var(--sp-54);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-40);
}

/* 设为不可预约按钮 - 红色 */
.haircut-slot-action.is-disable {
  background: #FEE2E2;
  color: #DC2626;
}

/* 恢复为可预约按钮 - 绿色 */
.haircut-slot-action.is-restore {
  background: #DCFCE7;
  color: #16A34A;
}

/* 取消按钮 - 红色 */
.haircut-slot-action.is-cancel {
  background: #FEE2E2;
  color: #DC2626;
}


.haircut-slot-item.is-selected .haircut-slot-status.is-available {
  background: #EA580C;
  color: #FFFFFF;
}



/* ========== 排序切换 ========== */
.haircut-sort-bar {
  display: flex;
  gap: var(--sp-16);
  margin-bottom: var(--sp-20);
}

.haircut-sort-btn {
  padding: var(--sp-12) var(--sp-24);
  background: var(--bg-card);
  border-radius: var(--sp-24);
  font-size: var(--fs-30);
  color: var(--text-tertiary);
  transition: all 0.3s ease;
}

.haircut-sort-btn.is-active {
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  color: #FFFFFF;
}

/* ========== 列表 ========== */
.haircut-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

/* ========== 记录卡片 ========== */
.haircut-item {
  background: var(--bg-card);
  border-radius: var(--sp-20);
  padding: var(--sp-24);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0, 0, 0, 0.04);
  border: var(--sp-4) solid var(--border-soft);
}

.haircut-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-16);
}

.haircut-item-datetime {
  display: flex;
  flex-direction: column;
}

.haircut-item-date {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.haircut-item-time {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
  margin-top: var(--sp-4);
}

.haircut-item-status {
  font-size: var(--fs-24);
  padding: var(--sp-6) var(--sp-16);
  border-radius: var(--sp-8);
  font-weight: 500;
}

.haircut-item-status.is-booked {
  background: #DCFCE7;
  color: #16A34A;
}

.haircut-item-status.is-cancelled {
  background: #FEE2E2;
  color: #DC2626;
}

.haircut-item-status.is-completed {
  background: var(--bg-soft);
  color: #2563EB;
}

.haircut-item-body {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.haircut-item-name {
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
}

.haircut-item-meta {
  font-size: var(--fs-24);
  color: var(--text-tertiary);
}

.haircut-item-reason {
  font-size: var(--fs-24);
  color: #DC2626;
  margin-top: var(--sp-8);
}

.haircut-item-actions {
  display: flex;
  gap: var(--sp-24);
  padding-top: var(--sp-16);
  margin-top: var(--sp-16);
  border-top: var(--sp-1) solid var(--bg-soft-2);
}

.haircut-item-action {
  font-size: var(--fs-26);
  color: #EA580C;
  font-weight: 500;
}

.haircut-item-action.is-danger {
  color: #DC2626;
}

/* ========== 空状态 ========== */
.haircut-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-80) 0;
}

.haircut-empty-icon {
  font-size: var(--fs-80);
  margin-bottom: var(--sp-20);
}

.haircut-empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ========== 加载状态 ========== */
.haircut-loading {
  display: flex;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.haircut-loading-text {
  font-size: var(--fs-26);
  color: var(--text-muted);
}

/* ========== 弹窗遮罩 ========== */
.haircut-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.haircut-popup-mask.is-visible {
  opacity: 1;
  visibility: visible;
  animation: haircutFadeIn 0.25s ease;
}

/* ========== 弹窗容器 ========== */
.haircut-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 90vh;
  overflow-y: auto;
  margin: 0 var(--sp-28) 0;
}

.haircut-popup-mask.is-visible .haircut-popup-container {
  transform: translateY(0);
  animation: haircutSlideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* 退出动画（与 modalAnimation behavior 的 250ms 对齐；放最后以确保覆盖入场动画） */
.haircut-popup-mask.is-closing {
  animation: haircutFadeOut 0.25s ease forwards;
}

.haircut-popup-mask.is-closing .haircut-popup-container {
  animation: haircutSlideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

@keyframes haircutFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes haircutSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes haircutFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes haircutSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

/* ========== 弹窗头部 ========== */
.haircut-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-32);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  position: sticky;
  top: 0;
  background: var(--bg-card);
  z-index: 1;
}

.haircut-popup-title {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.haircut-popup-close {
  font-size: var(--fs-48);
  color: var(--text-muted);
  line-height: 1;
  padding: 0 var(--sp-8);
}

/* ========== 表单 ========== */
.haircut-popup-form {
  padding: var(--sp-32) var(--sp-32) var(--sp-40);
}

.haircut-field {
  margin-bottom: var(--sp-28);
}

.haircut-field-label {
  font-size: var(--fs-32);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: var(--sp-18);
}

.haircut-required {
  color: #DC2626;
}

.haircut-field-hint {
  font-size: var(--fs-28);
  color: var(--text-muted);
  margin-top: var(--sp-8);
}

.haircut-input-wrapper {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: 0 var(--sp-24);
  height: var(--sp-88);
  display: flex;
  align-items: center;
}

.haircut-input {
  flex: 1;
  font-size: var(--fs-30);
  color: var(--text-primary);
}

.haircut-input-placeholder {
  color: var(--text-muted);
}

/* ========== 单选组 ========== */
.haircut-radio-group {
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
}

.haircut-radio-item {
  display: flex;
  align-items: center;
  padding: var(--sp-24);
  background: var(--bg-input);
  border-radius: var(--sp-16);
  border: var(--sp-2) solid transparent;
  transition: all 0.3s ease;
}

.haircut-radio-item.is-active {
  background: #FFF7ED;
  border-color: #EA580C;
}

.haircut-radio-dot {
  width: var(--sp-36);
  height: var(--sp-36);
  border-radius: 50%;
  border: var(--sp-2) solid #D1D5DB;
  margin-right: var(--sp-16);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.haircut-radio-item.is-active .haircut-radio-dot {
  border-color: #EA580C;
  background: #EA580C;
}

.haircut-radio-dot-inner {
  width: var(--sp-16);
  height: var(--sp-16);
  border-radius: 50%;
  background: var(--bg-card);
}

.haircut-radio-text {
  font-size: var(--fs-28);
  color: var(--text-primary);
}

/* ========== 提交按钮 ========== */
.haircut-submit-btn {
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  margin-bottom: var(--sp-90);
}

.haircut-submit-btn[disabled] {
  background: var(--text-muted);
}

/* ========== 弹窗操作按钮 ========== */
.haircut-popup-actions {
  padding: var(--sp-16) var(--sp-32);
  padding-bottom: calc(var(--sp-16) + env(safe-area-inset-bottom));
  display: flex;
  gap: var(--sp-16);
}

.haircut-action-btn {
  flex: 1;
  height: var(--sp-88);
  font-size: var(--fs-30);
  font-weight: 600;
  border-radius: var(--sp-16);
  border: none;
}

.haircut-action-btn.is-primary {
  background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
  color: #FFFFFF;
}

.haircut-action-btn.is-secondary {
  background: var(--bg-soft-2);
  color: var(--text-tertiary);
}

.haircut-action-btn.is-danger {
  background: #DC2626;
  color: #FFFFFF;
}

.haircut-action-btn[disabled] {
  background: var(--text-muted);
  color: #FFFFFF;
}

/* ========== 提示信息 ========== */
.haircut-info-card {
  border-radius: var(--sp-12);
  padding: var(--sp-12) var(--sp-12);
  margin-bottom: var(--sp-20);
}

.haircut-info-text {
  font-size: var(--fs-28);
  color: var(--text-primary);
  line-height: 1.6;
}

/* ========== 统计月分组 ========== */
.haircut-stats-month-group {
  margin-bottom: var(--sp-32);
}

.haircut-stats-month-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  padding: var(--sp-16) var(--sp-24);
  border-left: var(--sp-6) solid #EA580C;
  background: var(--bg-card);
  border-radius: 0 var(--sp-12) var(--sp-12) 0;
  margin-bottom: var(--sp-16);
}

/* ========== 按人员排序 - 人名列表 ========== */
.haircut-stats-name-list {
  background: var(--bg-card);
  border-radius: var(--sp-16);
  padding: var(--sp-16) var(--sp-24);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0, 0, 0, 0.04);
  border: var(--sp-4) solid var(--border-soft);
}

.haircut-stats-name-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-16) 0;
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

.haircut-stats-name-item:last-child {
  border-bottom: none;
}

.haircut-stats-name-text {
  font-size: var(--fs-28);
  color: var(--text-primary);
  font-weight: 500;
}

.haircut-stats-count-text {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
  background: var(--bg-soft-2);
  padding: var(--sp-4) var(--sp-16);
  border-radius: var(--sp-20);
}

/* ========== 统计Tab分页加载 ========== */
.pagination-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
  background-color: var(--bg-soft-2);
}

.loading-spinner {
  width: var(--sp-32);
  height: var(--sp-32);
  border: var(--sp-3) solid #e0e0e0;
  border-top-color: #EA580C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: var(--sp-16);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: var(--fs-28);
  color: #999;
}

/* 点击加载更多 */
.pagination-load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.load-more-text {
  font-size: var(--fs-26);
  color: #EA580C;
  background: #FFF7ED;
  padding: var(--sp-16) var(--sp-48);
  border-radius: var(--sp-40);
  border: var(--sp-2) solid #FED7AA;
}

/* 没有更多数据 */
.pagination-no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.no-more-text {
  font-size: var(--fs-24);
  color: #ccc;
}