/* 出行数据板（新）页面样式 */

.board-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: var(--sp-100);
}

/* ========== 第一组：统计图表占位 ========== */

.board-chart-section {
  margin: var(--sp-24);
  background: var(--bg-card);
  border-radius: var(--sp-20);
  padding: var(--sp-32) var(--sp-24);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0, 0, 0, 0.04);
}

.board-chart-title {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-20);
}

.board-chart-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--sp-200);
  background: var(--bg-input);
  border-radius: var(--sp-16);
}

.board-chart-placeholder-text {
  font-size: var(--fs-26);
  color: var(--text-muted);
}

/* ========== 吸顶区域 ========== */

.board-sticky-header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--bg-page);
  padding: var(--sp-30) var(--sp-24) 0;
}

/* 折叠面板 */
.board-dropdown {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: var(--sp-12);
  background: var(--bg-card);
  padding: var(--sp-24) var(--sp-28);
  border-radius: var(--sp-16);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0, 0, 0, 0.04);
}

.board-dropdown-label {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  flex: 1;
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.board-dropdown-title {
  text-align: left;
}

.board-dropdown-count {
  margin-left: auto;
  font-size: var(--fs-30);
  font-weight: 400;
  color: #2563EB;
}

.board-dropdown-arrow {
  font-size: var(--fs-28);
  color: var(--text-tertiary);
  transition: transform 0.2s ease;
}

.board-dropdown-arrow.is-open {
  transform: rotate(90deg);
}

/* 下拉菜单 */
.board-dropdown-menu {
  margin-top: var(--sp-8);
  background: var(--bg-card);
  border-radius: var(--sp-16);
  box-shadow: 0 var(--sp-4) var(--sp-20) rgba(0, 0, 0, 0.08);
  overflow: hidden;
  animation: dropdownIn 0.2s ease;
}

@keyframes dropdownIn {
  from { opacity: 0; transform: translateY(calc(var(--sp-8) * -1)); }
  to { opacity: 1; transform: translateY(0); }
}

.board-dropdown-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-24) var(--sp-28);
  font-size: var(--fs-28);
  color: var(--text-primary);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

.board-dropdown-menu-item:last-child {
  border-bottom: none;
}

.board-dropdown-menu-item.is-active {
  color: #2563EB;
  font-weight: 500;
  background: var(--bg-soft);
}

.board-dropdown-menu-count {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
}

.board-dropdown-menu-item.is-active .board-dropdown-menu-count {
  color: #2563EB;
}

/* 分组维度切换 */
.board-group-toggle {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  padding: var(--sp-20) var(--sp-8);
  font-size: var(--fs-32);
  color: var(--text-tertiary);
}

.board-group-arrow {
  font-size: var(--fs-24);
  transition: transform 0.2s ease;
}

.board-group-arrow.is-open {
  transform: rotate(90deg);
}

.board-dropdown-menu--group {
  margin-bottom: var(--sp-8);
}

/* ========== 分组列表 ========== */

.board-groups {
  padding: 0 var(--sp-24);
}

.board-group {
  margin-bottom: var(--sp-24);
}

.board-group:last-child {
  margin-bottom: var(--sp-24);
}

.board-group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-16) var(--sp-8) var(--sp-12);
  font-size: var(--fs-36);
  font-weight: 600;
  color: var(--text-primary);
}

.board-group-count {
  font-size: var(--fs-30);
  font-weight: 400;
  color: var(--text-muted);
}

.board-group-title.is-collapsible {
  cursor: pointer;
  color: var(--text-tertiary);
}

/* 分组标题左侧（箭头 + 名称）：flex 包裹避免被 space-between 分散开 */
.board-group-title-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 折叠箭头：▶ 旋转 90° 即为展开态（带过渡动画） */
.board-group-arrow {
  display: inline-block;
  margin-right: var(--sp-8);
  font-size: var(--fs-22);
  color: var(--text-muted);
  transition: transform 0.25s ease;
}

.board-group-arrow.is-collapsed {
  transform: rotate(0deg);
}

.board-group-arrow:not(.is-collapsed) {
  transform: rotate(90deg);
}

.board-item--deactivated {
  opacity: 0.6;
}

.board-group-items {
  /* 卡片式布局，容器不做包裹 */
}

/* 条目 - 卡片式 */
.board-item {
  display: flex;
  align-items: center;
  padding: var(--sp-24);
  background: var(--bg-card);
  border-radius: var(--sp-16);
  margin-bottom: var(--sp-12);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0,0,0,0.04);
  border-left: var(--sp-6) solid;
  margin-bottom: var(--sp-25);
  transition: all 0.2s ease;
}

.board-item:last-child {
  margin-bottom: 0;
}

.board-item:active {
  transform: scale(0.95);
  opacity: 0.8;
  border-left: var(--sp-2) solid;
}


.board-item-main {
  flex: 1;
  min-width: 0;
}

.board-item-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-5);
}

.board-item-name {
  font-size: var(--fs-32);
  font-weight: 500;
  color: var(--text-primary);
}

.board-item-status {
  font-size: var(--fs-26);
  padding: var(--sp-6) var(--sp-16);
  border-radius: var(--sp-8);
  font-weight: 500;
  flex-shrink: 0;
}

.board-item-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.board-item-dest {
  font-size: var(--fs-28);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.board-item-time {
  font-size: var(--fs-28);
  color: var(--text-muted);
  flex-shrink: 0;
  padding-right: var(--sp-15);
}

.board-item-info--none {
  color: #CBD5E1;
}

.board-item-info--none text {
  font-size: var(--fs-28);
  color: #CBD5E1;
}

.board-item-arrow {
  font-size: var(--fs-36);
  color: #CBD5E1;
  margin-left: var(--sp-12);
  flex-shrink: 0;
}

/* 加载/空状态 */
.board-loading {
  display: flex;
  justify-content: center;
  padding: var(--sp-60) 0;
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.board-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-80) 0;
}

.board-empty-icon {
  font-size: var(--fs-80);
  margin-bottom: var(--sp-20);
}

.board-empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ========== 个人记录弹窗 ========== */

.person-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  animation: fadeIn 0.2s ease;
}

.person-popup-mask.is-closing {
  animation: fadeOut 0.25s ease forwards;
}

.person-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80vh;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
  will-change: transform;
}

.is-closing .person-popup-container {
  animation: slideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes slideDown { from { transform: translateY(0); } to { transform: translateY(100%); } }

.person-popup-header {
  position: relative;
  padding: var(--sp-32) var(--sp-28) var(--sp-24);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
  flex-shrink: 0;
}

/* 下拉把手（iOS 风格，呼吸灯效果） */
.person-popup-handle {
  width: var(--sp-102);
  height: var(--sp-10);
  margin: 0 auto var(--sp-5);
  background: #CBD5E1;
  border-radius: var(--sp-5);
  animation: handleBreathe 2s ease-in-out infinite;
}

@keyframes handleBreathe {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.person-popup-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
  padding-right: var(--sp-60);
}

.person-popup-subtitle {
  font-size: var(--fs-26);
  color: var(--text-muted);
  margin-top: var(--sp-8);
}

.person-popup-close {
  position: absolute;
  top: var(--sp-32);
  right: var(--sp-28);
  font-size: var(--fs-32);
  color: var(--text-muted);
  width: var(--sp-60);
  height: var(--sp-60);
  display: flex;
  align-items: center;
  justify-content: center;
}

.person-popup-body {
  flex: 1;
  padding: var(--sp-24) var(--sp-28);
  overflow-y: auto;
  box-sizing: border-box;
}

/* 隐藏默认滚动条（原 enhanced + show-scrollbar="{{false}}" 效果） */
.person-popup-body::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.person-popup-loading,
.person-popup-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--sp-80) 0;
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* 年月分组 */
.person-popup-group {
  margin-bottom: var(--sp-32);
}

.person-popup-group:last-child {
  margin-bottom: 0;
}

.person-popup-group-title {
  font-size: var(--fs-28);
  font-weight: 600;
  color: #2563EB;
  margin-bottom: var(--sp-16);
  padding-left: var(--sp-8);
  border-left: var(--sp-6) solid #2563EB;
  padding-left: var(--sp-16);
}

/* 记录卡片 */
.person-popup-record {
  background: var(--bg-input);
  border-radius: var(--sp-16);
  padding: var(--sp-24);
  margin-bottom: var(--sp-16);
  box-sizing: border-box;
  overflow: hidden;
}

.person-popup-record:last-child {
  margin-bottom: 0;
}

.person-popup-record-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--sp-16);
}

.person-popup-record-dest {
  font-size: var(--fs-30);
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  margin-right: var(--sp-16);
  word-break: break-all;
  line-height: 1.4;
}

.person-popup-record-status {
  font-size: var(--fs-24);
  padding: var(--sp-6) var(--sp-16);
  border-radius: var(--sp-8);
  font-weight: 500;
  flex-shrink: 0;
}

.person-popup-record-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: var(--sp-6) 0;
}

.person-popup-record-label {
  font-size: var(--fs-26);
  color: var(--text-tertiary);
  flex-shrink: 0;
  margin-right: var(--sp-16);
}

.person-popup-record-value {
  font-size: var(--fs-26);
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  text-align: right;
  word-break: break-all;
}

/* 分页加载状态（与项目其他页面一致） */
.pagination-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.loading-spinner {
  width: var(--sp-32);
  height: var(--sp-32);
  border: var(--sp-3) solid #E0E0E0;
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: var(--sp-16);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.pagination-no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.no-more-text {
  font-size: var(--fs-24);
  color: #CBD5E1;
}

/* ========== 底部可查看范围提示 ========== */

.board-bottom-msg {
  text-align: center;
  padding: 0 var(--sp-48) var(--sp-54);
  font-size: var(--fs-30);
  color: var(--text-muted);
}
