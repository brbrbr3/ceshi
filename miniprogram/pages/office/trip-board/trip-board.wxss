/* 出行数据板（新）页面样式 */

.board-page {
  min-height: 100vh;
  background: #EEF2FF;
  padding-bottom: 100rpx;
}

/* ========== 第一组：统计图表占位 ========== */

.board-chart-section {
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.board-chart-title {
  font-size: var(--fs-34);
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 20rpx;
}

.board-chart-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
}

.board-chart-placeholder-text {
  font-size: var(--fs-26);
  color: #94A3B8;
}

/* ========== 吸顶区域 ========== */

.board-sticky-header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #EEF2FF;
  padding: 30rpx 24rpx 0;
}

/* 折叠面板 */
.board-dropdown {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  background: #FFFFFF;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.board-dropdown-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  font-size: var(--fs-34);
  font-weight: 600;
  color: #1E293B;
}

.board-dropdown-title {
  text-align: left;
}

.board-dropdown-count {
  margin-left: auto;
  font-size: var(--fs-30);
  font-weight: 400;
  color: #2563EB;
}

.board-dropdown-arrow {
  font-size: var(--fs-28);
  color: #64748B;
  transition: transform 0.2s ease;
}

.board-dropdown-arrow.is-open {
  transform: rotate(90deg);
}

/* 下拉菜单 */
.board-dropdown-menu {
  margin-top: 8rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  animation: dropdownIn 0.2s ease;
}

@keyframes dropdownIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.board-dropdown-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  font-size: var(--fs-28);
  color: #1E293B;
  border-bottom: 1rpx solid #F1F5F9;
}

.board-dropdown-menu-item:last-child {
  border-bottom: none;
}

.board-dropdown-menu-item.is-active {
  color: #2563EB;
  font-weight: 500;
  background: #EFF6FF;
}

.board-dropdown-menu-count {
  font-size: var(--fs-26);
  color: #64748B;
}

.board-dropdown-menu-item.is-active .board-dropdown-menu-count {
  color: #2563EB;
}

/* 分组维度切换 */
.board-group-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 8rpx;
  font-size: var(--fs-32);
  color: #64748B;
}

.board-group-arrow {
  font-size: var(--fs-24);
  transition: transform 0.2s ease;
}

.board-group-arrow.is-open {
  transform: rotate(90deg);
}

.board-dropdown-menu--group {
  margin-bottom: 8rpx;
}

/* ========== 分组列表 ========== */

.board-groups {
  padding: 0 24rpx;
}

.board-group {
  margin-bottom: 24rpx;
}

.board-group:last-child {
  padding-bottom: 100rpx;
}

.board-group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 12rpx;
  font-size: var(--fs-28);
  font-weight: 600;
  color: #1E293B;
}

.board-group-count {
  font-size: var(--fs-24);
  font-weight: 400;
  color: #94A3B8;
}

.board-group-items {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 条目 */
.board-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.board-item:last-child {
  border-bottom: none;
}

.board-item-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-30);
  font-weight: 500;
  color: #FFFFFF;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.board-item-main {
  flex: 1;
  min-width: 0;
}

.board-item-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.board-item-name {
  font-size: var(--fs-30);
  font-weight: 500;
  color: #1E293B;
}

.board-item-status {
  font-size: var(--fs-24);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.board-item-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.board-item-dest {
  font-size: var(--fs-26);
  color: #64748B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.board-item-time {
  font-size: var(--fs-24);
  color: #94A3B8;
  flex-shrink: 0;
}

.board-item-info--none {
  color: #CBD5E1;
}

.board-item-info--none text {
  font-size: var(--fs-26);
  color: #CBD5E1;
}

.board-item-arrow {
  font-size: var(--fs-36);
  color: #CBD5E1;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 加载/空状态 */
.board-loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  font-size: var(--fs-28);
  color: #94A3B8;
}

.board-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.board-empty-icon {
  font-size: var(--fs-80);
  margin-bottom: 20rpx;
}

.board-empty-text {
  font-size: var(--fs-28);
  color: #94A3B8;
}

/* ========== 个人记录弹窗 ========== */

.person-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  animation: fadeIn 0.2s ease;
}

.person-popup-mask.is-closing {
  animation: fadeOut 0.25s ease forwards;
}

.person-popup-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.is-closing .person-popup-container {
  animation: slideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes slideDown { from { transform: translateY(0); } to { transform: translateY(100%); } }

.person-popup-header {
  position: relative;
  padding: 32rpx 28rpx 24rpx;
  border-bottom: 1rpx solid #F1F5F9;
  flex-shrink: 0;
}

.person-popup-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #1E293B;
  padding-right: 60rpx;
}

.person-popup-subtitle {
  font-size: var(--fs-26);
  color: #94A3B8;
  margin-top: 8rpx;
}

.person-popup-close {
  position: absolute;
  top: 32rpx;
  right: 28rpx;
  font-size: var(--fs-32);
  color: #94A3B8;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.person-popup-body {
  flex: 1;
  padding: 24rpx 28rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.person-popup-loading,
.person-popup-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  font-size: var(--fs-28);
  color: #94A3B8;
}

/* 年月分组 */
.person-popup-group {
  margin-bottom: 32rpx;
}

.person-popup-group:last-child {
  margin-bottom: 0;
}

.person-popup-group-title {
  font-size: var(--fs-28);
  font-weight: 600;
  color: #2563EB;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #2563EB;
  padding-left: 16rpx;
}

/* 记录卡片 */
.person-popup-record {
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.person-popup-record:last-child {
  margin-bottom: 0;
}

.person-popup-record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.person-popup-record-dest {
  font-size: var(--fs-30);
  font-weight: 500;
  color: #1E293B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.person-popup-record-status {
  font-size: var(--fs-24);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.person-popup-record-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 6rpx 0;
}

.person-popup-record-label {
  font-size: var(--fs-26);
  color: #64748B;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.person-popup-record-value {
  font-size: var(--fs-26);
  color: #1E293B;
  flex: 1;
  min-width: 0;
  text-align: right;
  word-break: break-all;
}

/* 分页加载状态（与项目其他页面一致） */
.pagination-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E0E0E0;
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--fs-28);
  color: #94A3B8;
}

.pagination-no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: var(--fs-24);
  color: #CBD5E1;
}

/* ========== 底部可查看范围提示 ========== */

.board-bottom-msg {
  text-align: center;
  padding: 150rpx 48rpx 40rpx;
  font-size: var(--fs-30);
  color: #94A3B8;
}
