<watermark />

<view class="office-page personnel-page" style="{{fontStyle}}">
  <view class="office-gradient-header office-subpage-header">
    <view class="office-subpage-header-content">
      <view class="office-subpage-title">人员配置</view>
      <view class="office-subpage-subtitle">管理全体用户的个人资料与报备配置</view>
    </view>
  </view>

  <scroll-view class="personnel-content-scroll" scroll-y="true" enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="personnel-loading">
      <text>加载中...</text>
    </view>

    <view wx:else>
      <view wx:if="{{!canEdit}}" class="report-readonly-tip">
        <text>当前为只读模式，如需修改请联系管理员</text>
      </view>

      <!-- 搜索栏 -->
      <view class="personnel-search">
        <input class="personnel-search-input" value="{{searchKeyword}}" bindinput="handleSearchInput" placeholder="搜索姓名..." />
      </view>

      <!-- 用户列表（按分组排列） -->
      <view wx:if="{{filteredUsers.length === 0}}" class="office-card office-empty">
        <view>没有匹配的用户</view>
      </view>

      <view wx:else>
        <view wx:for="{{personnelGroups}}" wx:key="groupName" class="personnel-group-section">
          <view class="personnel-group-label">{{item.groupName}}</view>
          <view class="personnel-list">
            <view class="personnel-card" wx:for="{{item.users}}" wx:for-item="card" wx:key="openid" bindtap="handleUserTap" data-openid="{{card.openid}}">
              <view class="personnel-card-avatar">{{card.avatarText}}</view>
              <view class="personnel-card-body">
                <view class="personnel-card-name">{{card.name}}</view>
                <view class="personnel-card-meta">{{card.livingArea || '未填写'}}</view>
              </view>
              <view class="personnel-card-label personnel-label-{{card.labelClass}}">{{card.labelText}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 编辑弹窗 -->
  <view class="personnel-modal-mask {{showEditModal ? '' : 'is-hidden'}} {{modalAnimating ? 'is-closing' : ''}}" catchtap="handleCloseModal">
    <view class="personnel-modal {{modalAnimating ? 'is-closing' : ''}}" catchtap="stopPropagation">
      <view class="personnel-modal-header">
        <text class="personnel-modal-title">编辑：{{editUser.name}}</text>
        <view class="personnel-modal-close" catchtap="handleCloseModal">✕</view>
      </view>
      <view class="personnel-modal-body">
          <!-- ===== 第一组：个人信息 ===== -->
          <view class="personnel-section">
            <view class="personnel-section-title">个人信息</view>

            <view class="personnel-field">
              <view class="personnel-field-label">角色</view>
              <picker mode="selector" range="{{['馆员','其他']}}" value="{{formRole ? (formRole === '其他' ? 1 : 0) : -1}}" bindchange="handleRoleChange">
                <view class="personnel-picker">{{formRole || '选择角色'}}</view>
              </picker>
            </view>

            <view class="personnel-field" wx:if="{{formRole === '馆员'}}">
              <view class="personnel-field-label">部门</view>
              <picker mode="selector" range="{{departmentOptions}}" bindchange="handleDeptChange">
                <view class="personnel-picker">{{formDepartment || '选择部门'}}</view>
              </picker>
            </view>

            <view class="personnel-field personnel-field-checkbox" wx:if="{{formRole === '馆员'}}">
              <view class="personnel-field-label">部门负责人</view>
              <switch checked="{{formIsDeptHead}}" bindchange="handleDeptHeadChange" color="#2563EB" />
            </view>

            <view class="personnel-field">
              <view class="personnel-field-label">居住区域</view>
              <picker mode="selector" range="{{livingAreas}}" bindchange="handleAreaChange">
                <view class="personnel-picker">{{formLivingArea || '选择居住区域'}}</view>
              </picker>
            </view>

            <view class="personnel-field personnel-field-checkbox">
              <view class="personnel-field-label">是否片长</view>
              <switch checked="{{formIsAreaManager}}" bindchange="handleAreaManagerChange" color="#2563EB" />
            </view>

            <view class="personnel-field personnel-field-column">
              <view class="personnel-field-label">岗位</view>
              <view class="personnel-position-list">
                <view class="personnel-position-item {{item.checked ? 'is-active' : ''}}" wx:for="{{formPositions}}" wx:key="value" bindtap="handleTogglePosition" data-value="{{item.value}}">{{item.name}}</view>
                <view wx:if="{{positionOptions.length === 0}}" class="personnel-empty-hint">暂无可选岗位</view>
              </view>
            </view>
          </view>

          <!-- ===== 第二组：报备与权限 ===== -->
          <view class="personnel-section">
            <view class="personnel-section-title">报备与权限</view>

            <!-- 馆员+部门无提示 -->
            <view wx:if="{{formRole === '馆员' && formDepartment === '无'}}" class="personnel-leader-hint">
              该用户可查看全体人员出行情况，但不自动接收任何人的报备推送。可手动勾选下方人员为其订阅推送。
            </view>

            <!-- 谁向该用户报备（订阅列表） -->
            <view class="personnel-subsection">
              <view class="personnel-subsection-header">
                <text class="personnel-subsection-title">谁向该用户报备\n</text>
                <text class="personnel-subsection-desc">将订阅勾选人员的报备</text>
              </view>

              <!-- 视图切换 -->
              <view class="personnel-view-toggle">
                <view class="personnel-view-btn {{subscriberGroupBy === 'department' ? 'is-active' : ''}}" bindtap="handleToggleSubGroupBy" data-by="department">按部门</view>
                <view class="personnel-view-btn {{subscriberGroupBy === 'livingArea' ? 'is-active' : ''}}" bindtap="handleToggleSubGroupBy" data-by="livingArea">按居住区</view>
              </view>

              <!-- 按部门分组视图 -->
              <view wx:if="{{subscriberGroupBy === 'department'}}">
                <view wx:if="{{subscriberGroups.length === 0}}" class="personnel-empty-hint">暂无其他用户</view>
                <view wx:for="{{subscriberGroups}}" wx:key="name" class="personnel-sub-group">
                  <view class="personnel-sub-group-header" catchtap="handleToggleGroup" data-group="{{item.name}}">
                    <view class="personnel-group-check {{item.allChecked ? 'is-checked' : ''}}">
                      <text wx:if="{{item.allChecked}}">✓</text>
                    </view>
                    <text class="personnel-group-name">{{item.name}}</text>
                    <text class="personnel-group-count">{{item.users.length}}人</text>
                  </view>
                  <view class="personnel-sub-group-item" wx:for="{{item.users}}" wx:for-item="u" wx:key="openid" catchtap="handleToggleSubscriber" data-openid="{{u.openid}}">
                    <view class="personnel-check {{u.checked ? 'is-checked' : ''}}">
                      <text wx:if="{{u.checked}}">✓</text>
                    </view>
                  <text class="personnel-user-name">{{u.name}}</text>
                  <text class="personnel-user-label">{{u.subText}}</text>
                </view>
              </view>
            </view>

            <!-- 按居住区分组视图 -->
            <view wx:else>
                <view wx:if="{{subscriberAreaGroups.length === 0}}" class="personnel-empty-hint">暂无其他用户</view>
                <view wx:for="{{subscriberAreaGroups}}" wx:key="name" class="personnel-sub-group">
                  <view class="personnel-sub-group-header" catchtap="handleToggleAreaGroup" data-group="{{item.name}}">
                    <view class="personnel-group-check {{item.allChecked ? 'is-checked' : ''}}">
                      <text wx:if="{{item.allChecked}}">✓</text>
                    </view>
                    <text class="personnel-group-name">{{item.name}}</text>
                    <text class="personnel-group-count">{{item.users.length}}人</text>
                  </view>
                  <view class="personnel-sub-group-item" wx:for="{{item.users}}" wx:for-item="u" wx:key="openid" catchtap="handleToggleSubscriber" data-openid="{{u.openid}}">
                    <view class="personnel-check {{u.checked ? 'is-checked' : ''}}">
                      <text wx:if="{{u.checked}}">✓</text>
                    </view>
                  <text class="personnel-user-name">{{u.name}}</text>
                  <text class="personnel-user-label">{{u.subText}}</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 该用户向谁报备 -->
            <view class="personnel-subsection">
              <view class="personnel-subsection-header">
                <text class="personnel-subsection-title">该用户向谁报备\n</text>
                <text class="personnel-subsection-desc">该用户出行时推送报备给勾选人员</text>
              </view>

              <view wx:if="{{reportToOptions.length === 0}}" class="personnel-empty-hint">暂无其他用户</view>

              <view class="personnel-sub-group-list">
                <view class="personnel-sub-group-item" wx:for="{{reportToOptions}}" wx:key="openid" catchtap="handleToggleReportTo" data-openid="{{item.openid}}">
                  <view class="personnel-check {{item.checked ? 'is-checked' : ''}}">
                    <text wx:if="{{item.checked}}">✓</text>
                  </view>
                  <text class="personnel-user-name">{{item.name}}</text>
                  <text class="personnel-user-label">{{item.label}}</text>
                </view>
              </view>
            </view>
          </view>
      </view>
      <view class="personnel-modal-footer">
        <button class="personnel-btn-cancel" bindtap="handleCloseModal">取消</button>
        <button class="personnel-btn-save" bindtap="handleSavePersonnel">保存配置</button>
      </view>
    </view>
  </view>
</view>