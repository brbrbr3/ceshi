.personnel-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.personnel-content-scroll {
  flex: 1;
  overflow-y: auto;
}

.personnel-loading {
  text-align: center;
  padding: var(--sp-80) 0;
  color: var(--text-muted);
  font-size: var(--fs-28);
}

/* ==================== 搜索 ==================== */
.personnel-search {
  padding: var(--sp-10) var(--sp-24) var(--sp-16);
}

.personnel-search-input {
  width: 100%;
  height: var(--sp-72);
  padding: 0 var(--sp-32);
  background: var(--bg-card);
  border-radius: var(--sp-36);
  font-size: var(--fs-28);
  color: var(--text-primary);
  box-sizing: border-box;
}

.personnel-search-input::placeholder {
  color: var(--text-muted);
}

/* ==================== 用户列表分组 ==================== */
.personnel-group-section {
  margin-bottom: var(--sp-8);
}

.personnel-group-section:last-child {
  padding-bottom: var(--sp-100);
}

.personnel-group-label {
  padding: var(--sp-16) var(--sp-24) var(--sp-8);
  font-size: var(--fs-35);
  font-weight: 700;
  color: var(--text-secondary);
}

.personnel-list {
  padding: 0 var(--sp-24);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.personnel-card {
  width: 48.5%;
  background: var(--bg-card);
  border-radius: var(--sp-16);
  padding: var(--sp-40) var(--sp-24);
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  box-shadow: 0 var(--sp-2) var(--sp-12) rgba(0,0,0,0.04);
  box-sizing: border-box;
  position: relative;
  margin-bottom: var(--sp-16);
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.personnel-card:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.personnel-card-avatar {
  width: var(--sp-72);
  height: var(--sp-72);
  border-radius: 50%;
  background: linear-gradient(135deg, #E0E7FF 0%, #C7D2FE 100%);
  color: #2563EB;
  font-size: var(--fs-36);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.personnel-card-body {
  flex: 1;
  min-width: 0;
}

.personnel-card-name {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.personnel-card-meta {
  font-size: var(--fs-26);
  color: var(--text-muted);
  margin-top: var(--sp-4);
}

/* 标签 */
.personnel-card-label {
  position: absolute;
  top: 0;
  right: 0;
  padding: var(--sp-4) var(--sp-16);
  border-radius: 0 var(--sp-16) 0 var(--sp-12);
  font-size: var(--fs-20);
  font-weight: 500;
  color: #FFFFFF;
}

.personnel-label-leader { background: #DC2626; }
.personnel-label-manager { background: #F59E0B; }
.personnel-label-head { background: #2563EB; }
.personnel-label-head-manager { background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%); }
.personnel-label-curator { background: #10B981; }
.personnel-label-other { background: var(--text-muted); }

/* ==================== 弹窗遮罩 ==================== */
.personnel-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: personnelFadeIn 0.25s ease;
}
.personnel-modal-mask.is-hidden { display: none; }

@keyframes personnelFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.personnel-modal-mask.is-closing {
  animation: personnelFadeOut 0.25s ease forwards;
}

@keyframes personnelFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* ==================== 弹窗 ==================== */
.personnel-modal {
  width: 100%;
  height: 85vh;
  background: var(--bg-input);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  display: flex;
  flex-direction: column;
  animation: personnelSlideUp 0.3s ease;
  box-sizing: border-box;
}

@keyframes personnelSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.personnel-modal.is-closing {
  animation: personnelSlideDown 0.25s ease forwards;
}

@keyframes personnelSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

.personnel-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-32) var(--sp-32) var(--sp-16);
  flex-shrink: 0;
}

.personnel-modal-title {
  font-size: var(--fs-34);
  font-weight: 700;
  color: var(--text-primary);
}

.personnel-modal-close {
  width: var(--sp-56);
  height: var(--sp-56);
  border-radius: 50%;
  background: var(--border-soft);
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-28);
}

.personnel-modal-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0 var(--sp-32) var(--sp-16);
  box-sizing: border-box;
  width: 100%;
}

/* ==================== 区块 ==================== */
.personnel-section {
  background: var(--bg-card);
  border-radius: var(--sp-20);
  padding: var(--sp-24);
  margin-bottom: var(--sp-16);
}

.personnel-section-title {
  font-size: var(--fs-32);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--sp-20);
  padding-bottom: var(--sp-16);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

/* ==================== 表单字段 ==================== */
.personnel-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-16) 0;
  border-bottom: var(--sp-1) solid var(--bg-input);
}

.personnel-field:last-child {
  border-bottom: none;
}

.personnel-field-label {
  font-size: var(--fs-30);
  color: var(--text-secondary);
  flex-shrink: 0;
}

.personnel-picker {
  font-size: var(--fs-28);
  color: var(--text-primary);
  padding: var(--sp-8) var(--sp-16);
  background: var(--bg-soft-2);
  border-radius: var(--sp-10);
}

.personnel-field-checkbox .personnel-field-label {
  color: var(--text-primary);
  font-weight: 500;
}

/* ==================== 馆领导提示 ==================== */
.personnel-leader-hint {
  background: #FEF2F2;
  color: #B91C1C;
  font-size: var(--fs-28);
  padding: var(--sp-16) var(--sp-20);
  border-radius: var(--sp-12);
  line-height: 1.5;
  margin-bottom: var(--sp-16);
}

/* ==================== 子区块 ==================== */
.personnel-subsection {
  margin-top: var(--sp-8);
}

.personnel-subsection + .personnel-subsection {
  margin-top: var(--sp-24);
  padding-top: var(--sp-24);
  border-top: var(--sp-2) solid var(--bg-soft-2);
}

.personnel-subsection-header {
  margin-bottom: var(--sp-12);
}

.personnel-subsection-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
}

.personnel-subsection-desc {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

/* ==================== 分组勾选 ==================== */
.personnel-sub-group {
  background: var(--bg-input);
  border-radius: var(--sp-12);
  margin-bottom: var(--sp-8);
  overflow: hidden;
}

.personnel-sub-group-header {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--sp-14) var(--sp-16);
  background: var(--bg-soft-2);
  cursor: pointer;
}

.personnel-group-check {
  width: var(--sp-36);
  height: var(--sp-36);
  border: var(--sp-2) solid #CBD5E1;
  border-radius: var(--sp-6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
  color: #FFFFFF;
  flex-shrink: 0;
}

.personnel-group-check.is-checked {
  background: #2563EB;
  border-color: #2563EB;
}

.personnel-group-name {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-tertiary);
  flex: 1;
}

.personnel-group-count {
  font-size: var(--fs-30);
  color: var(--text-muted);
}

.personnel-sub-group-list {
  padding: var(--sp-4) 0;
}

.personnel-sub-group-item {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--sp-12) var(--sp-16);
  border-bottom: var(--sp-1) solid var(--bg-soft-2);
}

.personnel-sub-group-item.is-disabled {
  opacity: 0.45;
}

.personnel-sub-group-item:last-child {
  border-bottom: none;
}

.personnel-check {
  width: var(--sp-36);
  height: var(--sp-36);
  border: var(--sp-2) solid #CBD5E1;
  border-radius: var(--sp-6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
  color: #FFFFFF;
  flex-shrink: 0;
}

.personnel-check.is-checked {
  background: #2563EB;
  border-color: #2563EB;
}

.personnel-user-name {
  font-size: var(--fs-28);
  color: var(--text-primary);
  flex: 1;
}

.personnel-user-label {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.personnel-empty-hint {
  text-align: center;
  padding: var(--sp-24);
  color: var(--text-muted);
  font-size: var(--fs-24);
}

/* ==================== 弹窗底部 ==================== */
.personnel-modal-footer {
  display: flex;
  gap: var(--sp-16);
  padding: var(--sp-20) var(--sp-32) var(--sp-40);
  flex-shrink: 0;
  background: var(--bg-card);
  border-top: var(--sp-1) solid var(--bg-soft-2);
}

.personnel-btn-cancel,
.personnel-btn-save {
  flex: 1;
  height: var(--sp-88);
  border-radius: var(--sp-16);
  font-size: var(--fs-30);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  line-height: var(--sp-88);
}

.personnel-btn-cancel {
  background: var(--bg-soft-2);
  color: var(--text-tertiary);
}
.personnel-btn-cancel::after { border: none; }

.personnel-btn-save {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
}
.personnel-btn-save::after { border: none; }


.personnel-btn-deactivate {
  background: var(--bg-card);
  border-radius: var(--sp-32);
  box-shadow: 0 var(--sp-16) var(--sp-42) rgba(37, 99, 235, 0.08);
  margin-top: var(--sp-24);
  text-align: center;
  font-size: var(--fs-32);
  font-weight: 600;
  color: #EF4444;
  transition: transform 0.3s ease, opacity 0.3s ease;
  padding: var(--sp-24);
}

.personnel-btn-active {
  transform: scale(0.95);
  opacity: 0.7;
}

.personnel-btn-deactivate::after { border: none; }

/* 已注销用户的注销按钮：置灰且不可点击 */
.personnel-btn-deactivate.is-disabled {
  background: var(--bg-soft-2);
  box-shadow: none;
  pointer-events: none;
}

.personnel-footer-btns {
  display: flex;
  gap: var(--sp-16);
  width: 100%;
}

/* 已注销用户标签 */
.personnel-label-deactivated {
  background: var(--text-muted);
}

.personnel-card--deactivated {
  opacity: 0.65;
}

/* 可折叠分组标题 */
.personnel-group-label.is-collapsible {
  cursor: pointer;
}

/* 折叠箭头：▶ 旋转 90° 即为展开态（带过渡动画） */
.personnel-group-arrow {
  display: inline-block;
  margin-right: var(--sp-8);
  font-size: var(--fs-24);
  color: var(--text-muted);
  transition: transform 0.25s ease;
}

.personnel-group-arrow.is-collapsed {
  transform: rotate(0deg);
}

.personnel-group-arrow:not(.is-collapsed) {
  transform: rotate(90deg);
}

.personnel-group-count-text {
  font-size: var(--sp-24);
  font-weight: 400;
  color: var(--text-muted);
  margin-left: var(--sp-8);
}

/* ==================== 岗位选择 ==================== */
.personnel-position-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-10);
  flex: 1;
  justify-content: flex-end;
  padding: var(--sp-8) 0;
}

.personnel-position-item {
  height: var(--sp-64);
  padding: 0 var(--sp-24);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-input);
  border-radius: var(--sp-16);
  font-size: var(--fs-28);
  color: var(--text-tertiary);
  border: none;
  transition: all 0.15s ease;
}

.personnel-position-item.is-active {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  box-shadow: 0 var(--sp-4) var(--sp-12) rgba(37, 99, 235, 0.25);
}

/* ==================== 视图切换 ==================== */
.personnel-view-toggle {
  display: flex;
  gap: 0;
  margin-bottom: var(--sp-16);
  background: var(--bg-soft-2);
  border-radius: var(--sp-12);
  overflow: hidden;
}

.personnel-view-btn {
  flex: 1;
  text-align: center;
  padding: var(--sp-12) 0;
  font-size: var(--fs-32);
  color: var(--text-tertiary);
  border-radius: var(--sp-12);
}

.personnel-view-btn.is-active {
  background: #2563EB;
  color: #FFFFFF;
  font-weight: 600;
}

/* placeholder 读条 bar */
.report-readonly-tip {
  margin: var(--sp-16) var(--sp-24);
  padding: var(--sp-16) var(--sp-24);
  background: var(--hint-warn-bg);
  border-radius: var(--sp-12);
  font-size: var(--fs-24);
  color: var(--hint-warn-text);
  text-align: center;
}

/* ==================== 自定义 Toast（毛玻璃） ==================== */
.custom-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  background: var(--toast-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: var(--sp-20);
  padding: var(--sp-28) var(--sp-44);
  max-width: var(--sp-620);
  opacity: 0;
  pointer-events: none;
  z-index: 9999;
  box-shadow: 0 var(--sp-12) var(--sp-48) rgba(0, 0, 0, 0.25);
}

.custom-toast.is-visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  transition: opacity 0.18s ease, transform 0.22s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.custom-toast-text {
  color: var(--toast-text);
  font-size: var(--sp-28);
  font-weight: 500;
  line-height: 1.7;
  text-align: center;
  word-break: break-all;
}
