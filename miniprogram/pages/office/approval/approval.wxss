page {
  background: var(--bg-page);
}

/* 分页加载样式 */
.pagination-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
  background: var(--bg-page);
}

.loading-spinner {
  width: var(--sp-32);
  height: var(--sp-32);
  border: var(--sp-3) solid #e0e0e0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: var(--sp-16);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: var(--fs-28);
  color: #999;
}

.pagination-no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
  background: var(--bg-page);
}

.no-more-text {
  font-size: var(--fs-24);
  color: #ccc;
}


.approval-header {
  padding: var(--sp-40) var(--sp-32) var(--sp-40);
}

.approval-title {
  font-size: var(--fs-40);
  font-weight: 600;
}

.approval-subtitle {
  font-size: var(--fs-24);
  opacity: 0.76;
}

.approval-launch-btn {
  min-width: var(--sp-126);
  margin: 0 0 0 var(--sp-10);
  padding: var(--sp-14) var(--sp-34);
  border-radius: var(--sp-999);
  background: rgba(255, 255, 255, 0.16);
  font-size: var(--fs-24);
  font-weight: 400;
  text-align: center;
}

.approval-tabs-shell {
  margin-top: var(--sp-30);
  margin-bottom: calc(var(--sp-10) * -1);
  padding: var(--sp-6);
  border-radius: var(--sp-28);
  background: rgba(255, 255, 255, 0.15);
  display: flex;
}

.approval-tab {
  flex: 1;
  height: var(--sp-72);
  border-radius: var(--sp-22);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-8);
  color: rgba(255, 255, 255, 0.78);
  font-size: var(--fs-24);
}

.approval-tab.is-active {
  background: rgba(255, 255, 255, 0.95);
  color: #2563EB;
  font-weight: 600;
}

.approval-tab-count {
  font-size: var(--fs-22);
}

.approval-type-card,
.approval-summary-card,
.approval-list-card,
.approval-note-card {
  padding: var(--sp-24);
}

.approval-type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-24) var(--sp-12);
}

.approval-type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.approval-type-icon {
  width: var(--sp-92);
  height: var(--sp-92);
  border-radius: var(--sp-28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-36);
}

.approval-type-label {
  margin-top: var(--sp-14);
  text-align: center;
  line-height: 1.4;
  font-size: var(--fs-24);
  color: #4B6080;
}

.approval-note-card {
  margin-top: var(--sp-24);
  background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-input) 100%);
}

.approval-note-title {
  font-size: var(--fs-28);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-note-desc {
  margin-top: var(--sp-10);
  font-size: var(--fs-24);
  line-height: 1.7;
  color: var(--text-tertiary);
}

.approval-summary-card {
  margin-top: var(--sp-24);
  background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg-card) 100%);
}

.approval-summary-top {
  font-size: var(--fs-24);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-summary-grid {
  margin-top: var(--sp-20);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.approval-summary-grid.is-three {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-16);
}

.approval-summary-label,
.approval-person-sub,
.approval-detail,
.approval-time,
.approval-filter,
.approval-meta {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-summary-value {
  margin-top: var(--sp-8);
  font-size: var(--fs-38);
  font-weight: 700;
  color: var(--text-primary);
}

.approval-summary-value text {
  font-size: var(--fs-24);
  font-weight: 400;
}

.approval-list-header {
  margin-top: var(--sp-28);
  margin-bottom: var(--sp-16);
}

/* 卡片列表容器间距 */
.approval-list-container {
  display: flex;
  flex-direction: column;
  gap: var(--sp-20);
}

.approval-list-card + .approval-list-card {
  margin-top: var(--sp-20);
}

.approval-list-top,
.approval-person,
.approval-person-row,
.approval-actions,
.approval-modal-head,
.approval-modal-row,
.approval-modal-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.approval-person {
  gap: var(--sp-18);
}

.approval-person-main {
  flex: 1;
}

.approval-person-row {
  justify-content: flex-start;
  gap: var(--sp-10);
}

.approval-person-name,
.approval-type-title,
.approval-modal-title {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-type-title {
  margin-top: var(--sp-22);
}

.approval-detail {
  margin-top: var(--sp-12);
  color: #4B6080;
}

.approval-meta {
  margin-top: var(--sp-8);
}

.approval-time {
  margin-top: var(--sp-10);
}

.approval-urgent {
  padding: var(--sp-6) var(--sp-14);
  border-radius: var(--sp-999);
  background: #FFEBEE;
  color: #F44336;
  font-size: var(--fs-18);
}

.approval-actions,
.approval-modal-actions {
  gap: var(--sp-18);
  margin-top: var(--sp-24);
  padding-top: var(--sp-24);
  border-top: var(--sp-1) solid rgba(37, 99, 235, 0.1);
}

.approval-reject-btn,
.approval-approve-btn {
  flex: 1;
  height: var(--sp-78);
  border-radius: var(--sp-24);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-24);
  font-weight: 600;
  transition: all 0.3s ease;
  position: relative;
}

.approval-reject-btn {
  background: var(--bg-input);
  color: #4B6080;
}

.approval-reject-btn.is-disabled,
.approval-approve-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 加载动画 */
.approval-reject-btn.is-disabled::after,
.approval-approve-btn.is-disabled::after {
  content: '';
  position: absolute;
  right: var(--sp-20);
  width: var(--sp-24);
  height: var(--sp-24);
  border: var(--sp-3) solid currentColor;
  border-top-color: transparent;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  opacity: 0.8;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.approval-empty-icon {
  width: var(--sp-88);
  height: var(--sp-88);
  border-radius: var(--sp-44);
  margin: 0 auto var(--sp-20);
  background: var(--bg-soft);
  color: #2563EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-38);
  font-weight: 700;
}

.approval-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: var(--sp-24);
  box-sizing: border-box;
  z-index: 20;
}

.approval-modal-card {
  width: 100%;
  border-radius: var(--sp-32);
  background: var(--bg-card);
  padding: var(--sp-28);
  box-sizing: border-box;
}

.approval-modal-sub,
.approval-modal-label {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.approval-modal-close {
  width: var(--sp-56);
  height: var(--sp-56);
  border-radius: var(--sp-28);
  background: var(--bg-input);
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-32);
}

.approval-modal-body {
  margin-top: var(--sp-24);
}

.approval-modal-row + .approval-modal-row {
  margin-top: var(--sp-18);
}

.approval-modal-value {
  font-size: var(--fs-24);
  color: var(--text-primary);
  font-weight: 600;
}

.approval-modal-remark {
  margin-top: var(--sp-24);
  padding: var(--sp-20);
  border-radius: var(--sp-24);
  background: var(--bg-input);
  color: var(--text-secondary);
  font-size: var(--fs-24);
  line-height: 1.7;
}

/* 就医申请进度条样式 */
.approval-progress {
  margin-top: var(--sp-16);
  padding: var(--sp-24);
  background: var(--bg-soft-2);
  border-radius: var(--sp-12);
}

/* 详情弹窗中的进度条样式 */
.approval-modal-progress {
  margin-top: var(--sp-24);
  padding: var(--sp-24);
  background: var(--bg-soft-2);
  border-radius: var(--sp-12);
}

.approval-modal-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--sp-16);
}

.approval-modal-progress-info {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  flex: 1;
}

.approval-modal-progress-step {
  font-size: var(--fs-24);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-modal-progress-text {
  font-size: var(--fs-24);
  color: #9CA3AF;
}

.approval-modal-progress-bar {
  width: 100%;
  height: var(--sp-8);
  background: #E5E7EB;
  border-radius: var(--sp-4);
  overflow: hidden;
}

.approval-modal-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563EB 0%, #1D4ED8 100%);
  border-radius: var(--sp-4);
  transition: width 0.3s ease;
}

.approval-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--sp-16);
}

.approval-progress-info {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  flex: 1;
}

.approval-progress-step {
  font-size: var(--fs-24);
  font-weight: 600;
  color: var(--text-primary);
}

.approval-progress-text {
  font-size: var(--fs-24);
  color: #9CA3AF;
}

.approval-progress-bar {
  width: 100%;
  height: var(--sp-8);
  background: #E5E7EB;
  border-radius: var(--sp-4);
  overflow: hidden;
}

.approval-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563EB 0%, #1D4ED8 100%);
  border-radius: var(--sp-4);
  transition: width 0.3s ease;
}

.approval-modal-copy {
  margin-top: var(--sp-24);
  padding: var(--sp-24);
  background: var(--hint-warn-bg);
  border-radius: var(--sp-12);
  border: var(--sp-1) solid var(--hint-warn-border);
}

.approval-modal-copy-text {
  font-size: var(--fs-24);
  color: var(--hint-warn-text);
  margin-bottom: var(--sp-16);
  line-height: 1.6;
}

.approval-copy-btn {
  width: 100%;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  border: none;
  border-radius: var(--sp-16);
  height: var(--sp-88);
  font-size: var(--fs-28);
  font-weight: 600;
  box-sizing: border-box;
}

.approval-copy-btn::after {
  border: none;
}

/* 工作流日志样式 */
.approval-modal-logs {
  margin-top: var(--sp-24);
  padding: var(--sp-24);
  background: var(--bg-input);
  border-radius: var(--sp-12);
}

.approval-modal-logs-title {
  font-size: var(--fs-28);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-16);
}

.approval-modal-logs-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-16);
}

.approval-modal-logs-item {
  padding: var(--sp-16);
  background: var(--bg-card);
  border-radius: var(--sp-8);
  border-left: var(--sp-3) solid #2563EB;
}

.approval-modal-logs-item.is-error {
  border-left-color: #DC2626;
}

.approval-modal-logs-action {
  font-size: var(--fs-26);
  font-weight: 600;
  color: #1F2937;
  margin-bottom: var(--sp-8);
}

.approval-modal-logs-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--sp-8);
}

.approval-modal-logs-operator {
  font-size: var(--fs-24);
  color: #6B7280;
  font-weight: 500;
}

.approval-modal-logs-time {
  font-size: var(--fs-24);
  color: #9CA3AF;
}

.approval-modal-logs-desc {
  font-size: var(--fs-24);
  color: #6B7280;
  line-height: 1.6;
  padding-top: var(--sp-8);
  border-top: var(--sp-1) solid var(--bg-soft-2);
  margin-top: var(--sp-8);
}

/* 空状态提示 */
.approval-modal-logs-empty {
  font-size: var(--fs-24);
  color: #9CA3AF;
  text-align: center;
  padding: var(--sp-32) 0;
  line-height: 1.6;
}

/* 中止申请按钮样式 */
.approval-modal-terminate {
  margin-top: var(--sp-24);
  padding: var(--sp-24);
  background: #FEE2E2;
  border-radius: var(--sp-12);
  border: var(--sp-1) solid #FCA5A5;
}

.approval-modal-terminate-text {
  font-size: var(--fs-24);
  color: #991B1B;
  margin-bottom: var(--sp-16);
  line-height: 1.6;
}

.approval-terminate-btn {
  width: 100%;
  background: #DC2626;
  color: #FFFFFF;
  border: none;
  border-radius: var(--sp-16);
  height: var(--sp-88);
  font-size: var(--fs-28);
  font-weight: 600;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
}

.approval-terminate-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 加载动画 */
.approval-terminate-btn.is-disabled::after {
  content: '';
  position: absolute;
  right: var(--sp-20);
  width: var(--sp-28);
  height: var(--sp-28);
  border: var(--sp-3) solid #FFFFFF;
  border-top-color: transparent;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  opacity: 0.8;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}


