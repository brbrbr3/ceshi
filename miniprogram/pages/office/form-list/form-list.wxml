<view class="office-page form-list-page" style="{{fontStyle}}">
  <!-- <view class="office-gradient-header form-list-header">
    <view class="form-list-header-row">
      <view class="form-list-title">信息发布</view>
    </view>
  </view> -->

  <view class="office-content form-list-content">
    <!-- tag 筛选 -->
    <scroll-view scroll-x class="form-list-tabs-scroll" enhanced show-scrollbar="false">
      <view class="form-list-tabs">
        <view
          wx:for="{{tagTabs}}"
          wx:key="key"
          class="form-list-tab {{activeTag === item.key ? 'is-active' : ''}}"
          bindtap="handleTagChange"
          data-tag="{{item.key}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <!-- 列表 -->
    <view class="form-list-body">
      <view
        wx:for="{{list}}"
        wx:key="_id"
        class="office-card form-list-item"
        hover-class="form-list-item-hover"
        bindtap="handleItemTap"
        data-id="{{item._id}}"
      >
        <view wx:if="{{item.isUnread}}" class="form-list-dot-badge"></view>
        <view class="form-list-item-top">
          <view class="form-list-badge" style="background: {{item.tagBg}}; color: {{item.tagColor}};">{{item.tagIcon}} {{item.tagLabel}}</view>
          <view class="form-list-status {{item.isClosed ? 'is-closed' : ''}}">{{item.statusText}}</view>
        </view>
        <view class="form-list-item-title">{{item.title}}</view>
        <view class="form-list-item-meta">
          <text>{{item.createdByName || '发布者'}}</text>
          <text class="form-list-dot">·</text>
          <text>{{item.timeText}}</text>
          <text wx:if="{{item.hasFormContent}}" class="form-list-dot">·</text>
          <text wx:if="{{item.hasFormContent}}">{{item.submissionCount}} 人已提交</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{!loading && list.length === 0}}" class="form-list-empty">
        <view class="form-list-empty-icon"></view>
        <view class="form-list-empty-text">暂无相关信息</view>
      </view>

      <!-- 加载状态 -->
      <view wx:if="{{loading}}" class="form-list-loading">加载中...</view>
      <view wx:if="{{!hasMore && list.length > 0}}" class="form-list-loading">没有更多了</view>
    </view>
  </view>
  <view wx:if="{{canPublish}}" class="form-list-publish" hover-class="form-list-publish-hover" bindtap="handlePublish">＋</view>
</view>
