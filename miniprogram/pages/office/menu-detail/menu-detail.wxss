.menu-detail-page {
  min-height: 100%;
}

.menu-detail-header {
  padding-top: var(--sp-30);
  text-align: left;
  padding-bottom: var(--sp-90);
}

.menu-detail-title {
  font-size: var(--fs-40);
  font-weight: 600;
  color: #FFFFFF;
}

.menu-detail-meta {
  margin-top: var(--sp-5);
  font-size: var(--fs-28);
  color: rgba(255, 255, 255, 0.9);
}

.menu-detail-content {
  margin-top: calc(var(--sp-60) * -1);
}

.menu-content-card {
  padding: var(--sp-28);
  margin-bottom: var(--sp-28);
}

.menu-content-title {
  font-size: var(--fs-36);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-20);
}

.menu-content-html {
  font-size: var(--fs-32);
  line-height: 1.8;
  color: var(--text-secondary);
}

.menu-detail-actions {
  display: flex;
  gap: var(--sp-16);
  margin-top: var(--sp-28);
}

.menu-action-btn {
  flex: 1;
  font-size: var(--fs-30);
}

.menu-action-btn.is-delete {
  background: #FEE2E2;
  color: #DC2626;
}

.menu-detail-link {
  padding-right: var(--sp-10);
  font-size: var(--fs-28);
}

.menu-comments-card {
  padding: var(--sp-24);
}

.menu-comment-input {
  margin-bottom: var(--sp-32);
}

.menu-comment-input textarea {
  width: 100%;
  max-height: var(--sp-180);
  padding: var(--sp-20);
  border-radius: var(--sp-16);
  background: var(--bg-input);
  border: var(--sp-2) solid transparent;
  font-size: var(--fs-30);
  color: var(--text-secondary);
  box-sizing: border-box;
  margin-bottom: var(--sp-16);
}

.menu-comment-placeholder {
  color: var(--text-muted);
}

.menu-comment-submit {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu-comment-count {
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.menu-comment-btn {
  padding: var(--sp-12) var(--sp-32);
  font-size: var(--fs-28);
}

.menu-comment-list {
  margin-top: var(--sp-24);
}

.menu-comment-item {
  display: flex;
  gap: var(--sp-16);
  padding: var(--sp-20) 0;
  border-bottom: var(--sp-1) solid rgba(37, 99, 235, 0.08);
}

.menu-comment-item:last-child {
  border-bottom: none;
}

.menu-comment-avatar {
  width: var(--sp-64);
  height: var(--sp-64);
  border-radius: var(--sp-32);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: var(--fs-30);
  font-weight: 600;
  flex-shrink: 0;
}

.menu-comment-main {
  flex: 1;
  min-width: 0;
}

.menu-comment-header {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  margin-bottom: var(--sp-8);
}

.menu-comment-author {
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--text-primary);
}

.menu-comment-time {
  font-size: var(--fs-30);
  color: var(--text-muted);
}

.menu-comment-text {
  font-size: var(--fs-30);
  line-height: 1.6;
  color: var(--text-secondary);
  word-break: break-all;
}

.menu-comment-delete {
  flex-shrink: 0;
  margin-left: auto;
  padding: var(--sp-8) var(--sp-16);
  font-size: var(--fs-28);
  color: #DC2626;
}

.empty-state.is-mini {
  padding: var(--sp-40) var(--sp-24);
}

.empty-state.is-mini .empty-text {
  font-size: var(--fs-26);
  text-align: center;
}

/* ==================== 菜品打分模块样式 ==================== */
.menu-ratings-card {
  padding: var(--sp-24);
}

.menu-rating-list {
  margin-bottom: var(--sp-16);
}

.menu-rating-item {
  display: flex;
  align-items: center;
  padding: var(--sp-16) 0;
  border-bottom: var(--sp-1) solid rgba(37, 99, 235, 0.06);
}

.menu-rating-item:last-child {
  border-bottom: none;
}

.rating-dish-name {
  width: var(--sp-240);
  flex-shrink: 0;
  font-size: var(--fs-28);
  font-weight: 500;
  color: var(--text-primary);
}

.rating-score-area {
  flex: 1;
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.rating-stars {
  display: flex;
  gap: var(--sp-2);
}

.rating-star {
  font-size: var(--fs-26);
  color: #E2E8F0;
}

.rating-star.is-filled {
  color: #F59E0B;
}

.rating-average {
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F59E0B;
  margin-left: var(--sp-4);
}

.rating-count {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.rating-tag {
  padding: var(--sp-2) var(--sp-12);
  border-radius: var(--sp-6);
  font-size: var(--fs-22);
  margin-left: var(--sp-8);
}

.rating-tag.is-rated {
  background: var(--bg-soft);
  color: #2563EB;
}

.menu-rating-btn-wrap {
  display: flex;
  justify-content: center;
  padding: var(--sp-20) 0 var(--sp-8);
}

.menu-rating-open-btn {
  display: inline-block;
  padding: var(--sp-16) var(--sp-48);
  font-size: var(--fs-30);
  border-radius: var(--sp-44);
  z-index: 101;
}

.loading-text {
  text-align: center;
  padding: var(--sp-32);
  font-size: var(--fs-24);
  color: var(--text-muted);
}

/* 打分弹窗样式 */
.rating-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease;
}

.rating-popup-mask.is-closing {
  animation: fadeOut 0.25s ease forwards;
}

.rating-popup-mask.is-closing .rating-popup {
  animation: slideDown 0.25s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

.rating-popup {
  width: 100%;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: var(--sp-32) var(--sp-32) 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes slideDown { from { transform: translateY(0); } to { transform: translateY(100%); } }

.rating-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-32) var(--sp-32) var(--sp-20);
  border-bottom: var(--sp-1) solid rgba(0, 0, 0, 0.06);
}

.rating-popup-title {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.rating-popup-close {
  font-size: var(--fs-48);
  color: var(--text-muted);
  line-height: 1;
  padding: 0 var(--sp-12);
}

.rating-popup-body {
  max-height: 60vh;
  padding: var(--sp-16) var(--sp-32);
}

.rating-dish-item {
  display: flex;
  align-items: center;
  padding: var(--sp-20) 0;
  border-bottom: var(--sp-1) solid rgba(0, 0, 0, 0.04);
}

.rating-dish-label {
  width: var(--sp-250);
  flex-shrink: 0;
  font-size: var(--fs-28);
  color: var(--text-secondary);
}

.rating-dish-stars {
  display: flex;
  gap: var(--sp-8);
}

.popup-star {
  font-size: var(--fs-44);
  color: #E2E8F0;
  padding: var(--sp-4);
  transition: transform 0.15s;
}

.popup-star.is-active {
  color: #F59E0B;
}

.rating-dish-score {
  font-size: var(--fs-26);
  color: #F59E0B;
  font-weight: 500;
  min-width: var(--sp-60);
  text-align: center;
  margin-left: var(--sp-12);
}

.rating-already-tag {
  font-size: var(--fs-24);
  color: #2563EB;
  margin-left: var(--sp-12);
}

.rating-popup-footer {
  display: flex;
  gap: var(--sp-24);
  padding: var(--sp-24) var(--sp-32);
  padding-bottom: calc(var(--sp-24) + env(safe-area-inset-bottom));
  border-top: var(--sp-1) solid rgba(0, 0, 0, 0.06);
}
.rating-popup-btn {
  transition: all 0.3s ease;
}

.rating-popup-btn:active {
  transform: scale(0.95);
  opacity: 0.75;
}

.rating-popup-cancel,
.rating-popup-submit {
  flex: 1;
  height: var(--sp-88);
  line-height: var(--sp-88);
  text-align: center;
  border-radius: var(--sp-44);
  font-size: var(--fs-30);
  font-weight: 500;
}

/* 评论区可见范围提示 */
.menu-comment-scope {
  text-align: center;
  font-size: var(--fs-28);
  color: var(--text-muted);
  padding: var(--sp-12) 0 var(--sp-4);
}

.rating-popup-cancel {
  background: var(--bg-soft-2);
  color: #64748B;
}

.rating-popup-submit {
  background: linear-gradient(135deg, #2563EB, #3B82F6);
  color: #FFFFFF;
}

.rating-popup-submit.is-disabled {
  opacity: 0.5;
}
