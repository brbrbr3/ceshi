<page-meta page-style="{{pageStyle}}" />
<view wx:if="{{guardReady}}" class="office-page menus-page {{themeClass}}" style="{{fontStyle}}">
  <view class="office-gradient-header menus-header">
    <view class="office-header-top">
      <view>
        <view class="office-subpage-title">每周菜单</view>
      </view>
      <view class="menus-header-actions">
        <!-- 导出模式：显示取消导出 + 导出评分按钮；非导出模式：显示新增 + 导出评分按钮 -->
        <view wx:if="{{exportMode}}" class="menus-add-btn" bindtap="handleCancelExport">
          <text>✕ 取消导出</text>
        </view>
        <view wx:else="{{!exportMode && showAddButton}}" class="menus-add-btn" bindtap="goAddMenu">
          <text>＋ 新增</text>
        </view>
        <view wx:if="{{canExportRatings}}" class="menus-export-btn {{(exportMode && selectedMenuIds.length === 0) || exporting ? 'is-disabled' : ''}}" bindtap="{{exportMode ? 'handleExportRatings' : 'handleStartExport'}}">
          <text>{{exporting ? '生成中...' : '导出评分'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="office-content menus-content">
    <!-- 列表内容 -->
    <view class="menus-list" wx:if="{{list.length > 0}}">
      <view class="menu-item {{exportMode && item.checked ? 'is-selected' : ''}}" wx:for="{{list}}" wx:key="_id" bindtap="{{exportMode ? 'toggleMenuSelect' : 'goMenuDetail'}}" data-id="{{item._id}}">
        <view class="menu-item-left">
          <view wx:if="{{exportMode}}" class="menu-checkbox {{item.checked ? 'is-checked' : ''}}">
            <text wx:if="{{item.checked}}" class="menu-checkbox-tick">✓</text>
          </view>
          <view class="menu-item-main">
            <view class="menu-item-title">{{item.title}}</view>
            <view class="menu-item-meta">
              <text class="menu-item-time">{{item.authorName}}</text>
              <text class="menu-item-author">· 发布于 {{item.timeText}}</text>
            </view>
          </view>
        </view>
        <view class="menu-item-right">
          <view class="menu-item-arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 分页加载状态 -->
    <view class="pagination-loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 没有更多数据提示 -->
    <view class="pagination-no-more" wx:elif="{{!hasMore && list.length > 0}}">
      <text class="no-more-text">没有更多数据了</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{list.length === 0 && !loading}}">
      <view class="empty-icon">🍽️</view>
      <view class="empty-text">暂无菜单</view>
    </view>
  </view>

  <!-- 自定义 Toast（毛玻璃风格） -->
  <view class="custom-toast {{_customToast.visible ? 'is-visible' : ''}}" style="transition-duration: {{_customToast.fadeOutMs}}ms;">
    <view class="custom-toast-text">{{_customToast.text}}</view>
  </view>
</view>

