.menus-page {
  min-height: 100%;
}

/* 分页加载样式 */
.pagination-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e0e0e0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: var(--fs-28);
  color: #999;
}

.pagination-no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: var(--fs-24);
  color: #ccc;
}

.menus-header {
  padding: 20rpx 40rpx 40rpx;
}

.menus-title {
  font-size: var(--fs-48);
  font-weight: 600;
  color: #FFFFFF;
}

.menus-subtitle {
  font-size: var(--fs-26);
  color: rgba(255, 255, 255);
}

.menus-add-btn {
  align-self: flex-end;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 500;
  transition: all 0.2s ease;
}

.menus-add-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

/* 头部按钮区 */
.menus-header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 导出评分按钮 */
.menus-export-btn {
  align-self: flex-end;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 500;
  transition: all 0.2s ease;
}

.menus-export-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.menus-export-btn.is-disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 导出模式：选中态 */
.menu-item.is-selected {
  border-left-color: #16A34A;
  background: #F0FDF4;
}

/* 方形复选框 */
.menu-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 3rpx solid #CBD5E1;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.menu-checkbox.is-checked {
  border-color: #16A34A;
  background: #16A34A;
}

.menu-checkbox-tick {
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 700;
}

/* 自定义 Toast（毛玻璃风格） */
.custom-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  background: rgba(30, 41, 59, 0.8);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 20rpx;
  padding: 24rpx 40rpx;
  max-width: 600rpx;
  opacity: 0;
  pointer-events: none;
  z-index: 9999;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.2);
}

.custom-toast.is-visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  transition: opacity 0.18s ease, transform 0.22s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.custom-toast-text {
  color: #fff;
  font-size: var(--fs-28);
  line-height: 1.7;
  text-align: center;
  word-break: break-all;
}

.menus-content {
  margin-top: -30rpx;
}

.menus-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  padding: 24rpx 10rpx 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;  
  box-shadow: 3rpx 2rpx 8rpx rgba(47, 43, 43, 0.42);
  transition: all 0.2s ease;
  border-left: 6rpx solid #3B82F6;
}

.menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
  border-left: 2rpx solid #3B82F6;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.menu-item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #DCFCE7;
  color: #16A34A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-32);
}

.menu-item-main {
  flex: 1;
  min-width: 0;
}

.menu-item-title {
  font-size: var(--fs-30);
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-wrap: break-word;
  word-break: break-all;
}

.menu-item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--fs-26);
  color: #94A3B8;
}

.menu-item-right {
  display: flex;
  align-items: center;
}

.menu-item-arrow {
  font-size: var(--fs-40);
  color: #94A3B8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: var(--fs-80);
}

.empty-text {
  font-size: var(--fs-28);
  color: #999;
}