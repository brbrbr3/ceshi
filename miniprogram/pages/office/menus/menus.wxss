.menus-page {
  min-height: 100%;
}

/* 分页加载样式 */
.pagination-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.loading-spinner {
  width: var(--sp-32);
  height: var(--sp-32);
  border: var(--sp-3) solid #e0e0e0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: var(--sp-16);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: var(--fs-28);
  color: #999;
}

.pagination-no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-32) 0;
}

.no-more-text {
  font-size: var(--fs-24);
  color: #ccc;
}

.menus-header {
  padding: var(--sp-20) var(--sp-40) var(--sp-40);
}



.menus-add-btn {
  align-self: flex-end;
  padding: var(--sp-12) var(--sp-24);
  border-radius: var(--sp-40);
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 500;
  transition: all 0.2s ease;
}

.menus-add-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

/* 头部按钮区 */
.menus-header-actions {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
}

/* 导出评分按钮 */
.menus-export-btn {
  align-self: flex-end;
  padding: var(--sp-12) var(--sp-24);
  border-radius: var(--sp-40);
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 500;
  transition: all 0.2s ease;
}

.menus-export-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.menus-export-btn.is-disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 导出模式：选中态（深色模式用深绿底，避免浅色晃眼） */
.menu-item.is-selected {
  border-left-color: #16A34A;
  background: var(--selected-bg);
}

/* 方形复选框 */
.menu-checkbox {
  width: var(--sp-40);
  height: var(--sp-40);
  border-radius: var(--sp-8);
  border: var(--sp-3) solid #CBD5E1;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.menu-checkbox.is-checked {
  border-color: #16A34A;
  background: #16A34A;
}

.menu-checkbox-tick {
  color: #FFFFFF;
  font-size: var(--fs-26);
  font-weight: 700;
}

/* 自定义 Toast（毛玻璃风格） */
.custom-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  background: var(--toast-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: var(--sp-20);
  padding: var(--sp-24) var(--sp-40);
  max-width: var(--sp-600);
  opacity: 0;
  pointer-events: none;
  z-index: 9999;
  box-shadow: 0 var(--sp-8) var(--sp-40) rgba(0, 0, 0, 0.2);
}

.custom-toast.is-visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  transition: opacity 0.18s ease, transform 0.22s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.custom-toast-text {
  color: var(--toast-text);
  font-size: var(--fs-28);
  line-height: 1.7;
  text-align: center;
  word-break: break-all;
}

.menus-content {
  margin-top: calc(var(--sp-30) * -1);
}

.menus-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-26);
  padding: var(--sp-24) var(--sp-10) var(--sp-24);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-24);
  background: var(--bg-card);
  border-radius: var(--sp-20);  
  box-shadow: var(--sp-3) var(--sp-2) var(--sp-8) rgba(47, 43, 43, 0.42);
  transition: all 0.2s ease;
  border-left: var(--sp-6) solid #3B82F6;
}

.menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 var(--sp-1) var(--sp-6) rgba(0, 0, 0, 0.06);
  border-left: var(--sp-2) solid #3B82F6;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: var(--sp-20);
  flex: 1;
}


.menu-item-main {
  flex: 1;
  min-width: 0;
}

.menu-item-title {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-8);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-wrap: break-word;
  word-break: break-all;
}

.menu-item-meta {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  font-size: var(--fs-26);
  color: var(--text-muted);
}

.menu-item-right {
  display: flex;
  align-items: center;
}

.menu-item-arrow {
  font-size: var(--fs-40);
  color: var(--text-muted);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-100) 0;
  gap: var(--sp-16);
}

.empty-icon {
  font-size: var(--fs-80);
}

.empty-text {
  font-size: var(--fs-28);
  color: #999;
}