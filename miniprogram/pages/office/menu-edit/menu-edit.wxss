.menu-edit-page {
  min-height: 100%;
}

.menu-edit-page .auth-field-label {
  font-size: var(--fs-34);
  font-weight: 600;
  color: #1E293B;
}

.menu-edit-header {
  padding: 30rpx 40rpx 80rpx;
}

.menu-edit-title {
  font-size: var(--fs-48);
  font-weight: 700;
  color: #FFFFFF;
  text-align: left;
}

.menu-edit-content {
  margin-top: -60rpx;
}

.menu-edit-form {
  padding: 28rpx;
}

.menu-edit-input-shell input {
  font-size: var(--fs-32);
}

.menu-editor-wrapper {
  border-radius: 24rpx;
  overflow: hidden;
  background: #F8FAFC;
  border: 2rpx solid transparent;
}

.menu-editor-wrapper editor {
  min-height: 760rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: var(--fs-32);
}

.menu-edit-submit {
  margin-top: 32rpx;
}

