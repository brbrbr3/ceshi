.menu-edit-page {
  min-height: 100%;
}

.menu-edit-page .auth-field-label {
  font-size: var(--fs-34);
  font-weight: 600;
  color: var(--text-primary);
}

.menu-edit-header {
  padding: var(--sp-30) var(--sp-40) var(--sp-80);
}

.menu-edit-title {
  font-size: var(--fs-48);
  font-weight: 700;
  color: #FFFFFF;
  text-align: left;
}

.menu-edit-content {
  margin-top: calc(var(--sp-60) * -1);
}

.menu-edit-form {
  padding: var(--sp-28);
}

.menu-edit-input-shell input {
  font-size: var(--fs-32);
}

.menu-editor-wrapper {
  border-radius: var(--sp-24);
  overflow: hidden;
  background: var(--bg-input);
  border: var(--sp-2) solid transparent;
}

.menu-editor-wrapper editor {
  min-height: var(--sp-760);
  padding: var(--sp-20);
  box-sizing: border-box;
  font-size: var(--fs-32);
}

.menu-editor-wrapper .ql-editor.ql-blank::before {
  color: var(--text-muted);
}

.menu-edit-submit {
  margin-top: var(--sp-32);
}

