<view class="auth-page login-page" style="{{fontStyle}}">

  <!-- 背景装饰图片 -->
  <view class="login-bg-image-wrapper">
    <image class="login-bg-image" src="/image/congresso.jpg" mode="widthFix" />
  </view>

  <view class="auth-hero login-hero">
    <view wx:if="{{isDevEnv}}" class="auth-brand">DevEnv</view>
    <view class="auth-title">报备助手</view>
    <view class="auth-subtitle">欢迎使用巴西利亚报备助手！</view>
    <!-- <view class="auth-tip-row">
      <view wx:if="{{isDevEnv}}" class="auth-tip-pill">微信身份校验</view>
      <view wx:if="{{isDevEnv}}" class="auth-tip-pill">管理员审批</view>
      <view wx:if="{{isDevEnv}}" class="auth-tip-pill">人脸/指纹登录</view>
    </view> -->
  </view>

  <view class="auth-card">
    <view class="login-wechat-title">{{isRegistered ? '您已注册，点击下方按钮登录：' : '您尚未注册，点击下方按钮注册：'}}</view>
    <button class="auth-submit-btn login-submit-btn {{isPendingApproval ? 'is-pending' : ''}}" loading="{{loading}}" bindtap="handleWxLogin">{{isPendingApproval ? '审核中' : (isRegistered ? '人脸/指纹登录' : '注册')}}</button>
    <view class="login-wechat-panel">
      <!-- <view wx:if="{{isDevEnv}}" class="login-wechat-icon">生物特征</view> -->
      <view>
        <!-- <view wx:if="{{isDevEnv}}" class="login-wechat-title">使用微信身份识别当前用户</view> -->
        <view wx:if="{{isRegistered}}" class="login-wechat-desc">您的生物特征仅用于登录验证，小程序不会保存</view>
        <view class="login-wechat-desc">注意事项：</view>
        <view class="login-wechat-desc">1.小程序将采集您的部分个人信息（微信头像、微信昵称），请在相关征求获取个人信息的弹窗中点击<text style="font-weight: 700; color: crimson;">同意</text>，否则后续将无法正常使用小程序</view>
        <view class="login-wechat-desc">2.为正常使用小程序的微信消息推送功能，请在相关征求向您推送消息的弹窗中<text style="font-weight: 700; color: crimson;">打开相关推送并确认</text>，否则后续将无法正常使用小程序</view>
      </view>
    </view>
    <view class="auth-card-title"></view>
    <!-- <text wx:if="{{isDevEnv}}" class="auth-card-desc">已注册用户：点击下方按钮，验证人脸/指纹后登录
      未注册用户：将跳转到注册页面填写基础资料</text> -->
  </view>

  <view wx:if="{{statusCard && !isRegistered}}" class="auth-card login-status-card {{statusCard.className}}">
    <view class="login-status-head">
      <view class="login-status-title">{{statusCard.title}}</view>
      <view class="login-status-tag">{{statusCard.tag}}</view>
    </view>
    <view class="login-status-desc">{{statusCard.desc}}</view>
    <view wx:if="{{statusCard.extra}}" class="login-status-extra">{{statusCard.extra}}</view>
    <view wx:if="{{statusCard.time}}" class="login-status-time">{{statusCard.time}}</view>
  </view>

  <!-- <view wx:if="{{showRegisterLink}}" class="login-bottom-link" bindtap="goRegister">尚未注册？去填写注册申请</view> -->

  <view wx:if="{{bootstrapStatus.canBootstrap && !isAdmin}}" class="auth-bootstrap-card">
    <view class="auth-bootstrap-title">首个管理员初始化</view>
    <view class="auth-bootstrap-desc">系统中还没有已审批管理员。请先提交注册申请，再使用初始化密钥完成首个管理员引导。</view>
    <view class="auth-bootstrap-btn" bindtap="showBootstrapModal">开始初始化</view>
  </view>

  <!-- 调试模式入口（仅管理员且为开发环境时可见） -->
  <view wx:if="{{isAdmin && isDevEnv}}" class="auth-debug-entry" bindtap="toggleDebugPanel">{{showDebugPanel ? '收起调试面板' : '打开调试面板'}}</view>

  <!-- 调试面板 -->
  <view wx:if="{{showDebugPanel}}" class="auth-debug-panel">
    <view class="auth-debug-panel-title">调试面板</view>
    <view class="auth-debug-panel-desc">点击执行对应的初始化函数</view>
    <view class="auth-debug-buttons">
      <view class="auth-debug-btn" bindtap="callInitSystemConfig">初始化系统配置</view>
      <view class="auth-debug-btn" bindtap="callInitWorkflowDB">初始化工作流</view>
      <view class="auth-debug-btn auth-debug-btn-danger" bindtap="showClearDbPanel">清除数据库数据</view>
    </view>
    <view class="auth-debug-close" bindtap="hideDebugPanel">关闭调试面板</view>
    <!-- 清除数据库面板 -->
    <view wx:if="{{showClearDbPanel}}" class="auth-clear-db-panel">
      <view class="auth-clear-db-header">
        <view class="auth-clear-db-title">选择要清理的集合</view>
        <view class="auth-clear-db-select-all" bindtap="toggleSelectAll">
          {{selectedCollections.length === dbCollections.length ? '取消全选' : '全选'}}
        </view>
      </view>

      <checkbox-group class="auth-clear-db-list" bindchange="onCollectionChange">
        <label class="auth-clear-db-item" wx:for="{{dbCollections}}" wx:key="name">
          <checkbox value="{{item.name}}" checked="{{item.checked}}" color="#1890ff" />
          <text class="auth-clear-db-item-name">{{item.name}}</text>
        </label>
      </checkbox-group>

      <view class="auth-clear-db-actions">
        <view class="auth-clear-db-btn auth-clear-db-btn-cancel" bindtap="hideClearDbPanel">取消</view>
        <view class="auth-clear-db-btn auth-clear-db-btn-confirm {{selectedCollections.length === 0 ? 'is-disabled' : ''}}" bindtap="doClearDb">
          清理{{selectedCollections.length > 0 ? ' (' + selectedCollections.length + ')' : ''}}
        </view>
      </view>
    </view>
    <!-- 调试结果输出区域 -->
    <view wx:if="{{debugResults.length > 0}}" class="auth-debug-results">
      <view class="auth-debug-results-title">执行结果</view>
      <view wx:for="{{debugResults}}" wx:key="id" class="auth-debug-result-item">
        <view class="auth-debug-result-header">
          <text class="auth-debug-result-name">{{item.name}}</text>
          <text class="auth-debug-result-status {{item.success ? 'is-success' : 'is-fail'}}">{{item.success ? '成功' : '失败'}}</text>
        </view>
        <view wx:if="{{item.message}}" class="auth-debug-result-message">{{item.message}}</view>
        <view wx:if="{{item.data}}" class="auth-debug-result-data">
          <text user-select="true" user-select="true">{{item.data}}</text>
        </view>
      </view>
    </view>


  </view>

  <!-- 清库密钥弹窗 -->
  <view wx:if="{{showClearDbKeyModal}}" class="auth-modal-overlay {{modalAnimating ? 'is-closing' : ''}}" bindtap="hideClearDbKeyModal">
    <view class="auth-modal" catchtap="stopPropagation">
      <view class="auth-modal-title">输入清库密钥</view>
      <view class="auth-modal-desc">清空数据库前需要再次输入后端配置的 DB_CLEAR_KEY。</view>
      <input class="auth-modal-input" type="password" password="{{true}}" placeholder="请输入清库密钥" value="{{clearDbKey}}" bindinput="onClearDbKeyInput" />
      <view class="auth-modal-actions">
        <view class="auth-modal-btn auth-modal-btn-cancel" bindtap="hideClearDbKeyModal">取消</view>
        <view class="auth-modal-btn auth-modal-btn-confirm" bindtap="confirmClearDb">确认清库</view>
      </view>
    </view>
  </view>

  <!-- 首个管理员初始化弹窗 -->
  <view wx:if="{{showBootstrapModal}}" class="auth-modal-overlay {{modalAnimating ? 'is-closing' : ''}}" bindtap="hideBootstrapModal">
    <view class="auth-modal" catchtap="stopPropagation">
      <view class="auth-modal-title">首个管理员初始化</view>
      <view class="auth-modal-desc">请输入后端配置的初始化密钥。此入口只会在系统尚无已审批管理员时开放。</view>
      <input class="auth-modal-input" type="password" password="{{true}}" placeholder="请输入初始化密钥" value="{{bootstrapInviteCode}}" bindinput="onBootstrapInviteCodeInput" />
      <view class="auth-modal-actions">
        <view class="auth-modal-btn auth-modal-btn-cancel" bindtap="hideBootstrapModal">取消</view>
        <view class="auth-modal-btn auth-modal-btn-confirm" bindtap="confirmBootstrapAdmin">确认</view>
      </view>
    </view>
  </view>
</view>