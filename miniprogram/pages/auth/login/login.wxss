page {
  background-color: #F8FAFC;
}

.login-page {
}

.login-hero {
  margin-top: 230rpx;
}

/* 内容元素设 position: relative，使其在 z-index:0 的背景图之上 */
.login-page .auth-hero,
.login-page .auth-card,
.login-page .login-status-card,
.login-page .auth-bootstrap-card,
.login-page .auth-debug-entry,
.login-page .auth-debug-panel {
  position: relative;
  z-index: 1;
}

.login-submit-btn {
}

.login-wechat-panel {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 5rpx 0 32rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ECFDF5 0%, #F0FDF4 100%);
}

.login-wechat-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-32);
  font-weight: 700;
  padding: 20rpx;
  margin: 10rpx;
  text-align: center;
}

.login-wechat-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #166534;
}

.login-wechat-title.is-rejected {
  color: #B91C1C;
}

.login-wechat-title-desc {
  font-size: var(--fs-25);
  font-weight: 500;
  color: #166534;
  margin: 30rpx 0;
}

.login-wechat-desc {
  margin-top: 8rpx;
  font-size: var(--fs-30);
  color: #15803D;
}

/* 首个管理员初始化 */
.auth-bootstrap-card {
  margin-top: 30rpx;
  padding: 30rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 24rpx;
}

.auth-bootstrap-title {
  font-size: var(--fs-30);
  font-weight: 600;
  color: #9a3412;
}

.auth-bootstrap-desc {
  margin-top: 12rpx;
  font-size: var(--fs-24);
  line-height: 1.7;
  color: #9a3412;
}

.auth-bootstrap-btn {
  margin-top: 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ea580c;
  color: #fff;
  font-size: var(--fs-28);
  font-weight: 500;
}

/* 调试模式入口 */
.auth-debug-entry {
  margin: 40rpx auto;
  padding: 20rpx 40rpx 180rpx;
  font-size: var(--fs-24);
  color: #999;
  text-align: center;
  text-decoration: underline;
}

/* 背景装饰图片 */
.login-bg-image-wrapper {
  position: absolute;
  top: -100rpx;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

.login-bg-image {
  width: 100%;
  display: block;
  border-radius: 0;
  -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.8) 60%, rgba(0,0,0,0) 90%);
  transition: opacity 0.8s ease;
}

/* 前景图（未注册 congresso.jpg）：处于文档流，撑起容器高度 */
.login-bg-image-front {
  position: relative;
}

/* 覆盖图（已注册 emb.jpg）：绝对定位叠加在前景图上，初始透明 */
.login-bg-image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.login-bg-image-front.is-hidden {
  opacity: 0;
}

.login-bg-image-overlay.is-active {
  opacity: 1;
}

/* 调试密码弹窗 */
.auth-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.auth-modal-overlay.is-closing {
  animation: fadeOut 0.25s ease forwards;
}

.auth-modal-overlay.is-closing .auth-modal {
  animation: scaleOut 0.25s ease forwards;
}

.auth-modal {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  animation: scaleIn 0.2s ease;
}

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
@keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
@keyframes scaleOut { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(0.9); } }

.auth-modal-title {
  font-size: var(--fs-32);
  font-weight: 600;
  text-align: center;
  margin-bottom: 10rpx;
  color: #333;
}

.auth-modal-desc {
  font-size: var(--fs-24);
  text-align: center;
  color: #ff4d4f;
  margin-bottom: 20rpx;
}

.auth-modal-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  margin-top: 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: var(--fs-28);
  box-sizing: border-box;
}

.auth-modal-actions {
  display: flex;
  margin-top: 30rpx;
  gap: 20rpx;
}

.auth-modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: var(--fs-28);
}

.auth-modal-btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.auth-modal-btn-confirm {
  background: #1890ff;
  color: #fff;
}

/* 调试面板 */
.auth-debug-panel {
  padding: 30rpx;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.auth-debug-panel-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.auth-debug-panel-desc {
  font-size: var(--fs-24);
  color: #999;
  margin-bottom: 30rpx;
}

.auth-debug-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.auth-debug-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f0f5ff;
  color: #1890ff;
  border-radius: 8rpx;
  font-size: var(--fs-28);
}

.auth-debug-btn:active {
  background: #d6e4ff;
}

.auth-debug-close {
  margin-top: 30rpx;
  margin-bottom: 70rpx;
  text-align: center;
  font-size: var(--fs-26);
  color: #999;
  text-decoration: underline;
}

/* 调试结果 */
.auth-debug-results {
  margin-top: 30rpx;
  margin-bottom: 100rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #eee;
}

.auth-debug-results-title {
  font-size: var(--fs-28);
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.auth-debug-result-item {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.auth-debug-result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.auth-debug-result-name {
  font-size: var(--fs-28);
  font-weight: 500;
  color: #333;
}

.auth-debug-result-status {
  font-size: var(--fs-24);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.auth-debug-result-status.is-success {
  background: #e6fffb;
  color: #52c41a;
}

.auth-debug-result-status.is-fail {
  background: #fff1f0;
  color: #ff4d4f;
}

.auth-debug-result-message {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  color: #666;
}

.auth-debug-result-data {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  color: #999;
  word-break: break-all;
  white-space: pre-wrap;
  max-height: 300rpx;
  overflow-y: auto;
}

/* 危险操作按钮 */
.auth-debug-btn-danger {
  background: #fff1f0;
  color: #ff4d4f;
}

.auth-debug-btn-danger:active {
  background: #ffccc7;
}

/* 清除数据库面板 */
.auth-clear-db-panel {
  margin-top: 30rpx;
  padding: 30rpx;
  background: #fafafa;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
}

.auth-clear-db-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.auth-clear-db-title {
  font-size: var(--fs-28);
  font-weight: 600;
  color: #333;
}

.auth-clear-db-select-all {
  font-size: var(--fs-24);
  color: #1890ff;
  text-decoration: underline;
}

.auth-clear-db-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.auth-clear-db-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 8rpx;
  border: 1rpx solid #e8e8e8;
}

.auth-clear-db-item-name {
  margin-left: 16rpx;
  font-size: var(--fs-26);
  color: #333;
}

.auth-clear-db-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.auth-clear-db-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: var(--fs-28);
}

.auth-clear-db-btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.auth-clear-db-btn-confirm {
  background: #ff4d4f;
  color: #fff;
}

.auth-clear-db-btn-confirm.is-disabled {
  background: #ccc;
  color: #fff;
}

/* 审核状态卡片 */
.login-status-card {
  overflow: hidden;
}

.login-status-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.login-status-title {
  font-size: var(--fs-30);
  font-weight: 700;
  color: #0F172A;
}

.login-status-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: var(--fs-22);
  font-weight: 600;
}

.login-status-card.is-pending {
  border: 1rpx solid rgba(245, 158, 11, 0.22);
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFBEB 100%);
}

.login-status-card.is-pending .login-status-tag {
  background: #FEF3C7;
  color: #B45309;
}

.login-status-card.is-rejected {
  border: 1rpx solid rgba(239, 68, 68, 0.2);
  background: linear-gradient(180deg, #FFFFFF 0%, #FEF2F2 100%);
}

.login-status-card.is-rejected .login-status-tag {
  background: #FEE2E2;
  color: #B91C1C;
}

.login-status-card.is-approved {
  border: 1rpx solid rgba(34, 197, 94, 0.2);
  background: linear-gradient(180deg, #FFFFFF 0%, #F0FDF4 100%);
}

.login-status-card.is-approved .login-status-tag {
  background: #DCFCE7;
  color: #15803D;
}

.login-status-card.is-error {
  border: 1rpx solid rgba(148, 163, 184, 0.2);
}

.login-status-card.is-error .login-status-tag {
  background: #E2E8F0;
  color: #475569;
}

.login-status-desc,
.login-status-extra,
.login-status-time {
  margin-top: 14rpx;
  font-size: var(--fs-24);
  line-height: 1.7;
  color: #64748B;
}

.login-status-extra {
  color: #1E293B;
}

.login-bottom-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--fs-24);
  font-weight: 600;
  color: #2563EB;
}

/* 审核员登录链接 */
.login-reviewer-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--fs-24);
  color: #94a3b8;
  text-decoration: underline;
}
