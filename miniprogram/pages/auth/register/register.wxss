}

/* 微信昵称输入提示 */
.auth-nickname-tip {
  margin-top: 12rpx;
  font-size: var(--fs-24);
  color: #94A3B8;
}

/* 退回说明 */
.register-review-banner {
  margin-top: 20rpx;
