page {
  background: var(--bg-page);
}

/* 微信昵称输入提示 */
.auth-nickname-tip {
  margin-top: 12rpx;
  font-size: var(--fs-24);
  color: var(--text-muted);
}

/* 退回说明 */
.register-review-banner {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--danger-soft-bg);
  color: var(--danger-text);
}

.register-review-title {
  font-size: var(--fs-24);
  font-weight: 600;
}

.register-review-text {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.7;
}
