<view class="auth-page register-page" style="{{fontStyle}}">
  <view class="auth-hero">
    <!-- <view wx:if="{{isDevEnv}}" class="auth-brand">注册</view> -->
    <view class="auth-title">填写注册申请</view>
    <view class="auth-subtitle">请按要求填写个人资料。提交后，管理员将收到一条新的注册申请并进行审核。</view>
    <view class="auth-tip-row">
      <!-- <view wx:if="{{isDevEnv}}" class="auth-tip-pill">姓名</view> -->
      <!-- <view wx:if="{{isDevEnv}}" class="auth-tip-pill">角色信息</view> -->
      <!-- <view class="auth-tip-pill">管理员标记</view> -->
    </view>
  </view>

  <view class="auth-card">
    <view class="auth-card-title">填写个人资料</view>
    <view class="auth-card-desc">审批通过后将自动成为本小程序正式用户。</view>

    <view wx:if="{{reviewRemark}}" class="register-review-banner">
      <view class="register-review-title">退回说明</view>
      <view class="register-review-text">{{reviewRemark}}</view>
    </view>

    <view class="auth-form">
      <!-- 微信头像 -->
      <view class="auth-field">
        <view class="auth-field-label">微信头像 <text style="color: #e74c3c;">*</text></view>
        <view wx:if="{{!form.avatarUrl}}" class="auth-card-desc">请点击下方按钮，选择"用微信头像"，不要选择"从相册选择"或"拍照"</view>
        <button class="auth-avatar-btn" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar">
          <image wx:if="{{form.avatarUrl}}" class="auth-avatar-preview" src="{{form.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="auth-avatar-placeholder">
            <text class="auth-avatar-icon">📷</text>
            <text>点击获取微信头像</text>
          </view>
        </button>
        <view wx:if="{{form.avatarUrl}}" class="auth-avatar-hint">已选择微信头像✅</view>
      </view>

      <!-- 微信昵称 -->
      <view class="auth-field">
        <view class="auth-field-label">微信昵称 <text style="color: #e74c3c;">*</text></view>
        <view wx:if="{{!form.nickName}}" class="auth-card-desc">请点击下方输入框，在键盘上方选择"使用微信昵称"，不要自行输入</view>
        <view class="auth-input-shell">
          <input type="nickname" value="{{form.nickName}}" placeholder="点击使用微信昵称" placeholder-class="auth-input-placeholder" bindinput="handleNickNameInput" bindblur="handleNickNameBlur" bindnicknamereview="handleNickNameReview" />
        </view>
        <view wx:if="{{form.nickName}}" class="auth-avatar-hint">已选择微信昵称✅</view>
      </view>

      <view class="auth-field">
        <view class="auth-field-label">姓名</view>
        <view class="auth-input-shell">
          <input value="{{form.name}}" placeholder="请输入真实姓名" placeholder-class="auth-input-placeholder" bindinput="handleNameInput" />
        </view>
      </view>

      <view class="auth-field">
        <view class="auth-field-label">性别</view>
        <view class="auth-segment">
          <view class="auth-segment-item {{form.gender === '男' ? 'is-active' : ''}}" data-value="男" bindtap="selectGender">男</view>
          <view class="auth-segment-item {{form.gender === '女' ? 'is-active' : ''}}" data-value="女" bindtap="selectGender">女</view>
        </view>
      </view>

      <view class="auth-field">
        <view class="auth-field-label">出生日期</view>
        <picker wx:if="{{today}}" mode="date" value="{{form.birthday}}" start="1900-01-01" end="{{today}}" bindchange="handleBirthdayChange" bindcolumnchange="handleBirthdayColumnChange">
          <view class="auth-picker-shell {{form.birthday ? '' : 'is-placeholder'}}">
            <view class="auth-picker-value">{{form.birthday || '请选择出生日期'}}</view>
            <view class="auth-picker-arrow">›</view>
          </view>
        </picker>
        <view wx:else class="auth-picker-shell is-placeholder">
          <view class="auth-picker-value">加载中...</view>
        </view>
      </view>

      <view class="auth-field">
        <view class="auth-field-label">手机 <text class="auth-field-optional">（选填）</text></view>
        <view class="auth-input-shell">
          <input value="{{form.mobile}}" placeholder="+55 61 " placeholder-class="auth-input-placeholder" bindinput="handleMobileInput" type="text" />
        </view>
      </view>

      <view class="auth-field">
        <view class="auth-field-label">座机 <text class="auth-field-optional">（选填）</text></view>
        <view class="auth-input-shell">
          <input value="{{form.landline}}" placeholder="+55 61 " placeholder-class="auth-input-placeholder" bindinput="handleLandlineInput" type="text" />
        </view>
      </view>

      <view class="auth-field">
        <view class="auth-field-label">是否为本系统管理员</view>
        <view class="auth-card-desc">请选择“否”，除非您已获得授权成为本系统管理员。</view>
        <view class="auth-segment">
          <view class="auth-segment-item {{form.isAdmin ? 'is-active' : ''}}" data-value="true" bindtap="selectAdmin">是</view>
          <view class="auth-segment-item {{!form.isAdmin ? 'is-active' : ''}}" data-value="false" bindtap="selectAdmin">否</view>
        </view>
      </view>
    </view>

    <button class="auth-submit-btn" loading="{{loading}}" bindtap="submitRegistration">提交注册申请</button>
    <view class="auth-note">提交后请等待管理员处理；若未通过，可进入本页修改并重新提交。</view>
    <view class="auth-note">请<text style="font-weight: 700; color: crimson;">在申请向您发送消息的弹窗中打开相关通知推送，并点击“允许”</text>。</view>
  </view>
</view>
