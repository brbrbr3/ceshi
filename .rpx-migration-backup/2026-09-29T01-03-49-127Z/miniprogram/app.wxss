/* reset */
page {
  /* 主题颜色变量（浅色默认值） */
  --bg-page: #EEF2FF;
  --bg-card: #FFFFFF;
  --bg-input: #F8FAFC;
  --bg-soft: #EFF6FF;
  --bg-soft-2: #F1F5F9;
  --text-strong: #0F172A;
  --text-primary: #1E293B;
  --text-secondary: #475569;
  --text-tertiary: #64748B;
  --text-muted: #94A3B8;
  --border-soft: #CBD5E1;
  --shadow-card: rgba(37, 99, 235, 0.08);
  --header-grad-start: #1D4ED8;
  --header-grad-end: #3B82F6;
  --toast-bg: rgba(30, 41, 59, 0.82);
  --toast-text: #FFFFFF;
  --selected-bg: #F0FDF4;
  --checklist-on-bg: #EFF6FF;
  --checklist-on-border: #93c5fd;
  --checklist-on-box: #2563eb;
  --checklist-on-text: #1d4ed8;
  --hint-warn-bg: #FEF3C7;
  --hint-warn-text: #92400E;
  --hint-warn-border: #92400E;
  --auth-grad-1: #DBEAFE;
  --auth-grad-2: #EEF2FF;
  --auth-grad-3: #F8FAFC;
  --primary-text: #2563EB;
  --primary-border: #93C5FD;
  --success-soft-bg: #ECFDF5;
  --success-text: #166534;
  --danger-soft-bg: #FEF2F2;
  --danger-text: #B91C1C;
  background-color: #EEF2FF;
  height: 100%;
  font-size: 16px;
  line-height: 1.6;
  color: var(--text-primary);
  display: flex;
  justify-content: center;
}

/* 系统深色模式：跟随系统主题（@media 不受 darkmode 开关影响，仍生效） */
@media (prefers-color-scheme: dark) {
  page {
    --bg-page: #0B1220;
    --bg-card: #1E293B;
    --bg-input: #111827;
    --bg-soft: #1E3A5F;
    --bg-soft-2: #0F172A;
    --text-strong: #F8FAFC;
    --text-primary: #E2E8F0;
    --text-secondary: #CBD5E1;
    --text-tertiary: #94A3B8;
    --text-muted: #64748B;
    --border-soft: #334155;
    --shadow-card: rgba(0, 0, 0, 0.4);
    --header-grad-start: #1E3A8A;
    --header-grad-end: #1D4ED8;
    --toast-bg: rgba(255, 255, 255, 0.94);
    --toast-text: #0F172A;
    --selected-bg: #334155;
    --checklist-on-bg: #78350F;
    --checklist-on-border: #D97706;
    --checklist-on-box: #D97706;
    --checklist-on-text: #FCD34D;
    --hint-warn-bg: #3F2D08;
    --hint-warn-text: #FCD34D;
    --hint-warn-border: #B45309;
    --auth-grad-1: #1E293B;
    --auth-grad-2: #0F172A;
    --auth-grad-3: #0B1220;
    --primary-text: #60A5FA;
    --primary-border: #3B82F6;
    --success-soft-bg: #12321F;
    --success-text: #86EFAC;
    --danger-soft-bg: #3B1518;
    --danger-text: #FCA5A5;
    background-color: #0B1220;
  }
}

/* 手动深色（附加在 office 页面根 view 上，覆盖系统主题） */
.theme-dark {
  --bg-page: #0B1220;
  --bg-card: #1E293B;
  --bg-input: #111827;
  --bg-soft: #1E3A5F;
  --bg-soft-2: #0F172A;
  --text-strong: #F8FAFC;
  --text-primary: #E2E8F0;
  --text-secondary: #CBD5E1;
  --text-tertiary: #94A3B8;
  --text-muted: #64748B;
  --border-soft: #334155;
  --shadow-card: rgba(0, 0, 0, 0.4);
  --header-grad-start: #1E3A8A;
  --header-grad-end: #1D4ED8;
  --toast-bg: rgba(255, 255, 255, 0.94);
  --toast-text: #0F172A;
  --selected-bg: #334155;
  --checklist-on-bg: #78350F;
  --checklist-on-border: #D97706;
  --checklist-on-box: #D97706;
  --checklist-on-text: #FCD34D;
  --hint-warn-bg: #3F2D08;
  --hint-warn-text: #FCD34D;
  --hint-warn-border: #B45309;
  --auth-grad-1: #1E293B;
  --auth-grad-2: #0F172A;
  --auth-grad-3: #0B1220;
  --primary-text: #60A5FA;
  --primary-border: #3B82F6;
  --success-soft-bg: #12321F;
  --success-text: #86EFAC;
  --danger-soft-bg: #3B1518;
  --danger-text: #FCA5A5;
}

/* 手动浅色（附加在 office 页面根 view 上，覆盖系统深色） */
.theme-light {
  --bg-page: #EEF2FF;
  --bg-card: #FFFFFF;
  --bg-input: #F8FAFC;
  --bg-soft: #EFF6FF;
  --bg-soft-2: #F1F5F9;
  --text-strong: #0F172A;
  --text-primary: #1E293B;
  --text-secondary: #475569;
  --text-tertiary: #64748B;
  --text-muted: #94A3B8;
  --border-soft: #CBD5E1;
  --shadow-card: rgba(37, 99, 235, 0.08);
  --header-grad-start: #1D4ED8;
  --header-grad-end: #3B82F6;
  --toast-bg: rgba(30, 41, 59, 0.82);
  --toast-text: #FFFFFF;
  --selected-bg: #F0FDF4;
  --checklist-on-bg: #EFF6FF;
  --checklist-on-border: #93c5fd;
  --checklist-on-box: #2563eb;
  --checklist-on-text: #1d4ed8;
  --hint-warn-bg: #FEF3C7;
  --hint-warn-text: #92400E;
  --hint-warn-border: #92400E;
  --auth-grad-1: #DBEAFE;
  --auth-grad-2: #EEF2FF;
  --auth-grad-3: #F8FAFC;
  --primary-text: #2563EB;
  --primary-border: #93C5FD;
  --success-soft-bg: #ECFDF5;
  --success-text: #166534;
