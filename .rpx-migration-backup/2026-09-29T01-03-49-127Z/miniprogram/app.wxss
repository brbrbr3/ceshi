page>view {
  width: 100vw;
  max-width: 600px;
}

checkbox,
radio {
  margin-right: 5px;
}

button {
  margin-top: 10px;
  margin-bottom: 10px;
}

form {
  width: 100%;
}

input {
  width: 100%;
}



/* 业务样式 */
.office-page {
  min-height: 100%;
  background: var(--bg-page);
  color: var(--text-primary);
}

.office-gradient-header {
  padding: calc(var(--sp-100) + env(safe-area-inset-top)) var(--sp-32) 0;
  background: linear-gradient(135deg, var(--header-grad-start) 0%, var(--header-grad-end) 100%);
  color: #FFFFFF;
  border-bottom-left-radius: var(--sp-60);
  border-bottom-right-radius: var(--sp-60);
  box-sizing: border-box;
}

/* 头部 - 使用圆角渐变 */
.office-subpage-header {
  padding: var(--sp-40) var(--sp-32) var(--sp-30);
}

.office-subpage-header-content {
  color: #FFFFFF;
}

.office-subpage-title {
  font-size: var(--fs-44);
  font-weight: 600;
}

.office-subpage-subtitle {
  font-size: var(--fs-26);
  opacity: 0.9;
}

.office-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.office-content {
  position: relative;
  z-index: 2;
  padding: 0 var(--sp-24) var(--sp-40);
  box-sizing: border-box;
}

.office-card {
  background: var(--bg-card);
  border-radius: var(--sp-32);
  box-shadow: 0 var(--sp-16) var(--sp-42) var(--shadow-card);
}

.office-section {
  margin-top: var(--sp-28);
}

.office-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-20);
}

.office-section-title {
  font-size: var(--fs-36);
  font-weight: 600;
  color: var(--text-primary);
}

.office-link {
  font-size: var(--fs-26);
  color: #2563EB;
}

.office-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-8) var(--sp-16);
  border-radius: var(--sp-999);
  font-size: var(--fs-22);
  line-height: 1;
}

.office-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-18) var(--sp-32);
  border-radius: var(--sp-999);
  background: #2563EB;
  color: #FFFFFF;
  font-size: var(--fs-24);
  font-weight: 600;
  box-shadow: 0 var(--sp-14) var(--sp-28) rgba(37, 99, 235, 0.16);
  transition: all 0.3s ease;
}

.office-btn-primary:active {
  transform: scale(0.95);
  opacity: 0.75;
}

.office-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-18) var(--sp-32);
  border-radius: var(--sp-999);
  background: var(--bg-soft);
  color: #2563EB;
  font-size: var(--fs-24);
  font-weight: 600;
  transition: all 0.3s ease;
}

.office-btn-secondary:active {
  transform: scale(0.95);
  opacity: 0.75;
}

.office-empty {
  padding: var(--sp-80) var(--sp-24);
  text-align: center;
  color: var(--text-muted);
}

.auth-page {
  /* align-self: flex-start 避免被 page 的 flex 布局拉伸锁死高度，
     否则内容超高时背景只覆盖一屏，滚动会露底 */
  align-self: flex-start;
  width: 100%;
  min-height: 100vh;
  padding: calc(var(--sp-56) + env(safe-area-inset-top)) var(--sp-28) var(--sp-40);
  box-sizing: border-box;
  background: linear-gradient(180deg, var(--auth-grad-1) 0%, var(--auth-grad-2) 34%, var(--auth-grad-3) 100%);
}

.auth-hero {
  padding: var(--sp-28) var(--sp-12) var(--sp-24);
  z-index: 10;
}

.auth-brand {
  width: var(--sp-188);
  height: var(--sp-88);
  border-radius: var(--sp-28);
  background: linear-gradient(135deg, var(--header-grad-start) 0%, var(--header-grad-end) 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-36);
  font-weight: 700;
  box-shadow: 0 var(--sp-16) var(--sp-34) rgba(37, 99, 235, 0.2);
  z-index: 1;
}

.auth-title {
  margin-top: var(--sp-28);
  font-size: var(--fs-48);
  line-height: 1.25;
  font-weight: 700;
  z-index: 1;
  color: var(--text-strong);
}

.auth-subtitle {
  margin-top: var(--sp-14);
  font-size: var(--fs-32);
  font-weight: 500;
  line-height: 1.6;
  z-index: 1;
  color: var(--text-secondary);
}

.auth-tip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-14);
  margin-top: var(--sp-28);
}

.auth-tip-pill {
  padding: var(--sp-10) var(--sp-18);
  border-radius: var(--sp-999);
  background: var(--bg-soft);
  color: var(--primary-text);
  font-size: var(--fs-24);
  font-weight: 600;
}

.auth-card {
  margin-top: var(--sp-20);
  padding: var(--sp-32) var(--sp-28);
  border-radius: var(--sp-32);
  background: var(--bg-card);
  box-shadow: 0 var(--sp-16) var(--sp-40) var(--shadow-card);
}

.auth-card-title {
  font-size: var(--fs-36);
  font-weight: 700;
  color: var(--text-strong);
}

.auth-card-desc {
  margin-top: var(--sp-12);
  font-size: var(--fs-28);
  line-height: 1.7;
  color: var(--text-tertiary);
}



.auth-submit-btn {
  width: 100%;
  border-radius: var(--sp-24);
  background: linear-gradient(135deg, var(--header-grad-start) 0%, var(--header-grad-end) 100%);
  color: #FFFFFF;
  font-size: var(--fs-32);
  font-weight: 600;
  box-shadow: 0 var(--sp-16) var(--sp-30) rgba(37, 99, 235, 0.18);
  height: 100%;
  margin: var(--sp-28);
  justify-content: center;
  padding: var(--sp-24) var(--sp-12);
  transition: all 0.3s ease;
}

.auth-submit-btn:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.auth-submit-btn::after {
  border: none;
}

.auth-submit-btn.is-pending {
  background: linear-gradient(135deg, #9CA3AF 0%, #B0B7C3 100%);
  box-shadow: none;
  color: #E5E7EB;
  pointer-events: none;
}

.auth-submit-btn.is-disabled {
  background: linear-gradient(135deg, #9CA3AF 0%, #B0B7C3 100%);
  box-shadow: none;
  color: #E5E7EB;
  pointer-events: none;
}

.auth-note {
  margin-top: var(--sp-18);
  font-size: var(--fs-24);
  line-height: 1.7;
  color: #64748B;
  margin-bottom: var(--sp-60);
}



.auth-form {
  margin-top: var(--sp-28);
}

.auth-field+.auth-field {
  margin-top: var(--sp-24);
}

.auth-field-label {
  margin-bottom: var(--sp-14);
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}

.auth-checkbox-label {
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.auth-field-optional {
  font-weight: 400;
  font-size: var(--fs-24);
  color: #94A3B8;
}

.auth-input-shell,
.auth-picker-shell {
  display: flex;
  align-items: center;
  min-height: var(--sp-92);
  padding: 0 var(--sp-24);
  border-radius: var(--sp-24);
  background: var(--bg-input);
  border: var(--sp-2) solid transparent;
  box-sizing: border-box;
  border: var(--sp-1) solid var(--border-soft);
}

.auth-picker-shell.is-placeholder,
.auth-input-placeholder {
  color: var(--text-muted);
}

.auth-input-shell.is-focused {
  border-color: var(--primary-border);
  background: var(--bg-card);
}

.auth-input-shell input {
  width: 100%;
  font-size: var(--fs-28);
  color: var(--text-strong);
}

.auth-picker-value {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--text-strong);
}

.auth-picker-arrow {
  margin-left: var(--sp-16);
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.auth-segment {
  display: flex;
  gap: var(--sp-16);
}

.auth-segment-item {
  flex: 1;
  height: var(--sp-88);
  border-radius: var(--sp-24);
  background: var(--bg-input);
  color: var(--text-secondary);
  font-size: var(--fs-26);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: var(--sp-2) solid transparent;
}

.auth-segment-item.is-active {
  background: var(--bg-soft);
  border-color: var(--primary-border);
  color: var(--primary-text);
  font-weight: 600;
}



/* 微信头像选择 */
.auth-avatar-btn {
  width: var(--sp-160);
  height: var(--sp-160);
  padding: 0;
  margin: 0;
  border-radius: var(--sp-24);
  background: var(--bg-soft-2);
  border: var(--sp-2) dashed var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: 1.5;
}

.auth-avatar-btn::after {
  border: none;
}

.auth-avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: var(--sp-24);
}

.auth-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
  color: var(--text-muted);
}

.auth-avatar-icon {
  font-size: var(--fs-36);
  margin-bottom: var(--sp-6);
}

.auth-avatar-hint {
  margin-top: var(--sp-10);
  font-size: var(--fs-26);
  color: var(--primary-text);
}


